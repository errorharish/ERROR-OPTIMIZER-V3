<UserControl x:Class="BiosOptimizer.GUI.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Network Boost" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Optimize TCP/IP stack and DNS settings for lower latency and better stability." 
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="↻ Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>

            <!-- Main Layout -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Optimizations -->
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="24">
                    <StackPanel>
                        <!-- Status row -->
                        <Grid Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource StatusGreenBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Ready to Boost" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource StatusGreenBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" ItemWidth="280">
                            <!-- TCP Auto-Tuning Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,16,16" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="TCP Auto-Tuning" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="1" Text="Optimizes network buffer sizes for faster throughput." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="11"/>
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Content="Optimize" Command="{Binding TcpAutoTuningCommand}" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            
                            <!-- DNS Resolver Flush Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,16,16" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="DNS Resolver Flush" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="1" Text="Clears outdated DNS cache entries to fix routing delays." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="11"/>
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Content="Flush" Command="{Binding DnsFlushCommand}" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>

                            <!-- Congestion Control Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,16,16" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Congestion Control" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="1" Text="Changes TCP provider to CTCP for reliable packet delivery." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="11"/>
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Content="Apply" Command="{Binding CongestionControlCommand}" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>

                            <!-- Network Throttling Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,16,16" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Network Throttling" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="1" Text="Disables Windows multimedia network bandwidth limits." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="11"/>
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Content="Disable" Command="{Binding NetworkThrottlingCommand}" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                        </WrapPanel>

                        <!-- Centered Main Action -->
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="OPTIMIZE ALL" Command="{Binding OptimizeAllCommand}" 
                                Width="200" Height="48" FontSize="14" FontWeight="Bold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right Column: Stats -->
                <StackPanel Grid.Column="2">
                    <!-- Connection Box -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Connection" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding AdapterName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ConnectionType}" FontSize="12" Foreground="{StaticResource CyanAccentBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Latency Box -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Latency" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Latency}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Traffic Box -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Live Traffic" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="↓ " Foreground="{StaticResource StatusGreenBrush}" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding DownloadSpeed}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="↑ " Foreground="{StaticResource CyanAccentBrush}" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding UploadSpeed}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

