<UserControl x:Class="BiosOptimizer.GUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource SlimScrollViewer}">
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*" MinHeight="280"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ ROW 0: Header ══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Dashboard"/>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="{Binding SystemSummary}"/>
                </StackPanel>
                <!-- Refresh + last scan -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastRefresh}" FontSize="9"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Height="32"
                            MinWidth="80" FontSize="10" Content="↻  Refresh"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ══ ROW 2: Score + Monitor panels ══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Score Card -->
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}"
                        Padding="20,20" MaxHeight="340">
                    <!-- Service offline overlay -->
                    <Grid>
                        <!-- Score content (visible when online) -->
                        <StackPanel Visibility="{Binding IsOnlineVisibility}">
                            <TextBlock Text="OPTIMIZATION SCORE" FontSize="8"
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                            <controls:CircularScore
                                HorizontalAlignment="Center"
                                Score="{Binding Score}"
                                MaxScore="100"
                                ScoreLabel="{Binding ScoreLabel}"
                                IsLoading="{Binding IsLoading}"
                                Width="180" Height="180"/>

                            <!-- Score sub-metrics (Health metrics) -->
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding HealthScore}" FontSize="16"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource StatusGreenBrush}"/>
                                    <TextBlock Text="Health" FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PerformanceScore}" FontSize="16"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Perf" FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SecurityScore}" FontSize="16"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource StatusGreenBrush}"/>
                                    <TextBlock Text="Sec" FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StabilityScore}" FontSize="16"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource StatusGreenBrush}"/>
                                    <TextBlock Text="Stab" FontSize="8"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Service offline state -->
                        <StackPanel Visibility="{Binding IsOfflineVisibility}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Offline icon -->
                            <Border Width="52" Height="52" CornerRadius="26"
                                    Background="#1A0808" HorizontalAlignment="Center"
                                    Margin="0,0,0,14">
                                <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#7B1316"/>
                            </Border>
                            <TextBlock Text="Service Offline" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="The optimizer service is not running."
                                       FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,6,0,18" MaxWidth="200"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="↻  Retry Connection"
                                    Command="{Binding RetryCommand}"
                                    HorizontalAlignment="Center" Height="36"/>
                            <TextBlock Text="{Binding RetryStatus}"
                                       FontSize="9" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Summary + Quick Optimize (center) -->
                <StackPanel Grid.Column="2">

                    <!-- Summary metrics row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="Total Actions" Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}"
                                Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding AppliedCount}" Style="{StaticResource MetricValueStyle}"
                                           Foreground="{StaticResource StatusGreenBrush}"/>
                                <TextBlock Text="Applied" Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}"
                                Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding RemainingCount}" Style="{StaticResource MetricValueStyle}"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Available" Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}"
                                Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricValueStyle}"
                                           Foreground="{StaticResource StatusAmberBrush}"/>
                                <TextBlock Text="Skipped" Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Quick Action Cards -->
                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="Quick Actions" Style="{StaticResource CardTitleStyle}"/>
                                <Border Background="#1A1D26" CornerRadius="10" Padding="8,2"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="LIVE" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{StaticResource StatusGreenBrush}"
                                               />
                                </Border>
                            </StackPanel>

                            <UniformGrid Columns="4" Rows="2">
                                <!-- Card 1: Run Optimization -->
                                <Button Style="{StaticResource QuickActionCardStyle}"
                                        Margin="0,0,6,8" Height="90"
                                        Command="{Binding QuickOptimizeCommand}">
                                    <StackPanel Margin="14,12" HorizontalAlignment="Left">
                                        <TextBlock Text="⚡" FontSize="18" Margin="0,0,0,6"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="Optimize" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Normal tier" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Card 2: RAM Cleanup -->
                                <Button Style="{StaticResource QuickActionCardStyle}"
                                        Margin="3,0,3,8" Height="90"
                                        Command="{Binding RamCleanupCommand}">
                                    <StackPanel Margin="14,12" HorizontalAlignment="Left">
                                        <TextBlock Text="🧹" FontSize="18" Margin="0,0,0,6"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="RAM Clean" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Free memory" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Card 3: Temp Cleaner -->
                                <Button Style="{StaticResource QuickActionCardStyle}"
                                        Margin="3,0,3,8" Height="90"
                                        Command="{Binding TempCleanCommand}">
                                    <StackPanel Margin="14,12" HorizontalAlignment="Left">
                                        <TextBlock Text="🗑" FontSize="18" Margin="0,0,0,6"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="Junk Files" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Temp cleanup" FontSize="9"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Card 4: Network Boost -->
                                <Button Style="{StaticResource QuickActionCardStyle}"
                                        Margin="6,0,0,8" Height="90"
                                        Command="{Binding NetworkCommand}">
                                    <StackPanel Margin="14,12" HorizontalAlignment="Left">
                                        <TextBlock Text="🌐" FontSize="18" Margin="0,0,0,6"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="Network" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Reduce latency" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Card 5: Scan -->
                                <Button Style="{StaticResource QuickActionCardStyle}"
                                        Margin="0,0,6,0" Height="90"
                                        Command="{Binding ScanCommand}">
                                    <StackPanel Margin="14,12" HorizontalAlignment="Left">
                                        <TextBlock Text="🔍" FontSize="18" Margin="0,0,0,6"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Deep Scan" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Full analysis" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Card 6: Startup -->
                                <Button Style="{StaticResource QuickActionCardStyle}"
                                        Margin="3,0,3,0" Height="90"
                                        Command="{Binding StartupCommand}">
                                    <StackPanel Margin="14,12" HorizontalAlignment="Left">
                                        <TextBlock Text="🚀" FontSize="18" Margin="0,0,0,6"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Startup" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Manage startup" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Card 7: BIOS -->
                                <Button Style="{StaticResource QuickActionCardStyle}"
                                        Margin="3,0,3,0" Height="90"
                                        Command="{Binding BiosCommand}">
                                    <StackPanel Margin="14,12" HorizontalAlignment="Left">
                                        <TextBlock Text="🔧" FontSize="18" Margin="0,0,0,6"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="BIOS Safe" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Firmware tune" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Empty slot for grid alignment -->
                                <Border Margin="6,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- System Monitor panel (right) -->
                <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}" Padding="16,18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Live Monitor" Style="{StaticResource CardTitleStyle}"
                                   Margin="0,0,0,16"/>

                        <!-- CPU -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CpuPercent, StringFormat={}{0}%}"
                                           HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100"
                                         Style="{StaticResource RedProgressBarThickStyle}"/>
                            <TextBlock Text="{Binding CpuName}" FontSize="8"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- GPU List -->
                        <ItemsControl ItemsSource="{Binding Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="GPU" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0}%}"
                                                       HorizontalAlignment="Right" FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                                                     Style="{StaticResource RedProgressBarThickStyle}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="8"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- RAM -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="RAM" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding RamPercent, StringFormat={}{0}%}"
                                           HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Maximum="100"
                                         Style="{StaticResource RedProgressBarThickStyle}"/>
                            <TextBlock Text="{Binding RamInfo}" FontSize="8"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Storage -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="STORAGE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding StoragePercent, StringFormat={}{0}%}"
                                           HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Value="{Binding StoragePercent, Mode=OneWay}" Maximum="100"
                                         Style="{StaticResource RedProgressBarThickStyle}"/>
                            <TextBlock Text="{Binding StorageInfo}" FontSize="8"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Power -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="POWER PLAN" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding PowerPlan}"
                                           HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>

                        <!-- System / Windows -->
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="SYSTEM" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SystemSummary}" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ ROW 4: Status message ══ -->
            <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{Binding StatusColor}"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding StatusColor.Color, FallbackValue=#4CAF50}" BlurRadius="6" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding QuickOptimizeCommand}"
                            MinHeight="36" Padding="20,0">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                  Fill="White" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                            <TextBlock Grid.Column="1" Text="Run Optimization" FontSize="11"
                                       FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ ROW 6: Status output ══ -->
            <Border Grid.Row="6" Style="{StaticResource GlassCardStyle}" Padding="16,14"
                    Visibility="{Binding HasOutput}">
                <StackPanel>
                    <TextBlock Text="Last Output" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                                Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding LastOutput}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
                               MaxHeight="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
