<UserControl x:Class="BiosOptimizer.GUI.Views.BiosSafeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BIOS Safe" Style="{StaticResource PageTitleStyle}"/>
                        <Border Background="#1A0A0A" CornerRadius="6" Padding="10,3"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MODERATE RISK" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusAmberBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Hardware-level firmware tuning via WMI. BitLocker suspension may be required." 
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" Margin="0,0,8,0" Padding="16,10">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                  Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                            <TextBlock Grid.Column="1" Text="Refresh" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ApplyCommand}" Margin="0,0,8,0" Padding="16,10">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="White"
                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                            <TextBlock Grid.Column="1" Text="Apply" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource StatusAmberBrush}"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Capabilities Panel -->
            <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Detected Hardware Provider" Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource SlimScrollViewer}">
                        <TextBlock Text="{Binding Capabilities}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Result output -->
            <Border Grid.Row="6" Style="{StaticResource GlassCardStyle}"
                    Visibility="{Binding HasResult}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Operation Result" Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource SlimScrollViewer}">
                        <TextBlock Text="{Binding Result}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontFamily="Cascadia Mono, Consolas"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

