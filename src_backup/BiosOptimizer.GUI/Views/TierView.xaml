<UserControl x:Class="BiosOptimizer.GUI.Views.TierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0: Header -->
                <RowDefinition Height="24"/>     <!-- 1: Spacer -->
                <RowDefinition Height="*"/>      <!-- 2: Category list -->
                <RowDefinition Height="12"/>     <!-- 3: Spacer -->
                <!-- 4: Global progress bar — visible ONLY while running -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>      <!-- 5: Spacer -->
                <RowDefinition Height="Auto"/>   <!-- 6: Action buttons -->
            </Grid.RowDefinitions>

            <!-- ═══ ROW 0: Header ═══ -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TierName}" Style="{StaticResource PageTitleStyle}"/>
                        <Border Background="#1A0A0A" CornerRadius="6" Padding="10,3"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RiskLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource PageSubtitleStyle}"
                               TextWrapping="Wrap" MaxWidth="800" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ═══ ROW 2: Category cards ═══ -->
            <Grid Grid.Row="2">

                <!-- Empty State & Optimization Tip -->
                <StackPanel Visibility="{Binding EmptyStateVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource GlassCardStyle}" Padding="40" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    
                    <Border Style="{StaticResource GlassCardStyle}" Padding="24" Background="#111217" BorderThickness="1" BorderBrush="#1A1C23" MaxWidth="600">
                        <StackPanel>
                            <TextBlock Text="💡 OPTIMIZATION TIP" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding OptimizationTip}" Foreground="#999999" FontSize="13" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Categories List -->
                <!-- Categories List / Live Log Console -->
                <Border Grid.Row="2" CornerRadius="12" Background="#0A0B0E" BorderThickness="1" BorderBrush="#1A1C23" Padding="12" Margin="0,0,0,24">
                    <ListBox ItemsSource="{Binding LiveLogs}" 
                             Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#666666" FontFamily="Consolas, Courier New, monospace" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Color}" FontFamily="Consolas, Courier New, monospace" FontSize="13" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ═══ ROW 4: ONE GLOBAL PROGRESS BAR — above RUN OPTIMIZATION ═══
                 Visible ONLY while IsExecuting = true.
                 Hidden completely when idle or finished.
            -->
            <Grid Grid.Row="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="#0C0D11" CornerRadius="8" Height="48"
                        BorderThickness="1" BorderBrush="#1A1C23" ClipToBounds="True">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding OptimizationProgress}"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="Transparent" BorderThickness="0"
                                 IsHitTestVisible="False"/>
                </Border>
                <!-- Status text overlay -->
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- ═══ ROW 6: Action buttons ═══ -->
            <Grid Grid.Row="6">
                <!-- RUN OPTIMIZATION button -->
                <Button Command="{Binding ApplyCommand}"
                        Padding="0,18" HorizontalAlignment="Stretch"
                        Cursor="Hand" BorderThickness="0"
                        IsEnabled="{Binding IsNotExecuting}">
                    <Button.Background>
                        <SolidColorBrush Color="#E53935"/>
                    </Button.Background>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background" Value="#E53935"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EF5350"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#C62828"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Fill="White"
                              Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                            <Setter Property="Data" Value="M12,4V1L8,5l4,4V6c3.31,0 6,2.69 6,6c0,1.01 -0.25,1.97 -0.7,2.8l1.46,1.46C19.54,15.03 20,13.57 20,12C20,7.58 16.42,4 12,4M12,18c-3.31,0 -6,-2.69 -6,-6c0,-1.01 0.25,-1.97 0.7,-2.8L5.24,7.74C4.46,8.97 4,10.43 4,12c0,4.42 3.58,8 8,8v3l4,-4l-4,-4v3z"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Grid.Column="1" Text="{Binding RunButtonText}"
                                   FontSize="16" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>

        </Grid>


    </Grid>
</UserControl>
