<UserControl x:Class="BiosOptimizer.GUI.Views.ServiceManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Service Manager" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Analyze and control background Windows services." 
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Content="↻ Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{Binding StatusColor}"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- List Panel -->
            <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="System Services" Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding ServicesList}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ServiceName}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                            <TextBlock Text="STARTUP" Foreground="{StaticResource TextMutedBrush}" FontSize="9" />
                                            <Button Style="{StaticResource TextButtonStyle}" 
                                                    Content="{Binding StartupType}" 
                                                    Command="{Binding ToggleStartupTypeCommand}" 
                                                    Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" 
                                                    Padding="0" BorderThickness="0" Background="Transparent"
                                                    Cursor="Hand" ToolTip="Click to change startup type" />
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="80">
                                            <TextBlock Text="RISK" Foreground="{StaticResource TextMutedBrush}" FontSize="9" />
                                            <TextBlock Text="{Binding Risk}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Risk}" Value="High">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusRedBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusAmberBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Risk}" Value="Low">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusGreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="4" 
                                                Content="{Binding StatusText}" 
                                                Command="{Binding ToggleCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,4" Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                Width="60" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

