<UserControl x:Class="BiosOptimizer.GUI.Views.InputOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BiosOptimizer.GUI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="800"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="INPUT OPTIMIZER" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Optimize mouse &amp; keyboard response and verify the result with real input measurements." Style="{StaticResource PageSubtitleStyle}"/>
            
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="INPUT OPTIMIZER STATUS" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PageStatus}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding PageStatusColor}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding PageStatusDesc}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SystemProfile}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">
                
                <!-- Status Cards -->
                <TextBlock Text="CURRENT INPUT STATUS" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="MOUSE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding MouseStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="KEYBOARD" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding KeyboardStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="TIMER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding TimerStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="INPUT STABILITY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding StabilityStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Actions -->
                <TextBlock Text="MAIN ACTIONS" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Command="{Binding NormalOptimizeCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="64" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel>
                            <TextBlock Text="NORMAL INPUT OPTIMIZE" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="Safe core input optimization" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding AdvancedOptimizeCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="64" Margin="8,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel>
                            <TextBlock Text="ADVANCED INPUT OPTIMIZE" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="Core + advanced latency optimization" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Result Popup -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="24" Margin="0,0,0,24" Visibility="{Binding ShowResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultVerdict}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="WHAT HAPPENED?" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ResultExplanation}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ResultSettings}" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="20"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResultMeasurement}" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="20"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Measure Input -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="REAL INPUT MEASUREMENT" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="Observed Raw Input packet rate measured by Error Optimizer. This does not directly prove the mouse manufacturer's configured USB polling setting." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="5 SEC" Command="{Binding MeasureCommand}" CommandParameter="5" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="16,0" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Grid.Column="1" Content="10 SEC" Command="{Binding MeasureCommand}" CommandParameter="10" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="16,0" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Grid.Column="2" Content="30 SEC" Command="{Binding MeasureCommand}" CommandParameter="30" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="16,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding MeasurementStatusText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding MeasurementReason}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MEASURED INPUT RATE" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding MeasuredPolling}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="JITTER" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding MeasuredJitter}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ACTUAL TIMER" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding MeasuredTimer}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding RequestedTimer}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="VALID SAMPLES" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ValidSamples}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AVG / MIN / MAX" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding IntervalStats}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding StabilityDesc}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Border BorderBrush="#33FFFFFF" BorderThickness="1" Height="100">
                            <Polyline Points="{Binding GraphPoints}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Detailed Settings Expanders -->
                <Expander Header="MOUSE RESPONSE" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding MouseDetails}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1AFFFFFF" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" ToolTip="{Binding Description}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayCurrent}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayResult}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Header="KEYBOARD RESPONSE" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding KeyboardDetails}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1AFFFFFF" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" ToolTip="{Binding Description}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayCurrent}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayResult}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Header="USB INPUT DEVICES" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding UsbDevices}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1AFFFFFF" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Device}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding PowerState}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OptimizationStatus}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Header="ADVANCED SYSTEM SETTINGS" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding AdvancedDetails}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1AFFFFFF" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" ToolTip="{Binding Description}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayCurrent}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayResult}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Header="VIEW DETAILED REGISTRY SETTINGS" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Technical implementation details for debugging only." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding MouseDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A000000" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Verification}" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding KeyboardDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A000000" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Verification}" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <Expander Header="VIEW LIVE LOG" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24">
                    <Border Background="#1A000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="200" Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LiveLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
                
                <Button Content="RESTORE INPUT SETTINGS" Command="{Binding RestoreCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,24" Visibility="{Binding IsRestoreAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


