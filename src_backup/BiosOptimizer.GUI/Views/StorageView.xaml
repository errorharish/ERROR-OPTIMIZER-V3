<UserControl x:Class="BiosOptimizer.GUI.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Storage Optimizer" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Analyze drive health, free up space, and remove unnecessary files." 
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="↻ Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>

            <!-- Main Layout -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Drive List and Main Cleaning -->
                <StackPanel Grid.Column="0">
                    <!-- Status row -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding StatusColor}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Physical Drives" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                    
                    <!-- Drives List -->
                    <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Drive header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="🖴" FontSize="24" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Format}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CapacityText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- Progress Bar -->
                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <ProgressBar Grid.Row="0" Style="{StaticResource RedProgressBarThickStyle}" Value="{Binding UsagePercentage}" Maximum="100"/>
                                            <Grid Grid.Row="2">
                                                <TextBlock Text="{Binding UsedText, StringFormat='{}Used: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding FreeText, StringFormat='{}Free: {0}'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Cleaning Modules" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                    
                    <WrapPanel Orientation="Horizontal" ItemWidth="280">
                        <!-- Temporary File Scan -->
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,16,16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Temporary Files" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Row="1" Text="Scan and remove system caches, logs, and temp directories." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="11"/>
                                <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Content="Scan" Command="{Binding ScanTempCommand}" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <!-- Large File Analysis -->
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,16,16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Large Files" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Row="1" Text="Find files over 500MB consuming excessive storage space." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="11"/>
                                <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Content="Analyze" Command="{Binding ScanLargeFilesCommand}" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <!-- Duplicate File Analysis -->
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,16,16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Duplicate Files" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Row="1" Text="Identify identical files across directories to free up space." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" FontSize="11"/>
                                <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Content="Scan" Command="{Binding ScanDuplicatesCommand}" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Right Column: Results & Main Actions -->
                <StackPanel Grid.Column="2">
                    <!-- Deep Cleanup Action -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,16" Background="#1A0D0D">
                        <StackPanel>
                            <TextBlock Text="Deep Cleanup" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Aggressively cleans Windows delivery optimization, obsolete updates, and system temp." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="RUN DEEP CLEAN" Command="{Binding DeepCleanupCommand}" Height="40" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Recycle Bin Action -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Recycle Bin" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Empty Bin" Command="{Binding CleanRecycleBinCommand}" Height="36"/>
                        </StackPanel>
                    </Border>

                    <!-- Scan Results Panel -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Visibility="{Binding HasCleanResult}">
                        <StackPanel>
                            <TextBlock Text="Operation Results" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                                <TextBlock Text="{Binding CleanResult}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" FontFamily="Cascadia Mono, Consolas"
                                           TextWrapping="Wrap" LineHeight="18"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

