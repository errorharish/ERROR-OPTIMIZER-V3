    {
      "id": "debloat.feature.onedrive.startup",
      "displayName": "Disable OneDrive Automatic Startup",
      "category": "Windows Features",
      "action": "SetRegistryValue",
      "target": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive\\DisableFileSyncNGSC",
      "value": 1,
      "os": [
        "win10",
        "win11"
      ],
      "risk": "Low",
      "requiresConfirmation": false,
      "warning": "Prevents OneDrive from syncing in the background. Existing local files are preserved.",
      "conditions": [],
      "verification": "ReadBack",
      "rollback": "Snapshot",
      "description": "Disables background OneDrive synchronization process without touching local user documents."
    },
