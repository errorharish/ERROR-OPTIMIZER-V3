{
  "id": "MaximumPerformance",
  "displayName": "Max Performance",
  "description": "Complete machine-specific performance optimization. Combines Ultimate + CPU performance + GPU scheduling + power policy + memory + storage + visual effects. System Restore point created before execution. AC power strongly recommended.",
  "extends": ["Ultimate"],
  "targetProcessReduction": {
    "min": 100,
    "max": 170
  },
  "entries": [
    {
      "id": "maxperf.power.ultimateplan",
      "displayName": "Ultimate Performance Power Plan",
      "category": "Performance",
      "action": "SetPowerPlan",
