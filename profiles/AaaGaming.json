{
  "id": "AaaGaming",
  "displayName": "AAA Gaming",
  "description": "Advanced gaming optimization. Disables background processes, enables HAGS, maximizes GPU performance policy, disables network throttling and telemetry. Workload-aware: protects Steam, Epic, Battle.net, Xbox/Game Pass services.",
  "extends": ["Pro"],
  "targetProcessReduction": {
    "min": 60,
    "max": 100
  },
  "entries": [
    {
      "id": "gaming.powerplan",
      "displayName": "Ultimate Performance Power Plan (AC)",
      "category": "Performance",
      "action": "SetPowerPlan",
      "target": "e9a42b02-d5df-448d-aa00-03f14749eb61",
      "value": "e9a42b02-d5df-448d-aa00-03f14749eb61",
      "os": ["win10", "win11"],
      "risk": "Medium",
      "requiresConfirmation": false,
      "warning": "",
      "conditions": [
        { "type": "IsOnAc", "operator": "Equals", "value": true }
      ],
      "verification": "ReadBack",
      "rollback": "Snapshot"
    },
    {
      "id": "gaming.hags",
      "displayName": "Hardware Accelerated GPU Scheduling",
      "category": "Performance",
      "action": "SetHags",
      "target": "HwSchMode",
      "value": 2,
      "os": ["win10", "win11"],
      "risk": "Medium",
      "requiresConfirmation": false,
      "warning": "Requires DirectX 12 capable GPU.",
      "conditions": [],
      "verification": "ReadBack",
      "rollback": "Snapshot"
    },
    {
      "id": "gaming.foreground",
      "displayName": "Foreground Application Priority (Gaming)",
      "category": "Performance",
      "action": "SetForegroundPriority",
      "target": "Win32PrioritySeparation",
      "value": 38,
      "os": ["win10", "win11"],
      "risk": "Low",
      "requiresConfirmation": false,
      "warning": "",
      "conditions": [],
      "verification": "ReadBack",
      "rollback": "Snapshot"
    },
    {
      "id": "gaming.nv.maxpower",
      "displayName": "NVIDIA Maximum Performance Mode",
      "category": "Registry",
      "action": "SetRegistryValue",
      "target": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\nvlddmkm\\Global\\NvCplHorizontalPageFiles\\PowerMizerEnable",
      "value": 1,
      "os": ["win10", "win11"],
      "risk": "Medium",
      "requiresConfirmation": false,
      "warning": "NVIDIA GPU only. Sets GPU to maximum performance policy.",
      "conditions": [
        { "type": "HasNvidiaGpu", "operator": "Equals", "value": true },
        { "type": "IsOnAc", "operator": "Equals", "value": true }
      ],
      "verification": "ReadBack",
      "rollback": "Snapshot"
    },
    {
      "id": "gaming.sysresponsiveness",
      "displayName": "Multimedia SystemResponsiveness (Gaming)",
      "category": "Registry",
      "action": "SetRegistryValue",
      "target": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\SystemResponsiveness",
      "value": 0,
      "os": ["win10", "win11"],
      "risk": "Low",
      "requiresConfirmation": false,
      "warning": "",
      "conditions": [],
      "verification": "ReadBack",
      "rollback": "Snapshot"
    },
    {
      "id": "gaming.sysmain.ssd",
      "displayName": "Disable SysMain on SSD",
      "category": "Service",
      "action": "SetServiceStartup",
      "target": "SysMain",
      "value": "Disabled",
      "os": ["win10", "win11"],
      "risk": "Medium",
      "requiresConfirmation": false,
      "warning": "",
      "conditions": [
        { "type": "StorageIsSsd", "operator": "Equals", "value": true }
      ],
      "verification": "ReadBack",
      "rollback": "Snapshot"
    }
  ]
}
