<Application x:Class="BiosOptimizer.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BiosOptimizer.GUI.ViewModels"
             xmlns:views="clr-namespace:BiosOptimizer.GUI.Views"
             xmlns:conv="clr-namespace:BiosOptimizer.GUI.Converters"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Resources/Theme.xaml"/>

                <ResourceDictionary Source="Resources/Icons.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>

            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

            <conv:BoolToCheckmarkConverter x:Key="BoolToCheckmarkConverter"/>

            <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>

            <conv:StatusToFooterConverter x:Key="StatusToFooterConverter"/>

            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <conv:BoolToDetailsTextConverter x:Key="BoolToDetailsTextConverter"/>
            <conv:InverseNullOrEmptyToVisibilityConverter x:Key="InverseNullOrEmptyToVis"/>
            <conv:BooleanToYesNoConverter x:Key="BooleanToYesNoConverter"/>

            <!-- ViewModel -> View DataTemplate mappings -->

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">

                <views:DashboardView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OneClickOptimizationViewModel}">

                <views:OneClickOptimizationView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TierViewModel}">

                <views:TierView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:V4ViewModel}">

                <views:V4View/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AiOptimizationViewModel}">

                <views:AiOptimizationView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DebloatViewModel}">

                <views:DebloatView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:BiosSafeViewModel}">

                <views:BiosSafeView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">

                <views:SystemInfoView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StartupManagerViewModel}">

                <views:StartupManagerView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ServiceManagerViewModel}">

                <views:ServiceManagerView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NetworkViewModel}">

                <views:NetworkView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StorageViewModel}">

                <views:StorageView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ToolsViewModel}">

                <views:ToolsView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}">

                <views:BackupRestoreView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProcessReductionViewModel}">

                <views:ProcessReductionView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:InputOptimizerViewModel}">

                <views:InputOptimizerView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RegistryTweakViewModel}">

                <views:RegistryTweakView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RegistryValuesViewModel}">

                <views:RegistryValuesView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RegistryValuesRamViewModel}">

                <views:RegistryValuesRamView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:GpuRegistryValuesViewModel}">

                <views:GpuRegistryValuesView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">

                <views:SettingsView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AboutViewModel}">

                <views:AboutView/>

            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ErrorViewModel}">

                <views:ErrorView/>

            </DataTemplate>

        </ResourceDictionary>

    </Application.Resources>

</Application>

