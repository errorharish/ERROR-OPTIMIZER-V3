<UserControl x:Class="BiosOptimizer.GUI.Controls.UniversalOptimizationModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:BiosOptimizer.GUI.Services"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             x:Name="RootModal">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Indeterminate Progress Animation -->
        <Storyboard x:Key="IndeterminateStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="IndeterminateGlow"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-200" To="480" Duration="0:0:1.5" />
        </Storyboard>

        <!-- Pulse Halo Animation -->
        <Storyboard x:Key="PulseHaloStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HaloRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.85" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="HaloScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1.15" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="HaloScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.95" To="1.15" Duration="0:0:1.2" />
        </Storyboard>
    </UserControl.Resources>

    <!-- Global Dark Backdrop Overlay -->
    <Grid Background="#D005070B"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
          IsHitTestVisible="{Binding IsOpen}"
          Panel.ZIndex="10000">

        <!-- Single Unified Modal Window Container -->
        <Border Width="620" MaxWidth="680" MaxHeight="660" Background="#12141C"
                BorderBrush="{DynamicResource AccentBorderBrush}"
                BorderThickness="1.2" CornerRadius="14" Padding="24,20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="45" ShadowDepth="0" Opacity="0.92"/>
            </Border.Effect>

            <Grid>
                                <!-- ======================================================== -->
                <!-- STATE 0: RISK CONFIRMATION STATE (HIGH/MED RISK WARNING) -->
                <!-- ======================================================== -->
                <StackPanel HorizontalAlignment="Stretch"
                            Visibility="{Binding IsConfirmationRequired, Converter={StaticResource BoolToVis}}">
                    <!-- Glowing Risk Orb -->
                    <Grid Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse Width="68" Height="68" Fill="{Binding RiskGlowBrush}" Opacity="0.5"/>
                        <Border Width="52" Height="52" CornerRadius="26" Background="#1A1C24" BorderBrush="{Binding RiskLevelBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RiskIcon}" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{Binding RiskLevelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Risk Level Badge & Warning Title -->
                    <Border Background="{Binding RiskSoftBrush}" BorderBrush="{Binding RiskLevelBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="{Binding RiskLevelBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding RiskLevelBrush}"/>
                    </Border>

                    <TextBlock Text="{Binding RiskTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding RiskOptimizationName}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,12" TextAlignment="Center"/>

                    <!-- Warning Details Card -->
                    <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SYSTEM IMPACT &amp; SAFETY REASONING" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding RiskWarningReason}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,8"/>
                            
                            <Border Background="#0DFFFFFF" Margin="0,2,0,6" Height="1"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AFFECTED SUBSYSTEMS: " FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding RiskAffectedArea}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding RiskConfirmationQuestion}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" TextAlignment="Center"/>

                    <!-- Buttons: CANCEL & CONTINUE -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelRiskCommand}"
                                Height="36" Content="CANCEL"
                                FontWeight="Bold" FontSize="11" IsCancel="True"/>

                        <Button Grid.Column="2" Style="{StaticResource PrimaryOptimizationButton}"
                                Command="{Binding ConfirmRiskCommand}"
                                Height="36" Content="CONTINUE"
                                FontWeight="Bold" FontSize="11" IsDefault="True"/>
                    </Grid>
                </StackPanel>

                                <!-- ======================================================== -->
                <!-- STATE 0B: RESTORE POINT CREATION INPUT MODAL             -->
                <!-- ======================================================== -->
                <StackPanel HorizontalAlignment="Stretch"
                            Visibility="{Binding IsRestorePointPrompt, Converter={StaticResource BoolToVis}}">
                    <!-- Glowing Shield Orb -->
                    <Grid Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse Width="68" Height="68" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.5"/>
                        <Border Width="52" Height="52" CornerRadius="26" Background="#1A1C24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Header & Subtitle -->
                    <TextBlock Text="SYSTEM RESTORE POINT" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Create a verified Windows System Restore Point using Volume Shadow Copy." FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,14" TextAlignment="Center"/>

                    <!-- Input Card -->
                    <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="RESTORE POINT NAME" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            
                            <!-- Styled Modern Text Box -->
                            <Border Background="#0DFFFFFF" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBox Text="{Binding RestorePointInputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="11" FontWeight="SemiBold"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Example: 'Before Driver Update - Aug 26' or 'Pre-Optimization Snapshot'" FontSize="8" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions: CANCEL & CREATE RESTORE POINT -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelRestorePointCommand}"
                                Height="36" Content="CANCEL"
                                FontWeight="Bold" FontSize="10.5" IsCancel="True"/>

                        <Button Grid.Column="2" Style="{StaticResource PrimaryOptimizationButton}"
                                Command="{Binding ConfirmRestorePointCommand}"
                                Height="36" Content="CREATE RESTORE POINT"
                                FontWeight="Bold" FontSize="10.5" IsDefault="True"/>
                    </Grid>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- STATE 0C: SYSTEM PROTECTION REQUIRED MODAL               -->
                <!-- ======================================================== -->
                <StackPanel HorizontalAlignment="Stretch"
                            Visibility="{Binding IsSystemProtectionRequired, Converter={StaticResource BoolToVis}}">
                    <!-- Glowing Shield Alert Orb -->
                    <Grid Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse Width="68" Height="68" Fill="{DynamicResource WarningSoftBrush}" Opacity="0.6"/>
                        <Border Width="52" Height="52" CornerRadius="26" Background="#1A1C24" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Badge & Header -->
                    <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="SYSTEM PROTECTION REQUIRED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                    </Border>

                    <TextBlock Text="{Binding SystemProtectionTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding SystemProtectionDrive, StringFormat='Target Volume: {0}\\'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,12" TextAlignment="Center"/>

                    <!-- Warning Details Card -->
                    <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PROTECTION STATUS NOTICE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SystemProtectionMessage}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions: CANCEL & ENABLE & CONTINUE -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelSystemProtectionCommand}"
                                IsEnabled="{Binding IsEnableProtectionBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Height="36" Content="CANCEL"
                                FontWeight="Bold" FontSize="10.5" IsCancel="True"/>

                        <Button Grid.Column="2" Style="{StaticResource PrimaryOptimizationButton}"
                                Command="{Binding EnableProtectionAndContinueCommand}"
                                IsEnabled="{Binding IsEnableProtectionBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Height="36" Content="ENABLE &amp; CONTINUE"
                                FontWeight="Bold" FontSize="10.5" IsDefault="True"/>
                    </Grid>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- STATE 1: LOADING / EXECUTING / VERIFYING STATE           -->
                <!-- ======================================================== -->
                <StackPanel HorizontalAlignment="Stretch"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <!-- Animated Glowing Operation Orb -->
                    <Grid Width="74" Height="74" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse x:Name="HaloRing" Width="74" Height="74" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="HaloScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Border Width="56" Height="56" CornerRadius="28" Background="#1A1C24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Operation Title -->
                    <TextBlock Text="{Binding OperationTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding OperationSubtitle}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,18" TextAlignment="Center"/>

                    <!-- Progress Bar & Percentage Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding CurrentItem, FallbackValue='Executing optimization pipeline...'}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressPercentageText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- 3D Progress Bar Track -->
                    <Border Height="6" Background="#1A1E29" CornerRadius="3" BorderBrush="#252A38" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,14">
                        <Grid>
                            <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Height="6"/>

                            <Border x:Name="IndeterminateGlow" Width="120" Height="6" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Opacity="0.4"
                                    Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolToVis}}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-200"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Current Execution Stage Text -->
                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentStage}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- STATE 2: VERIFIED SUCCESS & RESULT DETAILS (FIXED FOOTER) -->
                <!-- ======================================================== -->
                <Grid Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- 0: Top Header (Orb + Title + Status Badge) -->
                        <RowDefinition Height="Auto"/><!-- 1: Divider -->
                        <RowDefinition Height="Auto"/><!-- 2: Summary Metrics (4 Glass Cards) -->
                        <RowDefinition Height="Auto"/><!-- 3: Execution Status Strip (Time, Backup, Rollback) -->
                        <RowDefinition Height="Auto"/><!-- 4: Pipeline Stages Timeline -->
                        <RowDefinition Height="*"/><!-- 5: Detailed Action Breakdown Accordion (Scrolls Internally) -->
                        <RowDefinition Height="Auto"/><!-- 6: FIXED FOOTER (Always 100% Visible & Clickable) -->
                    </Grid.RowDefinitions>

                    <!-- 0: Top Header: Glowing Result Orb & Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Glowing Success Orb -->
                        <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Width="44" Height="44" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.45"/>
                            <Border Width="36" Height="36" CornerRadius="18" Background="#181B26" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Headline & Profile Name -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResultTitle, FallbackValue='OPTIMIZATION VERIFIED'}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ProfileName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding ResultMessage}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Overall Status Badge -->
                        <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{Binding OverallStatusBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverallStatusText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding OverallStatusBrush}"/>
                        </Border>
                    </Grid>

                    <!-- 1: Divider -->
                    <Border Grid.Row="1" Height="1" Background="#14FFFFFF" Margin="0,0,0,10"/>

                    <!-- 2: SUMMARY METRICS CARDS (4 Compact Glass Cards) -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: APPLIED -->
                        <Border Grid.Column="0" Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="APPLIED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AppliedCount}" FontSize="15" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: VERIFIED -->
                        <Border Grid.Column="2" Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="VERIFIED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding VerifiedCount}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: ALREADY OPTIMAL -->
                        <Border Grid.Column="4" Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ALREADY OPTIMAL" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AlreadyOptimizedCount}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: SKIPPED / PROTECTED -->
                        <Border Grid.Column="6" Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PROTECTED / N/A" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SkippedCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3: EXECUTION STATUS STRIP -->
                    <Border Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EXECUTION TIME" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DurationText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SYSTEM BACKUP" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding BackupStatusText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ROLLBACK STATE" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RollbackStatusText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4: OPTIMIZATION STAGES TIMELINE -->
                    <Border Grid.Row="4" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="OPTIMIZATION PIPELINE STAGES" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ExecutionStages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0DFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="4" Padding="5,4" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding StatusBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding Name}" FontSize="7" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 5: EXPANDABLE DETAILS ACCORDION (FLEXIBLE / SCROLLS INTERNALLY) -->
                    <Border Grid.Row="5" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,12" MinHeight="36">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="DETAILED ACTION BREAKDOWN" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleDetailsCommand}"
                                        Content="{Binding DetailsToggleLabel}"
                                        FontSize="8.5" FontWeight="Bold" Height="22" Padding="8,0" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Internal Scrollable Items List (Only this scrolls when expanded) -->
                            <Border Grid.Row="1" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" MaxHeight="140">
                                <ListView ItemsSource="{Binding OptimizationItems}" Background="Transparent" BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CategoryIcon}" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding DetailNote}" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="7.5" FontWeight="Bold" Foreground="{Binding StatusBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 6: FIXED FOOTER / BOTTOM ACTIONS (ALWAYS 100% VISIBLE & CLICKABLE) -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ViewProfileCommand}"
                                Height="34" Padding="14,0"
                                FontWeight="Bold" FontSize="10" Content="VIEW PROFILES"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryOptimizationButton}"
                                    Command="{Binding CloseCommand}"
                                    Height="34" Width="120"
                                    FontWeight="Bold" FontSize="10.5" Content="CLOSE"
                                    IsDefault="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ======================================================== -->
                <!-- STATE 3: FAILURE / WARNING / DIAGNOSTICS STATE           -->
                <!-- ======================================================== -->
                <StackPanel HorizontalAlignment="Stretch">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTimedOut}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Error Orb -->
                    <Grid Width="74" Height="74" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse Width="74" Height="74" Fill="#33EF4444" Opacity="0.5"/>
                        <Border Width="56" Height="56" CornerRadius="28" Background="#1A1C24" BorderBrush="#EF4444" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Error Header -->
                    <TextBlock Text="{Binding ResultTitle}" FontSize="15" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding FailureReason}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,14" TextAlignment="Center" TextWrapping="Wrap"/>

                    <!-- Failure Stage Details -->
                    <Border Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="LAST EXECUTION STAGE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding FailureStage}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons: RETRY & CLOSE -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PrimaryOptimizationButton}"
                                Command="{Binding RetryCommand}"
                                Height="36" Padding="20,0" Margin="0,0,10,0"
                                FontWeight="Bold" FontSize="10.5" Content="RETRY"
                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"/>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CloseCommand}"
                                Height="36" Padding="24,0"
                                FontWeight="Bold" FontSize="10.5" Content="CLOSE"
                                IsCancel="True"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
