<UserControl x:Class="BiosOptimizer.GUI.Controls.OptimizationProgressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="700" d:DesignHeight="180"
             x:Name="RootCtrl">

    <Border Background="#0C0D12" BorderBrush="#252A38" BorderThickness="1"
            CornerRadius="12" Padding="20,16" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource BrandPrimaryColor}" BlurRadius="25" ShadowDepth="0" Opacity="0.25" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Status and Percentage -->
                <RowDefinition Height="Auto" />  <!-- 3D Glowing Progress Bar -->
                <RowDefinition Height="Auto" />  <!-- Current Action -->
                <RowDefinition Height="Auto" />  <!-- Step Counts & Result Badges -->
            </Grid.RowDefinitions>

            <!-- Header: Status Title & Percentage -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText, ElementName=RootCtrl}"
                               Foreground="#F0F1F3" FontSize="13" FontWeight="Bold"
                                VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                    <Run Text="{Binding OptimizationProgress, ElementName=RootCtrl, Mode=OneWay, StringFormat='{}{0:0}'}" />
                    <Run Text="%" FontSize="13" Foreground="#9DA3B0" />
                </TextBlock>
            </Grid>

            <!-- 3D Glowing Progress Bar Track -->
            <Grid Grid.Row="1" Margin="0,0,0,12" Height="14">
                <!-- Outer Track Background -->
                <Border x:Name="TrackBorder" Background="#141722" BorderBrush="#1E2230"
                        BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                    <Grid>
                        <!-- Grid Lines for 3D Technical Feel -->
                        <Rectangle Fill="#0AFFFFFF" Height="1" VerticalAlignment="Top" />
                        <Rectangle Fill="#0A000000" Height="1" VerticalAlignment="Bottom" />

                        <!-- Active Fill with Dynamic 3D Gradient and Glow -->
                        <Border x:Name="FillBorder" HorizontalAlignment="Left" CornerRadius="6" Width="0"
                                Background="{DynamicResource PrimaryGradientBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource BrandPrimaryColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.85" />
                            </Border.Effect>
                            <!-- Top Specular Highlight for 3D Cylinder look -->
                            <Rectangle Height="3" VerticalAlignment="Top" Fill="#40FFFFFF" RadiusX="3" RadiusY="3" Margin="2,1,2,0" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Current Action Description -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Current: " Foreground="#5A6070" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentAction, ElementName=RootCtrl}"
                               Foreground="#9DA3B0" FontSize="11" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>

                <!-- Steps (e.g. 18 / 29) -->
                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#9DA3B0" FontFamily="Consolas">
                    <Run Text="{Binding CurrentStep, ElementName=RootCtrl, Mode=OneWay}" FontWeight="Bold" Foreground="#F0F1F3"/>
                    <Run Text="/" Foreground="#5A6070"/>
                    <Run Text="{Binding TotalSteps, ElementName=RootCtrl, Mode=OneWay}" Foreground="#9DA3B0"/>
                </TextBlock>
            </Grid>

            <!-- Counts Row: Successful, Skipped, Failed Badges -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Successful Badge -->
                <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1"
                        CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓ Successful: " FontSize="10" Foreground="#10B981" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SuccessCount, ElementName=RootCtrl}" FontSize="10" Foreground="#10B981" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Skipped Badge -->
                <Border Background="#1A9E9E9E" BorderBrush="#339E9E9E" BorderThickness="1"
                        CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="— Skipped: " FontSize="10" Foreground="#9DA3B0" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SkippedCount, ElementName=RootCtrl}" FontSize="10" Foreground="#9DA3B0" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Failed Badge -->
                <Border Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1"
                        CornerRadius="4" Padding="8,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕ Failed: " FontSize="10" Foreground="#EF4444" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FailedCount, ElementName=RootCtrl}" FontSize="10" Foreground="#EF4444" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

