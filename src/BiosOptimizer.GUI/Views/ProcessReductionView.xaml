<UserControl x:Class="BiosOptimizer.GUI.Views.ProcessReductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <Style x:Key="CategoryPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ROOT ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource SlimScrollViewer}">
            <Grid Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: Header -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>  <!-- 2: Metric Cards -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- 4: Result / Summary -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- 6: Search & Filter Toolbar -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto" MinHeight="340"/>  <!-- 8: Candidate List -->
                </Grid.RowDefinitions>

                <!-- ══ 0: HEADER ══ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="PROCESS INTELLIGENCE" Style="{StaticResource PageTitleStyle}" Margin="0,0,10,0"/>
                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="SAFE BACKGROUND PROCESS MANAGEMENT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Analyze running processes, identify non-essential background activity, and safely reclaim system resources."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="↻ REFRESH / RESCAN"
                                Command="{Binding ScanCommand}"
                                Margin="0,0,8,0" Padding="14,7"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>

                        <Button Style="{StaticResource DangerButtonStyle}"
                                Content="{Binding SelectedCount, StringFormat=⚡ TERMINATE SELECTED ({0})}"
                                Command="{Binding OpenConfirmationCommand}"
                                IsEnabled="{Binding HasSelected}"
                                Padding="16,7" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- ══ 2: METRIC CARDS ══ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Safe to Terminate -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SAFE TO TERMINATE" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SafeCount}" Style="{StaticResource MetricValueStyle}"
                                       Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Number of processes currently classified as safe." Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Selected -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SELECTED" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource MetricValueStyle}"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Marked for safe termination" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Reclaimable -->
                    <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="RAM RECLAIMABLE" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedRamText}"
                                       Style="{StaticResource MetricValueStyle}"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Estimated memory that would be released by selected processes." Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- System Status -->
                    <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM STATUS" Style="{StaticResource MetricLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{StaticResource StatusBlueBrush}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{StaticResource StatusGreenBrush}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                                <TextBlock Text="{Binding SystemStatus}" FontSize="15" FontWeight="Bold"
                                           Foreground="{Binding SystemStatusColor}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Based on current process and memory state." Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ 4: RESULT / SUMMARY BANNER (shown after termination) ══ -->
                <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="16,12"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="#1A10B981" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}"
                                       FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TERMINATION COMPLETE" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{Binding ResultText}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 6: SEARCH & FILTER & SORT TOOLBAR ══ -->
                <Border Grid.Row="6" Style="{StaticResource GlassCardStyle}" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Search input + Select All / Deselect All -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search bar -->
                            <Border Grid.Column="0" Background="#11000000" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Bulk Select Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PillFilterButton}"
                                        Content="SELECT ALL SAFE" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="12,5"/>
                                <Button Style="{StaticResource PillFilterButton}"
                                        Content="DESELECT ALL" Command="{Binding DeselectAllCommand}" Padding="12,5"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Filter Category Pills + Sort Selector -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <Button Content="ALL" Command="{Binding SetFilterCommand}" CommandParameter="ALL" Margin="0,0,6,0" Padding="10,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="SAFE TO TERMINATE" Command="{Binding SetFilterCommand}" CommandParameter="SAFE" Margin="0,0,6,0" Padding="10,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterSafe}" Value="True">
                                                    <Setter Property="Background" Value="#2210B981"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="CAUTION" Command="{Binding SetFilterCommand}" CommandParameter="CAUTION" Margin="0,0,6,0" Padding="10,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterCaution}" Value="True">
                                                    <Setter Property="Background" Value="#22F59E0B"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="PROTECTED / SYSTEM" Command="{Binding SetFilterCommand}" CommandParameter="PROTECTED" Margin="0,0,6,0" Padding="10,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterProtected}" Value="True">
                                                    <Setter Property="Background" Value="#223B82F6"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource StatusBlueBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="HIGH MEMORY (>100MB)" Command="{Binding SetFilterCommand}" CommandParameter="HIGH_MEM" Margin="0,0,6,0" Padding="10,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterHighMemory}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="HIGH CPU (>1%)" Command="{Binding SetFilterCommand}" CommandParameter="HIGH_CPU" Padding="10,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterHighCpu}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <!-- Sort Selector -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SORT:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="SAFETY + RAM" Style="{StaticResource PillFilterButton}" Command="{Binding SetSortCommand}" CommandParameter="SAFETY_RAM" Margin="0,0,4,0" Padding="8,3"/>
                                <Button Content="RAM" Style="{StaticResource PillFilterButton}" Command="{Binding SetSortCommand}" CommandParameter="RAM_DESC" Margin="0,0,4,0" Padding="8,3"/>
                                <Button Content="CPU" Style="{StaticResource PillFilterButton}" Command="{Binding SetSortCommand}" CommandParameter="CPU_DESC" Margin="0,0,4,0" Padding="8,3"/>
                                <Button Content="NAME" Style="{StaticResource PillFilterButton}" Command="{Binding SetSortCommand}" CommandParameter="NAME_ASC" Padding="8,3"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ══ 8: PROCESS CANDIDATE LIST ══ -->
                <Border Grid.Row="8" Style="{StaticResource GlassCardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto" MinHeight="260"/>
                        </Grid.RowDefinitions>

                        <!-- List Title & Active Count -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BACKGROUND PROCESS CANDIDATES" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProcessCandidates.Count, StringFormat={}{0} active candidates}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Column Headers -->
                        <Grid Grid.Row="2" Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>   <!-- Select -->
                                <ColumnDefinition Width="65"/>   <!-- RAM -->
                                <ColumnDefinition Width="*"/>    <!-- Process Name & Path -->
                                <ColumnDefinition Width="65"/>   <!-- CPU -->
                                <ColumnDefinition Width="130"/>  <!-- Safety -->
                                <ColumnDefinition Width="160"/>  <!-- Reason -->
                                <ColumnDefinition Width="60"/>   <!-- PID -->
                                <ColumnDefinition Width="65"/>   <!-- Details -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SELECT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="MEMORY" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="PROCESS &amp; IDENTITY" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="CPU" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="SAFETY LEVEL" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="5" Text="REASON" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="6" Text="PID" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="ACTION" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Virtualized Items List -->
                        <ListView Grid.Row="4" ItemsSource="{Binding ProcessCandidates}"
                                  Background="Transparent" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  MaxHeight="520">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Bd" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0D0D10"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSafeToKill}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#2510B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>   <!-- Select -->
                                                <ColumnDefinition Width="65"/>   <!-- RAM -->
                                                <ColumnDefinition Width="*"/>    <!-- Process Name & Path -->
                                                <ColumnDefinition Width="65"/>   <!-- CPU -->
                                                <ColumnDefinition Width="130"/>  <!-- Safety -->
                                                <ColumnDefinition Width="160"/>  <!-- Reason -->
                                                <ColumnDefinition Width="60"/>   <!-- PID -->
                                                <ColumnDefinition Width="65"/>   <!-- Details -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" ToolTip="Select for termination (Safe processes only)"/>

                                            <!-- RAM badge -->
                                            <Border Grid.Column="1" Width="52" Height="36" CornerRadius="4"
                                                    Background="#14FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedRam}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Process Name & File Description & Path -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProcessName, StringFormat=({0}.exe)}"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding DisplayName, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ProcessPath}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="9" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" Opacity="0.65"/>
                                            </StackPanel>

                                            <!-- CPU % -->
                                            <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedCpu}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- Safety Badge -->
                                            <Border Grid.Column="4" CornerRadius="3" Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#143B82F6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSafeToKill}" Value="True">
                                                                <Setter Property="Background" Value="#2010B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCaution}" Value="True">
                                                                <Setter Property="Background" Value="#20F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SafetyLevel}" FontSize="9" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusBlueBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSafeToKill}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCaution}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Reason -->
                                            <TextBlock Grid.Column="5" Text="{Binding Reason}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10" TextWrapping="Wrap" MaxHeight="32"
                                                       TextTrimming="WordEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                            <!-- PID -->
                                            <TextBlock Grid.Column="6" Text="{Binding ProcessId}"
                                                       FontSize="10" FontFamily="Consolas"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- Details Button -->
                                            <Button Grid.Column="7" Content="DETAILS"
                                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PillFilterButton}"
                                                    FontSize="8" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <Border Grid.Row="4" Background="#06FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6"
                                Padding="20,30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasNoProcesses, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="NO SAFE BACKGROUND PROCESSES FOUND" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Everything currently running appears necessary or protected."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ══ CONFIRMATION MODAL OVERLAY ══ -->
        <Grid Background="#B0000000" Visibility="{Binding ShowConfirmationModal, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource GlassCardStyle}" Padding="24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="⚡" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="TERMINATE SELECTED PROCESSES?" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding SelectedCount, StringFormat=Selected: {0} Background Processes}"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedRamText, StringFormat=Estimated Memory Freed: ≈{0}}"
                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Warning: The selected background processes will be terminated immediately. Unsaved application state may be lost."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCEL" Command="{Binding CancelConfirmationCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="14,6"/>
                        <Button Content="CONFIRM TERMINATE" Command="{Binding ConfirmTerminateCommand}"
                                Style="{StaticResource DangerButtonStyle}" Padding="16,6" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ PROCESS DETAILS MODAL OVERLAY ══ -->
        <Grid Background="#B0000000" Visibility="{Binding ShowDetailsModal, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource GlassCardStyle}" Padding="24" BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel DataContext="{Binding SelectedProcessForDetails}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ProcessName, StringFormat=Executable: {0}.exe}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource PillFilterButton}" Padding="8,4" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Details Table -->
                    <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Process ID (PID):" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProcessId}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Publisher / Company:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Publisher}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Working Set Memory:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FormattedRam}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU Usage (Approx):" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FormattedCpu}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Safety Level:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SafetyLevel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Analysis Reason:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Reason}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Executable Path:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProcessPath}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Button Content="CLOSE" Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="16,6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
