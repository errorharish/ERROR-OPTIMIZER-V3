<UserControl x:Class="BiosOptimizer.GUI.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:vm="clr-namespace:BiosOptimizer.GUI.ViewModels"
             Background="Transparent" 
             UseLayoutRounding="True" SnapsToDevicePixels="True" 
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <!-- Main Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource SlimScrollViewer}">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><!-- 0: Header -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/><!-- 2: Unified System Health Dashboard Banner -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 4: Advanced Search Bar -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/><!-- 6: Category Filters & Sorting Strip -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/><!-- 8: Unified System Tools Continuous Grid -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/><!-- 10: Recent Activity -->
                </Grid.RowDefinitions>

                <!-- ============================================================
                     1. HEADER
                     ============================================================ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavigationIcon Icon="Tools" IsActive="True" Size="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SYSTEM TOOLS &amp; HEALTH DIAGNOSTICS" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Unified toolbox — 16 advanced Windows diagnostics, repair, and cleanup utilities in one continuous catalog."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Top-Right Actions & Live Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1410B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" MinWidth="100" Height="32">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="REFRESH" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================================================
                     2. UNIFIED SYSTEM HEALTH DASHBOARD BANNER
                     ============================================================ -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="18,16" Background="#121418">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><!-- Gauge -->
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/><!-- Health Details -->
                            <ColumnDefinition Width="Auto"/><!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <!-- Health Score Gauge -->
                        <Grid Grid.Column="0" Width="84" Height="84" VerticalAlignment="Center">
                            <Ellipse Stroke="#1FFFFFFF" StrokeThickness="6"/>
                            <Ellipse Stroke="{Binding HealthScoreBrushKey, FallbackValue={StaticResource SuccessBrush}}" StrokeThickness="6"
                                     StrokeDashArray="80 20" StrokeDashOffset="25"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SystemHealthScoreText}" FontSize="22" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="/ 100" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Health Details & Critical Cap Alert -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding SystemHealthStateText}" FontSize="15" FontWeight="Bold" Foreground="{Binding HealthScoreBrushKey, FallbackValue={StaticResource SuccessBrush}}"/>
                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="10,0,0,0"
                                        Visibility="{Binding HasCriticalCap, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CriticalCapText}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SystemHealthSummary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <!-- Active Recommendations Alert Bar -->
                            <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"
                                    Visibility="{Binding HasActiveRecommendations, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveRecommendations.Count, StringFormat='{}{0} Actionable System Health Optimization(s) Detected'}" 
                                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Vertical" MinWidth="170">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OneClickHealthOptimizeCommand}" Height="34" Margin="0,0,0,8"
                                    IsEnabled="{Binding HasActiveRecommendations}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ONE-CLICK OPTIMIZE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RunHealthScanCommand}" Height="30">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="RE-SCAN HEALTH" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================================
                     3. ADVANCED SEARCH BAR
                     ============================================================ -->
                <Border Grid.Row="4" Background="{DynamicResource BgCardBrush}" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" 
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" 
                                 FontSize="12" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>

                        <TextBlock Grid.Column="1" Text="Search tools, categories, actions, or components (e.g. sfc, ram, dism, bios, dns, timer, cleanup)..." 
                                   FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource InverseNullOrEmptyToVis}, FallbackValue=Visible}"/>

                        <Button Grid.Column="2" Content="✕" Command="{Binding ResetFilterCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Width="22" Height="22" Padding="0" FontSize="9" VerticalAlignment="Center"
                                Visibility="{Binding SearchQuery, Converter={StaticResource NullToCollapsedConverter}}"/>
                    </Grid>
                </Border>

                <!-- ============================================================
                     4. CATEGORY FILTERS & STATUS / SORT STRIP
                     ============================================================ -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category Filter Buttons -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CategoryPillStyle}" Content="ALL TOOLS" Command="{Binding FilterCategoryCommand}" CommandParameter="ALL" Margin="0,0,5,4"/>
                        <Button Style="{StaticResource CategoryPillStyle}" Content="CLEANUP" Command="{Binding FilterCategoryCommand}" CommandParameter="CLEANUP" Margin="0,0,5,4"/>
                        <Button Style="{StaticResource CategoryPillStyle}" Content="MEMORY" Command="{Binding FilterCategoryCommand}" CommandParameter="MEMORY" Margin="0,0,5,4"/>
                        <Button Style="{StaticResource CategoryPillStyle}" Content="REPAIR &amp; INTEGRITY" Command="{Binding FilterCategoryCommand}" CommandParameter="REPAIR" Margin="0,0,5,4"/>
                        <Button Style="{StaticResource CategoryPillStyle}" Content="HARDWARE &amp; BIOS" Command="{Binding FilterCategoryCommand}" CommandParameter="HARDWARE" Margin="0,0,5,4"/>
                        <Button Style="{StaticResource CategoryPillStyle}" Content="WINDOWS OS" Command="{Binding FilterCategoryCommand}" CommandParameter="WINDOWS" Margin="0,0,5,4"/>
                        <Button Style="{StaticResource CategoryPillStyle}" Content="NETWORK" Command="{Binding FilterCategoryCommand}" CommandParameter="NETWORK" Margin="0,0,5,4"/>
                        <Button Style="{StaticResource CategoryPillStyle}" Content="GPU &amp; DISPLAY" Command="{Binding FilterCategoryCommand}" CommandParameter="GPU" Margin="0,0,5,4"/>
                        <Button Style="{StaticResource CategoryPillStyle}" Content="ADVANCED" Command="{Binding FilterCategoryCommand}" CommandParameter="ADVANCED" Margin="0,0,5,4"/>
                    </WrapPanel>

                    <!-- Count & Quick Filters -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,4">
                        <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="5" Padding="8,4">
                            <TextBlock Text="{Binding FilteredTools.Count, StringFormat='{}{0} Tools Available'}" 
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============================================================
                     5. UNIFIED SYSTEM TOOLS CONTINUOUS GRID (All 16 in One List)
                     ============================================================ -->
                <Grid Grid.Row="8">
                    <!-- Empty State When No Tools Match -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="30" Margin="0,10"
                            Visibility="{Binding HasNoMatchingTools, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="NO TOOLS FOUND" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No system tools or diagnostics match your current search query or active filter." 
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="RESET ALL FILTERS" Command="{Binding ResetFilterCommand}" 
                                    Height="32" Padding="16,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Continuous Tool Card Grid -->
                    <ItemsControl ItemsSource="{Binding FilteredTools}" HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding HasNoMatchingTools, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Margin="5" Padding="14,12" Background="#0C1014">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><!-- Header -->
                                            <RowDefinition Height="36"/><!-- Description -->
                                            <RowDefinition Height="Auto"/><!-- Metric & Status Strip -->
                                            <RowDefinition Height="Auto"/><!-- Action Buttons -->
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon, Title, Badges, Pin -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Tool Icon -->
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#14FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Title & Category Badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="·" FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                                    <Border Background="#12FFFFFF" CornerRadius="2.5" Padding="4,0.5">
                                                        <TextBlock Text="{Binding SafetyBadgeText}" FontSize="7.5" FontWeight="Bold" Foreground="{Binding SafetyBadgeBrushKey, FallbackValue={StaticResource SuccessBrush}}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Admin Requirement Badge -->
                                            <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1.5" 
                                                    Margin="6,0,6,0" VerticalAlignment="Center" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="ADMIN" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>

                                            <!-- Pin Button -->
                                            <Button Grid.Column="3" Content="★" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Width="24" Height="24" Padding="0" FontSize="11" VerticalAlignment="Center"
                                                    Foreground="{Binding IsPinned, Converter={StaticResource BoolToColorConverter}}"/>
                                        </Grid>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                                        <!-- Metric & Live Status Strip -->
                                        <Border Grid.Row="2" Background="#0AFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Metric -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MetricLabel, StringFormat='{}{0}: '}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding MetricValue}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="3" Padding="6,1.5">
                                                    <TextBlock Text="{Binding Status}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusBrushKey, FallbackValue={StaticResource SuccessBrush}}"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Action Buttons: [ PRIMARY ACTION ] [ VIEW DETAILS ] -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Primary Action Button -->
                                            <Button Grid.Column="0" Content="{Binding PrimaryButtonText}" 
                                                    Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>

                                            <!-- View Details Button (Available on EVERY tool) -->
                                            <Button Grid.Column="1" Content="VIEW DETAILS" 
                                                    Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="12,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ============================================================
                     6. RECENT TOOL ACTIVITY
                     ============================================================ -->
                <Border Grid.Row="10" Style="{StaticResource GlassCardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="RECENT TOOL ACTIVITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="0,3">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                                Command="{Binding DataContext.OpenActivityToolDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch" Padding="6,4" Height="Auto" Background="#06FFFFFF" BorderBrush="#0AFFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="✓" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ResultSummary}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TimestampText}" FontSize="8" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No tool actions executed in this session yet." FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding RecentActivities.Count, Converter={StaticResource InverseNullOrEmptyToVis}, FallbackValue=Collapsed}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================
             7. ADVANCED TOOL EXECUTION MODAL (Real Execution & Progress)
             ============================================================ -->
        <Grid Background="#B3000000" Visibility="{Binding IsExecutionModalOpen, Converter={StaticResource BoolToVis}}" 
              SnapsToDevicePixels="True">
            <Border Width="660" MaxHeight="620" Style="{StaticResource GlassCardStyle}" Background="#141620" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1.5" 
                    CornerRadius="12" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- 0: Header -->
                        <RowDefinition Height="Auto"/><!-- 1: Progress & Steps -->
                        <RowDefinition Height="Auto"/><!-- 2: Context Metadata Strip -->
                        <RowDefinition Height="Auto"/><!-- 3: Success / Failure Cards -->
                        <RowDefinition Height="*"/><!-- 4: Collapsible Terminal Console -->
                        <RowDefinition Height="Auto"/><!-- 5: Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- ══ 0. HEADER: Orb + Tool Name + Live Status Badge ══ -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Glowing Tool Orb -->
                        <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Ellipse Width="44" Height="44" Fill="{DynamicResource AccentSoftBrush}" Opacity="0.8"/>
                            <Border Width="34" Height="34" CornerRadius="17" Background="#1A1C24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedTool.IconGlyph, FallbackValue='&#xE7E8;'}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedTool.Name, FallbackValue='System Diagnostics'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ExecutionStatusText}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Status Badges: Dual Service + Tool State -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Service Status Badge -->
                            <Border Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SERVICE: " FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding BackendStatusBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding BackendStatusBadgeBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Tool Process Status Badge -->
                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TOOL: " FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ToolExecutionStateText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding ToolExecutionBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ══ 1. PROGRESS & STEPS ══ -->
                    <Border Grid.Row="1" Background="#161822" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Progress Bar + Percentage -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Value="{Binding ExecutionProgress}" IsIndeterminate="{Binding IsExecutionIndeterminate}" Maximum="100" Height="8" VerticalAlignment="Center" Style="{StaticResource RedProgressBarThickStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ExecutionProgressText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Live Step Breadcrumb -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="PREPARING" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StagePreparingBrush}"/>
                                <TextBlock Text=" • " FontSize="8.5" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="SCANNING" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StageScanningBrush}"/>
                                <TextBlock Text=" • " FontSize="8.5" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="VERIFYING" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StageVerifyingBrush}"/>
                                <TextBlock Text=" • " FontSize="8.5" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="REPAIRING" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StageRepairingBrush}"/>
                                <TextBlock Text=" • " FontSize="8.5" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="FINALIZING" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StageFinalizingBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ══ 2. CONTEXT METADATA STRIP (Target, Process, Elapsed, Backend) ══ -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Target -->
                        <Border Grid.Column="0" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="TARGET" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ExecutionTargetInfo}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Process -->
                        <Border Grid.Column="2" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="PROCESS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ExecutionProcessText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Elapsed -->
                        <Border Grid.Column="4" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="ELAPSED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ExecutionElapsedText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Backend -->
                        <Border Grid.Column="6" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="BACKEND" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding BackendStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══ 3. SUCCESS / FAILURE CARDS ══ -->
                    <Grid Grid.Row="3" Margin="0,0,0,12" Visibility="{Binding IsExecutionFinished, Converter={StaticResource BoolToVis}}">
                        <!-- Success Card -->
                        <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                                Visibility="{Binding IsExecutionSuccessful, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="✓ COMPLETED • SYSTEM VERIFIED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding ExecutionSummaryText}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ExecutionDurationText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding ExecutionExitCodeText}" FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Failure Card -->
                        <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                                Visibility="{Binding IsExecutionFailed, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✗ EXECUTION FAILED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExecutionExitCodeText}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                </Grid>
                                <TextBlock Text="{Binding ExecutionSummaryText}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ExecutionRootCauseText}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding ExecutionRootCauseText, Converter={StaticResource InverseNullOrEmptyToVis}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══ 4. COLLAPSIBLE DIAGNOSTIC CONSOLE ══ -->
                    <Border Grid.Row="4" Background="#0A0A0E" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                            Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="140" Style="{StaticResource SlimScrollViewer}">
                            <TextBox Text="{Binding ExecutionConsoleLog, Mode=OneWay}" 
                                     Background="Transparent" BorderThickness="0" Foreground="#10B981" 
                                     FontFamily="Consolas, Courier New, monospace" FontSize="9.5" 
                                     IsReadOnly="True" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- ══ 5. FOOTER ACTIONS ══ -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Toggle Details Button -->
                        <Button Grid.Column="0" Content="{Binding IsDetailsExpanded, Converter={StaticResource BoolToDetailsTextConverter}}" Command="{Binding ToggleDetailsCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,0"/>

                        <!-- Safety Text -->
                        <TextBlock Grid.Column="1" Text="● Transactional safety verified" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="2" Content="CANCEL" Command="{Binding CancelExecutionCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Height="30" Padding="14,0" Margin="0,0,8,0" Visibility="{Binding IsExecutionRunning, Converter={StaticResource BoolToVis}}"/>

                        <!-- Close / Done Button -->
                        <Button Grid.Column="3" Content="CLOSE" Command="{Binding CloseExecutionModalCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Height="30" Padding="18,0" IsEnabled="{Binding IsExecutionFinished}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             8. TOOL-SPECIFIC DETAILS MODAL (Live Diagnostic Drawer/Modal)
             ============================================================ -->
        <Grid Background="#CC000000" Visibility="{Binding IsDetailsModalOpen, Converter={StaticResource BoolToVis}}" 
              SnapsToDevicePixels="True">
            <Border Width="620" MaxHeight="560" Background="#16161A" BorderBrush="#33FFFFFF" BorderThickness="1" 
                    CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- Header -->
                        <RowDefinition Height="*"/><!-- Details content -->
                        <RowDefinition Height="Auto"/><!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tool Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#18FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedTool.IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title and Badges -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedTool.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SelectedTool.Category, StringFormat='CATEGORY: {0}'}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedTool.SafetyBadgeText}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <Border Background="#14FFFFFF" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedTool.RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="REQUIRES ELEVATION" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Content="✕" Command="{Binding CloseDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                Width="30" Height="30" Padding="0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Details Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}" Margin="0,0,0,18">
                        <StackPanel>
                            <!-- Section 1: Live Diagnostic Attributes (Specific to this tool) -->
                            <TextBlock Text="LIVE DIAGNOSTIC ATTRIBUTES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                <ItemsControl ItemsSource="{Binding SelectedTool.LiveDiagnosticFields}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding Label}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Value}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding BrushKey, FallbackValue={StaticResource TextPrimaryBrush}}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Section 2: Overview -->
                            <TextBlock Text="FUNCTION OVERVIEW" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SelectedTool.Description}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- Section 3: Technical Specification -->
                            <TextBlock Text="TECHNICAL SPECIFICATION &amp; ENGINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <Border Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <TextBlock Text="{Binding SelectedTool.TechnicalDetails}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontFamily="Segoe UI, Consolas"/>
                            </Border>

                            <!-- Section 4: Affected Components -->
                            <TextBlock Text="AFFECTED SUBSYSTEMS &amp; COMPONENTS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SelectedTool.AffectedComponents}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- Section 5: Security & Execution Architecture -->
                            <TextBlock Text="SECURITY &amp; EXECUTION ARCHITECTURE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Safety Level -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,8">
                                    <StackPanel>
                                        <TextBlock Text="SAFETY LEVEL" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedTool.SafetyBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Elevation Requirement -->
                                <Border Grid.Row="0" Grid.Column="1" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="6,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="ELEVATION REQUIREMENT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedTool.AdminRequirementBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Execution Method -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="EXECUTION METHOD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedTool.ExecutionMethodText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- Verification Method -->
                                <Border Grid.Row="1" Grid.Column="1" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="VERIFICATION METHOD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedTool.VerificationMethodText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Action -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="CLOSE" Command="{Binding CloseDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Padding="20,0" Margin="0,0,10,0"/>

                        <Button Grid.Column="2" Content="{Binding SelectedTool.PrimaryButtonText}" 
                                Command="{Binding RunToolCommand}" CommandParameter="{Binding SelectedTool}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="22,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
