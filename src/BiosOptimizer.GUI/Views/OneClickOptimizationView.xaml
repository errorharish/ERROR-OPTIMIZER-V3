<UserControl x:Class="BiosOptimizer.GUI.Views.OneClickOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BiosOptimizer.GUI.ViewModels"
             mc:Ignorable="d"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" 
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="OneClickCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ══ MAIN SCROLLABLE DASHBOARD ══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="28,24,28,32">

                                <!-- ══ BACK TO DASHBOARD NAVIGATION STRIP ══ -->
                <Button Command="{Binding BackToDashboardCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"
                        Padding="14,7"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BACK TO DASHBOARD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- ══ 1. HEADER & GAP ANALYSIS BANNER ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="ONE-CLICK OPTIMIZATION" Style="{StaticResource PageTitleStyle}"/>
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TRUE MISSING CAPABILITIES ONLY" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Additional system tools and optimizations not already provided by Error Optimizer." 
                                   Style="{StaticResource PageSubtitleStyle}"/>
                        <TextBlock Text="These actions were identified as additional capabilities outside the existing Error Optimizer optimization engines." 
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↻ RE-AUDIT" Command="{Binding RefreshPlanCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="14,8"/>
                        <Button Content="⚡ RUN ONE-CLICK OPTIMIZATION" Command="{Binding RunFullOneClickCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Padding="18,8"/>
                    </StackPanel>
                </Grid>

                <!-- ══ 2. AUDIT SUMMARY METRICS STRIP ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Missing Capabilities Count -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="MISSING TOOLS IDENTIFIED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalActionsCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Recommended -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RecommendedCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Already Completed -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="ALREADY OPTIMAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AlreadyDoneCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Recoverable Cache Space -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="RECOVERABLE CACHE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RecoverableSpaceText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Admin / Restart -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="RESTART REQUIRED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ManualCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 3. WHAT WILL IT DO? SAFETY OVERVIEW ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0810B981" BorderBrush="#2010B981" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="ONE-CLICK SCOPE (MISSING CAPABILITIES ONLY)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="14">
                                <Run Text="✓ Clear compiled DirectX, NVIDIA, AMD &amp; Intel shader repositories"/>
                                <LineBreak/>
                                <Run Text="✓ Flush fragmented RAM standby list &amp; working sets into free memory"/>
                                <LineBreak/>
                                <Run Text="✓ Fast Clean temporary system caches &amp; disposable clutter"/>
                                <LineBreak/>
                                <Run Text="✓ Deep Clean Windows Update download cache &amp; disposable browser caches"/>
                                <LineBreak/>
                                <Run Text="✓ Visual Tweaks: 0ms DWM transparency &amp; window animation latency removal"/>
                                <LineBreak/>
                                <Run Text="✓ Elite BCD Timers: Dynamic tick disable &amp; static HPET timer precision"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="WHAT IS NOT INCLUDED (EXCLUDED BY DESIGN)" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                            <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="14">
                                <Run Text="✗ No Duplicate Engines: Registry, Debloat, Input, &amp; Services remain in their dedicated modules"/>
                                <LineBreak/>
                                <Run Text="✗ No SFC / DISM Repairs: System File Repair is reserved for the upcoming System Repair feature"/>
                                <LineBreak/>
                                <Run Text="✗ No Smart Optimization Alterations: Machine-specific engine remains separate"/>
                                <LineBreak/>
                                <Run Text="✗ Zero Personal Data Impact: Passwords, bookmarks, profiles, and downloads are never touched"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ 4. FILTER TABS ══ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="ALL MISSING CAPABILITIES" Command="{Binding FilterCommand}" CommandParameter="ALL" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"/>
                    <Button Content="RECOMMENDED" Command="{Binding FilterCommand}" CommandParameter="RECOMMENDED" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"/>
                    <Button Content="CLEANUP &amp; CACHE" Command="{Binding FilterCommand}" CommandParameter="CLEANUP" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"/>
                    <Button Content="RAM MANAGEMENT" Command="{Binding FilterCommand}" CommandParameter="RAM MANAGEMENT" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"/>
                    <Button Content="VISUAL PERFORMANCE" Command="{Binding FilterCommand}" CommandParameter="VISUAL PERFORMANCE" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"/>
                    <Button Content="SYSTEM TIMERS" Command="{Binding FilterCommand}" CommandParameter="SYSTEM TIMERS" 
                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"/>
                </StackPanel>

                <!-- ══ 5. ACTION CARDS (TRUE MISSING CAPABILITIES) ══ -->
                <ItemsControl ItemsSource="{Binding FilteredActions}" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource OneClickCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <!-- Category Badge -->
                                            <Border Background="#14FFFFFF" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>

                                            <!-- Risk Badge -->
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                                <TextBlock FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                                                    <Run Text="{Binding RiskLevel, Mode=OneWay}"/><Run Text=" RISK"/>
                                                </TextBlock>
                                            </Border>

                                            <!-- Restart Badge -->
                                            <Border Background="#1AF59E0B" CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="REQUIRES RESTART" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                            </Border>

                                            <!-- Title -->
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0">
                                                <Run Text="Current: " Foreground="{StaticResource TextMutedBrush}"/>
                                                <Run Text="{Binding CurrentStateText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0">
                                                <Run Text="Target: " Foreground="{StaticResource TextMutedBrush}"/>
                                                <Run Text="{Binding TargetStateText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#60A5FA">
                                                <Run Text="Impact: " Foreground="{StaticResource TextMutedBrush}"/>
                                                <Run Text="{Binding MetricText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding DataContext.RunSingleActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="14,6" VerticalAlignment="Center">
                                        <TextBlock Text="RUN ACTION" FontSize="9" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══ 6. ALREADY PROVIDED BY ERROR OPTIMIZER (AUDIT TRANSPARENCY) ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ALREADY PROVIDED BY ERROR OPTIMIZER (NOT DUPLICATED)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="These reference features were audited and verified to already exist in Error Optimizer's core engines, preventing duplicate background handlers." 
                                   FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding ExistingFeatures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding FeatureName}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HandledByModule}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══ 7. SYSTEM REPAIR EXCLUSION NOTICE ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="SYSTEM REPAIR (EXCLUDED BY DESIGN — SEPARATE UPCOMING MODULE)" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,4"/>
                        <TextBlock Text="Windows Component Store repairs (SFC /scannow and DISM /RestoreHealth) are architectural system integrity repairs and are intentionally excluded from One-Click Optimization. They will be provided in a dedicated System Repair module." 
                                   FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        

    </Grid>
</UserControl>
