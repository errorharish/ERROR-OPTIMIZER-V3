<UserControl x:Class="BiosOptimizer.GUI.Views.InputOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1000"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Background" Value="#0F1015"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="28,24,28,36">

                <!-- ══ 1. HEADER ══ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INPUT OPTIMIZER" Style="{StaticResource PageTitleStyle}" FontSize="20" FontWeight="Bold"/>
                            <Border Margin="12,0,0,0" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="LATENCY REDUCTION ENGINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Hardware-level pointer precision, repeat rates, timer resolution, and real-time input verification."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" FontSize="12"/>
                    </StackPanel>

                    <!-- Header Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↺  REFRESH" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0"/>
                        <Button Content="RESTORE DEFAULTS" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6"/>
                    </StackPanel>
                </Grid>

                <!-- ══ 2. SYSTEM INPUT HEALTH CARDS ══ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mouse Health -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="MOUSE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="6,2" Background="#1410B981">
                                    <TextBlock Text="{Binding MouseHealthStatus}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding MouseDeviceDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Acceleration &amp; Curves" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Keyboard Health -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="KEYBOARD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="6,2" Background="#1410B981">
                                    <TextBlock Text="{Binding KeyboardHealthStatus}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding KeyboardDeviceDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Repeat Rate &amp; Buffer" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Timer Health -->
                    <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="TIMER RESOLUTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="6,2" Background="#143B82F6">
                                    <TextBlock Text="{Binding TimerHealthStatus}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StatusBlueBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding TimerResDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Windows Clock Tick" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stability Health -->
                    <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="INPUT STABILITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" Padding="6,2" Background="#14F59E0B">
                                    <TextBlock Text="{Binding StabilityHealthStatus}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding StabilityDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Measured Jitter Variance" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ 3. CURRENT MODE SELECTOR ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentModeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Automatic safe input optimization"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="NORMAL" Command="{Binding SetNormalModeCommand}" Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNormalMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="CUSTOM" Command="{Binding SetCustomModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 4. NORMAL MODE INTERFACE (CLEAN DASHBOARD — NO INDIVIDUAL LIST) ══ -->
                <StackPanel Visibility="{Binding IsNormalMode, Converter={StaticResource BoolToVis}}">
                    <!-- Normal Input Optimization High-Level Summary Card -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NORMAL INPUT OPTIMIZATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Normal mode automatically applies safe, policy-approved input optimizations that are applicable to this system."
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Applicable: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding NormalApplicableCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0"/>

                                    <TextBlock Text="Optimized: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding NormalOptimizedCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,14,0"/>

                                    <TextBlock Text="Pending: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding NormalPendingCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,14,0"/>

                                    <TextBlock Text="Not Applicable: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding NormalNotApplicableCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Primary Normal Action Button -->
                            <Button Grid.Column="1" Content="{Binding NormalRunButtonText}" Command="{Binding NormalOptimizeCommand}"
                                    IsEnabled="{Binding CanOptimizeNormal}" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="24,10" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Advanced Input Optimization High-Level Summary Card -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ADVANCED INPUT OPTIMIZATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Applies deeper system-level input tuning supported by this system."
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Applicable: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AdvancedApplicableCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0"/>

                                    <TextBlock Text="Optimized: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AdvancedOptimizedCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,14,0"/>

                                    <TextBlock Text="Pending: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AdvancedPendingCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Primary Advanced Action Button -->
                            <Button Grid.Column="1" Content="{Binding AdvancedRunButtonText}" Command="{Binding AdvancedOptimizeCommand}"
                                    IsEnabled="{Binding CanOptimizeAdvanced}" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="24,10" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ══ 5. CUSTOM MODE INTERFACE (TWO INDEPENDENT OPTIMIZATION WORKSPACES) ══ -->
                <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
                    
                    <!-- Section: Normal Input Optimization (Independent Custom Workspace) -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Header & Dedicated Toolbar -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NORMAL INPUT OPTIMIZATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Safe, policy-approved input tuning available for this system." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    
                                    <!-- Normal Status Counts Strip -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Applicable: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding NormalApplicableCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Optimized: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding NormalOptimizedCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Pending: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding NormalPendingCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Dedicated Normal Selection Toolbar -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="SELECT ALL" Command="{Binding NormalSelectAllCommand}" Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button Content="DESELECT ALL" Command="{Binding NormalDeselectAllCommand}" Style="{StaticResource PillButtonStyle}" Margin="0,0,10,0" Padding="10,4"/>
                                    
                                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NormalSelectedCount, StringFormat={}{0} / }" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding NormalSelectableCount, Mode=OneWay}"/>
                                            <Run Text=" SELECTED" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Normal Actionable Items List -->
                            <ItemsControl ItemsSource="{Binding NormalApplicableItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"/>

                                                <!-- Name & Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border Background="#14FFFFFF" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Current -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="CURRENT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding CurrentValue}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Target -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="TARGET" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding TargetValue}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Recommendation -->
                                                <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" Padding="6,2" Background="#14FFFFFF">
                                                    <TextBlock Text="{Binding Recommendation}" FontSize="8" FontWeight="Bold" Foreground="{Binding RecommendationColor}"/>
                                                </Border>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="8,3" Background="#14FFFFFF">
                                                    <TextBlock Text="{Binding DisplayStatus}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Dedicated Normal Optimization Button -->
                            <Button Content="{Binding NormalCustomRunButtonText}" Command="{Binding OptimizeNormalCustomCommand}"
                                    IsEnabled="{Binding CanOptimizeNormalCustom}" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="24,10" Margin="0,8,0,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Section: Advanced Input Optimization (Independent Custom Workspace) -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Header & Dedicated Toolbar -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ADVANCED INPUT OPTIMIZATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Advanced system-level input tuning for users who want fine-grained control." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    
                                    <!-- Advanced Status Counts Strip -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Applicable: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding AdvancedApplicableCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Optimized: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding AdvancedOptimizedCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Pending: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding AdvancedPendingCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Dedicated Advanced Selection Toolbar -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="SELECT ALL" Command="{Binding AdvancedSelectAllCommand}" Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button Content="DESELECT ALL" Command="{Binding AdvancedDeselectAllCommand}" Style="{StaticResource PillButtonStyle}" Margin="0,0,10,0" Padding="10,4"/>
                                    
                                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AdvancedSelectedCount, StringFormat={}{0} / }" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding AdvancedSelectableCount, Mode=OneWay}"/>
                                            <Run Text=" SELECTED" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Advanced Actionable Items List -->
                            <ItemsControl ItemsSource="{Binding AdvancedApplicableItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#08FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"/>

                                                <!-- Name & Risk & Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border Background="#20F59E0B" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Risk}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                        </Border>
                                                        <Border Background="#14FFFFFF" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Current -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="CURRENT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding CurrentValue}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Target -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="TARGET" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding TargetValue}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Recommendation -->
                                                <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3" Padding="6,2" Background="#14FFFFFF">
                                                    <TextBlock Text="{Binding Recommendation}" FontSize="8" FontWeight="Bold" Foreground="{Binding RecommendationColor}"/>
                                                </Border>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="8,3" Background="#14FFFFFF">
                                                    <TextBlock Text="{Binding DisplayStatus}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Dedicated Advanced Optimization Button -->
                            <Button Content="{Binding AdvancedCustomRunButtonText}" Command="{Binding OptimizeAdvancedCustomCommand}"
                                    IsEnabled="{Binding CanOptimizeAdvancedCustom}" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="24,10" Margin="0,8,0,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══ 6. REAL INPUT TEST SECTION ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="REAL INPUT TEST &amp; JITTER MEASUREMENT" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Measures physical mouse intervals, high-precision timer ticks, and timing consistency."
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Test Trigger Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="5 SEC TEST" Command="{Binding StartTest5sCommand}"
                                        Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Padding="12,6"/>
                                <Button Content="10 SEC TEST" Command="{Binding StartTest10sCommand}"
                                        Style="{StaticResource PillButtonStyle}" Margin="0,0,6,0" Padding="12,6"/>
                                <Button Content="30 SEC TEST" Command="{Binding StartTest30sCommand}"
                                        Style="{StaticResource PillButtonStyle}" Padding="12,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Test Status Banner -->
                        <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                            <TextBlock Text="{Binding TestStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <!-- Test Metrics Grid -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Samples -->
                            <Border Grid.Column="0" Background="#0CFFFFFF" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="SAMPLES" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TestSamples}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Avg Interval -->
                            <Border Grid.Column="2" Background="#0CFFFFFF" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="AVG INTERVAL" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TestAverageInterval}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Frequency -->
                            <Border Grid.Column="4" Background="#0CFFFFFF" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="FREQUENCY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TestFrequency}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Jitter -->
                            <Border Grid.Column="6" Background="#0CFFFFFF" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="JITTER" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TestJitter}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Timer -->
                            <Border Grid.Column="8" Background="#0CFFFFFF" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="TIMER RES" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TestTimer}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource StatusBlueBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#1010B981" BorderBrush="#2010B981" BorderThickness="1" CornerRadius="4" Padding="10,6">
                            <TextBlock Text="{Binding TestVerdict}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 7. BEFORE / AFTER COMPARISON ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="BEFORE / AFTER OPTIMIZATION PROOF" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Directional verification comparing baseline system state against post-optimization readings."
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- BEFORE -->
                            <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="BEFORE OPTIMIZATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Polling Rate:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding BeforePollingRate}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Timer Resolution:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding BeforeTimer}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Measured Jitter:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding BeforeJitter}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="1" Text="➔" FontSize="18" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- AFTER -->
                            <Border Grid.Column="2" Background="#0A10B981" BorderBrush="#2010B981" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="AFTER OPTIMIZATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Polling Rate:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding AfterPollingRate}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Timer Resolution:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding AfterTimer}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Measured Jitter:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding AfterJitter}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══ 8. TECHNICAL DETAILS (COLLAPSIBLE) ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="VIEW TECHNICAL DETAILS  ▼" Command="{Binding ToggleTechDetailsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="14,6"/>

                        <StackPanel Visibility="{Binding ShowTechDetails, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                            <TextBlock Text="DIAGNOSTIC TELEMETRY BREAKDOWN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AllDiagnosticItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border Background="#14FFFFFF" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Risk}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                        </Border>
                                                        <Border Background="#10FFFFFF" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    
                                                    <TextBlock Text="{Binding TechnicalLocation, StringFormat='Registry/Device: {0}'}" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <TextBlock Grid.Column="0" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}">
                                                            <Run Text="Applicable: " Foreground="{StaticResource TextMutedBrush}"/>
                                                            <Run Text="{Binding ApplicabilityDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}">
                                                            <Run Text="Current: " Foreground="{StaticResource TextMutedBrush}"/>
                                                            <Run Text="{Binding CurrentValue, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="4" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}">
                                                            <Run Text="Target: " Foreground="{StaticResource TextMutedBrush}"/>
                                                            <Run Text="{Binding TargetValue, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="6" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}">
                                                            <Run Text="Reboot: " Foreground="{StaticResource TextMutedBrush}"/>
                                                            <Run Text="{Binding RequiresRebootDisplay, Mode=OneWay}" Foreground="{StaticResource WarningBrush}"/>
                                                        </TextBlock>
                                                    </Grid>

                                                    <TextBlock FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                                                        <Run Text="Verification: " Foreground="{StaticResource TextMutedBrush}"/>
                                                        <Run Text="{Binding VerificationDisplay, Mode=OneWay}" Foreground="{StaticResource StatusBlueBrush}"/>
                                                    </TextBlock>
                                                    
                                                    <TextBlock Text="{Binding Description, StringFormat='Description: {0}'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="10,4" Background="#14FFFFFF" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding DisplayStatus}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        
    </Grid>
</UserControl>
