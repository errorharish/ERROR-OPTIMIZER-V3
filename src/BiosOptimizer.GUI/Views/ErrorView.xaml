<UserControl x:Class="BiosOptimizer.GUI.Views.ErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="28,24,24,24">
        <Border Style="{StaticResource GlassCardStyle}" Padding="32,28" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
            <StackPanel>
                <!-- Glowing Error Orb -->
                <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Ellipse Width="60" Height="60" Fill="{StaticResource DangerSoftBrush}" Opacity="0.8"/>
                    <Border Width="46" Height="46" CornerRadius="23" Background="#1A1C24" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock Text="NAVIGATION ERROR" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>

                <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                    <ScrollViewer MaxHeight="200" Style="{StaticResource SlimScrollViewer}">
                        <TextBlock Text="{Binding StackTrace}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <Button Content="RETRY NAVIGATION" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="20,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
