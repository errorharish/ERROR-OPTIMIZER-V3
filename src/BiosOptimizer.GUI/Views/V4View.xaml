<UserControl x:Class="BiosOptimizer.GUI.Views.V4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ERROR OPTIMIZER V4"
                                   Style="{StaticResource PageTitleStyle}"/>
                        <Border Background="{StaticResource DangerSoftBrush}"
                                BorderBrush="{StaticResource DangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="MAXIMUM PERFORMANCE"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Maximum safe system optimization + maximum background process reduction + Gaming &amp; Editing performance tuning."
                               Style="{StaticResource PageSubtitleStyle}"
                               TextWrapping="Wrap"
                               MaxWidth="760"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AnalyzeCommand}"
                        Padding="18,11"
                        VerticalAlignment="Center">
                    <TextBlock Text="Analyze PC"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CURRENT PROCESSES" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding CurrentProcessCount, FallbackValue=—}"
                                   Margin="0,8,0,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Live Windows process count"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="V4 TARGET" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding TargetText}"
                                   Margin="0,8,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Target, not a forced kill limit"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="WORKLOAD" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding WorkloadText}"
                                   Margin="0,8,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="One combined maximum-performance profile"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="MAXIMUM SAFE OPTIMIZATION MODEL"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ScanStatus}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="18"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="OPTIMIZATION PIPELINE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="ANALYZE → SNAPSHOT → CLASSIFY → PLAN → BACKUP → OPTIMIZE → RE-SCAN → VERIFY → MEASURE"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           LineHeight="19"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="PROCESS INTELLIGENCE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="Protected • Required • Workload Required • Optional • Background • Reducible • Unknown"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           LineHeight="19"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="GAMING + EDITING TUNING"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="19">
                            <Run Text="Preserve GPU drivers, audio, input, network, anti-cheat and active application dependencies. "/>
                            <Run Text="Reduce unrelated startup apps, services, scheduled tasks, background apps, updaters and OEM utilities where safely removable."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="PROCESS REDUCTION"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="The 70–80 range is the desired background footprint when achievable. V4 must stop when the next reduction would risk Windows, hardware drivers, security or the active workload."
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="19"/>
                        <TextBlock Text="{Binding ReductionText}"
                                   Margin="0,12,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
