<UserControl x:Class="BiosOptimizer.GUI.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BiosOptimizer.GUI.ViewModels"
             mc:Ignorable="d"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" 
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Premium Heart / Health Widget Style -->
        <Style x:Key="HealthWidgetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectionBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WidgetBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WidgetBorder" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                <Setter TargetName="WidgetBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WidgetBorder" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Technical Expand Toggle Button Style -->
        <Style x:Key="ExpandToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#10FFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ══ MAIN SCROLLABLE CONTENT ══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="28,24,28,32">

                <!-- ══ 1. TOP HEADER & INTERACTIVE HEALTH CONTROL ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="SYSTEM INFO" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Real-time hardware, Windows and system health diagnostics." 
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Header Controls (Refresh + Interactive Health Widget) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Refresh Button -->
                        <Button Content="↻ REFRESH" Command="{Binding RefreshCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="14,8"
                                ToolTip="Refresh all system hardware and diagnostic telemetry"/>

                        <!-- Interactive System Health Diagnostic Control -->
                        <Button Command="{Binding RunHealthAnalysisCommand}" Style="{StaticResource HealthWidgetButtonStyle}"
                                ToolTip="{Binding HealthTooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Professional Circular ECG Diagnostic Telemetry Ring -->
                                <Border Width="32" Height="32" CornerRadius="16" Background="#18000000" BorderBrush="{Binding HealthBadgeBrush}" BorderThickness="1.5" Margin="0,0,10,0">
                                    <Viewbox Width="18" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Sharp Oscilloscope ECG Waveform -->
                                        <Path Stroke="{Binding HealthBadgeBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 1,8 L 5,8 L 7,2 L 10,14 L 13,4 L 15,10 L 17,8 L 22,8"/>
                                    </Viewbox>
                                </Border>

                                <!-- Text Telemetry -->
                                <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding HealthActionText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding HealthActionSubtext}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding HealthBadgeBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ══ 2. COMPACT SYSTEM HEALTH HERO SUMMARY ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,16" BorderBrush="#26FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Health Summary Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding HealthBadgeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OverallHealthStatus, StringFormat='SYSTEM HEALTH: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{Binding HealthBadgeBrush}"/>
                        </StackPanel>

                        <!-- Subsystem Status Pills -->
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Hardware -->
                            <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock FontSize="10" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                    <Run Text=" Hardware"/>
                                </TextBlock>
                            </Border>

                            <!-- Windows -->
                            <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock FontSize="10" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                    <Run Text=" Windows"/>
                                </TextBlock>
                            </Border>

                            <!-- Security -->
                            <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock FontSize="10" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                    <Run Text=" Security"/>
                                </TextBlock>
                            </Border>

                            <!-- Storage -->
                            <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock FontSize="10" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                    <Run Text=" Storage"/>
                                </TextBlock>
                            </Border>

                            <!-- Performance -->
                            <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock FontSize="10" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                    <Run Text=" Performance"/>
                                </TextBlock>
                            </Border>

                            <!-- Drivers -->
                            <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <TextBlock FontSize="10" Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                    <Run Text=" Drivers"/>
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <!-- Live Status Indicator -->
                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ══ 3. SYSTEM OVERVIEW (INFORMATION-DENSE COMPACT TILES) ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SYSTEM OVERVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                        <UniformGrid Columns="3" Rows="2">
                            <!-- CPU Tile -->
                            <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="PROCESSOR (CPU)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Cpu.Name}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0">
                                        <Run Text="{Binding Cpu.PhysicalCores, Mode=OneWay, StringFormat='{}{0} Cores • '}"/>
                                        <Run Text="{Binding Cpu.LogicalProcessors, Mode=OneWay, StringFormat='{}{0} Threads'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- GPU Tile -->
                            <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="3,0,3,6">
                                <StackPanel>
                                    <TextBlock Text="GRAPHICS (GPU)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding PrimaryGpuSummary}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Graphics.DirectXVersion}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Memory Tile -->
                            <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="6,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM MEMORY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Memory.InstalledRamText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0">
                                        <Run Text="{Binding Memory.SpeedText, Mode=OneWay}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding Memory.ChannelConfig, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Storage Tile -->
                            <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3,6,0">
                                <StackPanel>
                                    <TextBlock Text="PRIMARY STORAGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding StorageSummary}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Storage.PrimaryStorageType, FallbackValue='NVMe SSD'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Windows OS Tile -->
                            <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="3,3,3,0">
                                <StackPanel>
                                    <TextBlock Text="WINDOWS OS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Windows.Edition}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Windows.OsBuild, StringFormat='Build: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Power Tile -->
                            <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="6,3,0,0">
                                <StackPanel>
                                    <TextBlock Text="POWER &amp; BATTERY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Power.PowerSourceText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Power.PowerPlan, StringFormat='Plan: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ══ 4. GRAPHICS SUBSYSTEM & MULTI-GPU CARDS ══ -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="GRAPHICS SUBSYSTEM &amp; GPU ADAPTERS" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                    <Button Content="▸ VIEW TECHNICAL DETAILS" 
                            Command="{Binding ToggleGpuDetailsCommand}" 
                            Style="{StaticResource ExpandToggleButtonStyle}" HorizontalAlignment="Right"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding GpusList}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="4,4,4,4">
                                <StackPanel>
                                    <!-- Header with Type Badge -->
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="3" Padding="6,2" Background="#143B82F6">
                                            <TextBlock Text="{Binding AdapterType}" FontSize="8" FontWeight="Bold" Foreground="#60A5FA"/>
                                        </Border>
                                    </Grid>

                                    <!-- Primary Metrics -->
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Dedicated VRAM:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding DedicatedVramText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Shared GPU Memory:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SharedMemoryText}" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Driver Version:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding DriverVersion}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Resolution &amp; Refresh Rate:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right">
                                            <Run Text="{Binding Resolution, Mode=OneWay}"/>
                                            <Run Text=" @ "/>
                                            <Run Text="{Binding RefreshRate, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Hardware Accelerated Scheduling:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding HagsStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Expandable Technical Details (DirectX, WDDM, Feature Levels, Release Date, Memory Source) -->
                                    <Border Background="#06FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,8,0,0" 
                                            Visibility="{Binding DataContext.IsGpuDetailsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="DirectX API:" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding DirectXVersion}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="WDDM Version:" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding WddmVersion}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Driver Release Date:" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding DriverDate, FallbackValue='Current'}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Memory Source:" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding MemorySource}" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Reserved / Pre-Allocated:" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding ReservedMemoryText, FallbackValue='None'}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══ 5. CPU & MEMORY DIAGNOSTICS SPLIT SECTION ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU Card -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="0,0,6,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PROCESSOR (CPU) ARCHITECTURE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <Button Content="DETAILS" Command="{Binding ToggleCpuDetailsCommand}" Style="{StaticResource ExpandToggleButtonStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <TextBlock Text="{Binding Cpu.Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Cpu.Architecture}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Physical Cores / Threads:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right">
                                    <Run Text="{Binding Cpu.PhysicalCores, Mode=OneWay}"/>
                                    <Run Text=" Cores / "/>
                                    <Run Text="{Binding Cpu.LogicalProcessors, Mode=OneWay}"/>
                                    <Run Text=" Threads"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Base / Max Frequency:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right">
                                    <Run Text="{Binding Cpu.BaseClock, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Cpu.MaxClock, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Level 3 (L3) Cache:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Cpu.L3Cache}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Virtualization (VT-x / AMD-V):" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Cpu.Virtualization}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Expandable CPU Specs -->
                            <Border Background="#06FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,8,0,0" 
                                    Visibility="{Binding IsCpuDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Level 2 (L2) Cache:" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Cpu.L2Cache}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Socket / Package:" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Cpu.Socket}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Hyper-V Virtualization:" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Cpu.HyperVStatus}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Memory Card -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="6,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="SYSTEM MEMORY (RAM)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding Memory.SlotsText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding Memory.InstalledRamText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Memory.UsedRamText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Memory Usage Bar -->
                            <ProgressBar Value="{Binding Memory.UsagePercentage, Mode=OneWay}" Maximum="100" Height="5" 
                                         Foreground="{DynamicResource AccentBrush}" Background="#15FFFFFF" BorderThickness="0" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Memory Speed &amp; Type:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right">
                                    <Run Text="{Binding Memory.MemoryType, Mode=OneWay}"/>
                                    <Run Text=" @ "/>
                                    <Run Text="{Binding Memory.SpeedText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Channel Mode:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Memory.ChannelConfig}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Available Free RAM:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Memory.AvailableRamText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Virtual Memory Headroom:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Memory.VirtualMemoryText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ 6. STORAGE & DISK VOLUMES ══ -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="STORAGE SUBSYSTEM &amp; VOLUMES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                        <!-- Partitions -->
                        <ItemsControl ItemsSource="{Binding Storage.Partitions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                                    <Run Text="{Binding DriveLetter, Mode=OneWay}"/>
                                                    <Run Text=" ("/>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Format}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <ProgressBar Value="{Binding UsagePercentage}" Maximum="100" Height="5" 
                                                             Foreground="{DynamicResource AccentBrush}" Background="#15FFFFFF" BorderThickness="0" Margin="0,0,0,3"/>
                                                <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding UsedText, Mode=OneWay}"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding TotalText, Mode=OneWay}"/>
                                                    <Run Text=" ("/>
                                                    <Run Text="{Binding FreeText, Mode=OneWay}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="8,2" Background="#1410B981">
                                                <TextBlock Text="{Binding HealthBadge}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══ 7. MOTHERBOARD, WINDOWS & SECURITY ══ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Motherboard & BIOS -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="MOTHERBOARD &amp; FIRMWARE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Manufacturer &amp; Model:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right">
                                    <Run Text="{Binding Motherboard.Manufacturer, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Motherboard.Model, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="BIOS Version &amp; Vendor:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right">
                                    <Run Text="{Binding Motherboard.BiosVendor, Mode=OneWay}"/>
                                    <Run Text=" v"/>
                                    <Run Text="{Binding Motherboard.BiosVersion, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Firmware Architecture:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Motherboard.FirmwareType}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="TPM Hardware Security:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Motherboard.TpmStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Security Center -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SECURITY &amp; SYSTEM INTEGRITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="UEFI Secure Boot:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Security.SecureBootDetail}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="TPM 2.0 Cryptography:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Security.TpmDetail}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Microsoft Defender:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Security.DefenderDetail}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Core Isolation (HVCI):" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Security.CoreIsolationDetail}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ 8. POWER & NETWORK CONNECTIVITY ══ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Power & Battery -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="POWER &amp; CHASSIS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Power Source:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Power.PowerSourceText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Battery Charge &amp; Health:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right">
                                    <Run Text="{Binding Power.BatteryPercentage, Mode=OneWay, StringFormat='{}{0}%'}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding Power.BatteryHealth, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Active Power Plan:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Power.PowerPlan}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Network Adapter -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="16,14" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="NETWORK &amp; CONNECTIVITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Active Interface:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Network.ActiveAdapterName}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Connection Type / Speed:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right">
                                    <Run Text="{Binding Network.ConnectionType, Mode=OneWay}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding Network.LinkSpeed, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <TextBlock Text="IPv4 Address:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Network.Ipv4Address}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ 9. UNIVERSAL SYSTEM HEALTH ANALYSIS MODAL ══ -->
        <Grid Background="#CC000000" Visibility="{Binding IsHealthModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="999">
            <Border Width="680" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#0D0D14" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SYSTEM HEALTH ANALYSIS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding HealthModalProgressText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseHealthModalCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0"/>
                    </Grid>

                    <!-- Modal Stepper & Progress -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding HealthModalStage}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding HealthModalProgress, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <ProgressBar Value="{Binding HealthModalProgress}" Maximum="100" Height="6" 
                                     Foreground="{DynamicResource AccentBrush}" Background="#15FFFFFF" BorderThickness="0" Margin="0,0,0,8"/>

                        <Border Background="#08FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="4" Padding="10,6">
                            <TextBlock Text="{Binding HealthModalCheck}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <!-- Findings / Diagnostic Report (When Complete) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                        <StackPanel Visibility="{Binding IsHealthScanCompleted, Converter={StaticResource BoolToVis}}">

                            <!-- Score Header Card -->
                            <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Score Circle -->
                                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HealthReport.OverallScore}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HealthReport.OverallRating, StringFormat='HEALTH RATING: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding HealthReport.Summary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Findings Filter Tabs -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="ALL" Command="{Binding FilterFindingsCommand}" CommandParameter="ALL" 
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="WARNINGS" Command="{Binding FilterFindingsCommand}" CommandParameter="WARNINGS" 
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="PASS" Command="{Binding FilterFindingsCommand}" CommandParameter="PASS" 
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="HARDWARE" Command="{Binding FilterFindingsCommand}" CommandParameter="Hardware" 
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="SECURITY" Command="{Binding FilterFindingsCommand}" CommandParameter="Security" 
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"/>
                            </StackPanel>

                            <!-- Findings List -->
                            <ItemsControl ItemsSource="{Binding FilteredFindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border HorizontalAlignment="Right" CornerRadius="3" Padding="6,1" Background="#14FFFFFF">
                                                        <TextBlock Text="{Binding Severity}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2">
                                                    <Run Text="State: " Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Run Text="{Binding CurrentState, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                                <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                                    <Run Text="Recommended Action: "/>
                                                    <Run Text="{Binding RecommendedAction, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="DONE / CLOSE" Command="{Binding CloseHealthModalCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Padding="20,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
