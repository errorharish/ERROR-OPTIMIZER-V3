<UserControl x:Class="BiosOptimizer.GUI.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:conv="clr-namespace:BiosOptimizer.GUI.Converters"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- ============================================================ -->
        <!-- WORKSPACE 1: MAIN STORAGE OVERVIEW                           -->
        <!-- ============================================================ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource SlimScrollViewer}"
                      Visibility="{Binding OverviewWorkspaceVisibility}">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><!-- 0: Header -->
                    <RowDefinition Height="16"/><!-- 1: Spacer -->
                    <RowDefinition Height="Auto"/><!-- 2: Storage Overview Hero Cards -->
                    <RowDefinition Height="16"/><!-- 3: Spacer -->
                    <RowDefinition Height="Auto"/><!-- 4: Detected Drives -->
                    <RowDefinition Height="20"/><!-- 5: Spacer -->
                    <RowDefinition Height="Auto"/><!-- 6: Deep Clean (Detailed Categories) -->
                    <RowDefinition Height="20"/><!-- 7: Spacer -->
                    <RowDefinition Height="Auto"/><!-- 8: Recycle Bin -->
                    <RowDefinition Height="20"/><!-- 9: Spacer -->
                    <RowDefinition Height="Auto"/><!-- 10: Cleanup Result / Progress -->
                    <RowDefinition Height="20"/><!-- 11: Spacer -->
                    <RowDefinition Height="Auto"/><!-- 12: Full File Explorer Entry Card -->
                </Grid.RowDefinitions>

                <!-- 0: HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STORAGE OPTIMIZER"
                                   Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Analyze storage, find unnecessary files, and safely manage disk space."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Header actions: SMART CLEAN (Primary Guided), REFRESH (Secondary) -->
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="SMART CLEAN"
                                Command="{Binding SmartCleanCommand}" Margin="0,0,8,0" MinWidth="140" Height="36"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="REFRESH"
                                Command="{Binding RefreshCommand}" MinWidth="90" Height="36"/>
                    </WrapPanel>
                </Grid>

                <!-- 2: HERO SUMMARY CARDS -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Health -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="STORAGE HEALTH" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding OverallHealth}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Status}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Free Space -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="FREE SPACE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalFreeText}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding TotalCapacityText, StringFormat='of {0} total'}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Used -->
                    <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="USED SPACE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalUsedText}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding TotalCapacityText, StringFormat='of {0} capacity'}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Reclaimable -->
                    <Border Grid.Column="6" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="RECLAIMABLE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ReclaimableText}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Run scan to update" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4: DETECTED DRIVES -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="DETECTED DRIVES" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Padding="18,16"
                                        Margin="0,0,12,12" MinWidth="250" MaxWidth="340">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Drive Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Letter}" FontSize="17" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding VolumeLabel}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <!-- Health Badge -->
                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,2"
                                                    VerticalAlignment="Top" Background="#1A4CAF50">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}"
                                                             Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HealthStatus}" FontSize="10"
                                                               FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Drive Info -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="FILESYSTEM" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Format}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="TYPE" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding InterfaceType}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Usage Progress Bar -->
                                        <ProgressBar Grid.Row="4" Value="{Binding UsagePercentage}" Maximum="100"
                                                     Height="7" Style="{StaticResource ProgressBarStyle}"
                                                     Foreground="{Binding PressureBarBrush}"/>

                                        <!-- Usage Text -->
                                        <Grid Grid.Row="6">
                                            <TextBlock HorizontalAlignment="Left"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                                <Run Text="Used: "/><Run Text="{Binding UsedText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="11">
                                                <Run Text="Free: "/><Run Text="{Binding FreeText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Size + Pressure -->
                                        <Grid Grid.Row="8">
                                            <TextBlock Text="{Binding CapacityText, StringFormat='Total: {0}'}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                            <Border HorizontalAlignment="Right" CornerRadius="3" Padding="5,1" Background="#18FFFFFF">
                                                <TextBlock Text="{Binding StoragePressure, StringFormat='PRESSURE: {0}'}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding PressureBarBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 6: DEEP CLEAN (APPLICABLE-ONLY OPTIMIZATION ENGINE) -->
                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- Title & Actions -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><!-- Summary Metrics Strip -->
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/><!-- Category cards grid -->
                    </Grid.RowDefinitions>

                    <!-- Title & Header Actions -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DEEP CLEAN" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="All applicable cleanup optimizations detected for this PC."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedSummaryText}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="SCAN APPLICABILITY"
                                    Command="{Binding ScanDeepCleanCommand}" Margin="0,0,8,0" MinWidth="130" Height="32"/>
                            <Button Style="{StaticResource DangerButtonStyle}" Content="CANCEL"
                                    Command="{Binding CancelDeepCleanCommand}"
                                    Visibility="{Binding CanCancelDeepClean, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,8,0" MinWidth="75" Height="32"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding OptimizeAllApplicableButtonText}"
                                    Command="{Binding OptimizeAllApplicableCommand}"
                                    IsEnabled="{Binding CanOptimizeAllApplicable}"
                                    MinWidth="170" Height="32"/>
                        </WrapPanel>
                    </Grid>

                    <!-- Summary Metrics Strip (6 Indicators) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Checks -->
                        <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="TOTAL CHECKS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TotalChecksCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Supported -->
                        <Border Grid.Column="2" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="SUPPORTED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SupportedCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Applicable -->
                        <Border Grid.Column="4" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="APPLICABLE" FontSize="8.5" FontWeight="Bold" Foreground="#EF9A9A"/>
                                <TextBlock Text="{Binding ApplicableCount}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Already Clean -->
                        <Border Grid.Column="6" Background="#144CAF50" BorderBrush="#334CAF50" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="ALREADY CLEAN" FontSize="8.5" FontWeight="Bold" Foreground="#81C784"/>
                                <TextBlock Text="{Binding AlreadyCleanCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Not Applicable -->
                        <Border Grid.Column="8" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="NOT APPLICABLE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding NotApplicableCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Protected -->
                        <Border Grid.Column="10" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="PROTECTED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ProtectedCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Category cards grid (Responsive 3-Column Desktop Layout) -->
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Margin="0,4,0,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Padding="18,16"
                                        Margin="7,7,7,7" MinHeight="165">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5"
                                                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap" LineHeight="17" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>

                                        <!-- Applicability Status Strip -->
                                        <Border Grid.Row="4" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="5" Padding="10,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ApplicabilityBadgeText}" FontSize="10.5"
                                                           FontWeight="Bold" Foreground="{Binding ApplicabilityBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" CornerRadius="3" Padding="6,2" Background="#18FFFFFF">
                                                    <TextBlock Text="{Binding RiskLevel, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding RiskBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Size & Action Info -->
                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedSize}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileCount, StringFormat='{}{0:N0} files'}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 8: RECYCLE BIN -->
                <Border Grid.Row="8" Style="{StaticResource GlassCardStyle}" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="WINDOWS RECYCLE BIN" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Safely empty the Recycle Bin to immediately free up space."
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="🗑" FontSize="22" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SIZE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RecycleBinSizeText}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ITEMS" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RecycleBinCountText}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Button Grid.Row="4" Style="{StaticResource SecondaryButtonStyle}"
                                Content="EMPTY RECYCLE BIN" Command="{Binding EmptyRecycleBinCommand}"
                                HorizontalAlignment="Stretch" Height="36"/>
                    </Grid>
                </Border>

                <!-- 10: CLEANUP PROGRESS + RESULT -->
                <Border Grid.Row="10" Style="{StaticResource GlassCardStyle}" Padding="18,16"
                        Visibility="{Binding HasCleanupResult}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="CLEANUP PROGRESS" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding CleanupProgress}" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <ProgressBar Grid.Row="2" Value="{Binding CleanupProgressValue}" Maximum="100"
                                     Height="8" Style="{StaticResource ProgressBarStyle}"/>

                        <ScrollViewer Grid.Row="4" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource SlimScrollViewer}">
                            <TextBlock Text="{Binding CleanupResult}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                       TextWrapping="Wrap" LineHeight="19"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 12: FULL FILE EXPLORER ENTRY CARD -->
                <Border Grid.Row="12" Style="{StaticResource GlassCardStyle}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FULL FILE EXPLORER" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Search, inspect, and safely manage real files across all accessible local drives (up to 1 TB)."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,6"/>
                            <TextBlock Text="{Binding TotalFilesFoundText, StringFormat='Status: {0}'}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                Content="OPEN FILE EXPLORER"
                                Command="{Binding OpenFileExplorerWorkspaceCommand}"
                                MinWidth="180" Height="38" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- WORKSPACE 2: DEDICATED FULL FILE EXPLORER (RESPONSIVE VIEWPORT) -->
        <!-- ============================================================ -->
        <Grid Visibility="{Binding FileExplorerWorkspaceVisibility}" Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- 0: Workspace Header & Back Button -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/><!-- 2: Simple Scan Summary -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/><!-- 4: Clean Search Bar + Advanced Toggle -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/><!-- 6: Collapsible Advanced Search Panel -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/><!-- 8: Live Scan Progress (if active) -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/><!-- 10: Selection Action Toolbar -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/><!-- 12: Virtualized File List / Empty States (Flexible Remaining Viewport) -->
            </Grid.RowDefinitions>

                <!-- 0: Workspace Header with Back Button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                            Content="◄ BACK TO OVERVIEW"
                            Command="{Binding CloseFileExplorerWorkspaceCommand}"
                            MinWidth="160" Height="36" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="FULL FILE EXPLORER" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Search, inspect, and safely manage real files across all accessible local drives (up to 1 TB)."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="CANCEL SCAN"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanningFiles, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0" MinWidth="110" Height="36"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="SCAN FILES"
                                Command="{Binding ScanAllFilesCommand}"
                                Visibility="{Binding IsNotScanningFiles, Converter={StaticResource BoolToVis}}"
                                MinWidth="130" Height="36"/>
                    </WrapPanel>
                </Grid>

                <!-- 2: Simple Scan Summary Cards -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="FILESYSTEM SCAN SUMMARY" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Largest File: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LargestFileText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Row="2" Orientation="Horizontal">
                            <!-- All Files -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 ALL: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding TotalScannedSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding TotalFilesFoundText, StringFormat=' ({0})'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Videos -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎬 VIDEOS: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding VideosSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Images -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖼️ IMAGES: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ImagesSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Audio -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎵 AUDIO: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding AudioSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Documents -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 DOCS: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DocumentsSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Executables -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️ APPS: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ExecutablesSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Archives -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦 ARCHIVES: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ArchivesSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- ISO -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💿 ISO: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding IsoSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Projects -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💻 PROJECTS: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ProjectsSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Other -->
                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 OTHER: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding OtherSizeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 4: Clean Search Bar & Advanced Search Toggle -->
                <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38" VerticalContentAlignment="Center" Padding="12,0"
                                 FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"/>

                        <!-- Advanced Search Dropdown Toggle Button (Animated Glass Chevron) -->
                        <ToggleButton Grid.Column="2" Style="{StaticResource AdvancedSearchToggleButtonStyle}"
                                      IsChecked="{Binding IsAdvancedSearchOpen, Mode=TwoWay}"
                                      MinWidth="180" Height="38"/>
                    </Grid>
                </Border>

                <!-- 6: Collapsible Advanced Search Panel -->
                <Border Grid.Row="6" Style="{StaticResource GlassCardStyle}" Padding="16,14"
                        Visibility="{Binding AdvancedSearchVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Filters: Drive, Size, Sort -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Drive Filter -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DRIVE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedDriveFilter, Mode=TwoWay}"
                                          Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Size Preset Filter -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MINIMUM SIZE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableSizeFilters}" SelectedItem="{Binding SelectedSizeFilter, Mode=TwoWay}"
                                          Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Sort Option -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="SORT BY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableSortFilters}" SelectedItem="{Binding SelectedSortFilter, Mode=TwoWay}"
                                          Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom Filters: Quick Type Pills -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="QUICK TYPE FILTERS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="ALL" Command="{Binding SetCategoryFilterCommand}" CommandParameter="ALL" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="VIDEOS" Command="{Binding SetCategoryFilterCommand}" CommandParameter="VIDEOS" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="IMAGES" Command="{Binding SetCategoryFilterCommand}" CommandParameter="IMAGES" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="AUDIO" Command="{Binding SetCategoryFilterCommand}" CommandParameter="AUDIO" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="DOCS" Command="{Binding SetCategoryFilterCommand}" CommandParameter="DOCUMENTS" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="APPS" Command="{Binding SetCategoryFilterCommand}" CommandParameter="EXECUTABLES" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="ARCHIVES" Command="{Binding SetCategoryFilterCommand}" CommandParameter="ARCHIVES" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="ISO" Command="{Binding SetCategoryFilterCommand}" CommandParameter="ISO" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="PROJECTS" Command="{Binding SetCategoryFilterCommand}" CommandParameter="PROJECTS" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="OTHER" Command="{Binding SetCategoryFilterCommand}" CommandParameter="OTHER" Margin="0,0,6,6" Height="28" Padding="10,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 8: Live Scan Progress Card -->
                <Border Grid.Row="8" Style="{StaticResource GlassCardStyle}" Padding="16,12"
                        Visibility="{Binding IsScanningFiles, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding ScanStatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ElapsedTimeText, StringFormat='Elapsed: {0}'}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="{Binding CurrentScanningPath}" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- 10: Action Toolbar: Selection Summary & Actions -->
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selected Summary Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedFilesSummaryText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — User review required before deletion" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Selection & Delete Buttons: DELETE SELECTED (Primary Red Action) -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="SELECT ALL"
                                Command="{Binding SelectAllFilesCommand}" Margin="0,0,6,0" MinWidth="85" Height="32"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="SELECT FILTERED"
                                Command="{Binding SelectFilteredFilesCommand}" Margin="0,0,6,0" MinWidth="110" Height="32"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="DESELECT ALL"
                                Command="{Binding DeselectAllFilesCommand}" Margin="0,0,10,0" MinWidth="95" Height="32"/>
                        <Button Style="{StaticResource DangerButtonStyle}" Content="DELETE SELECTED"
                                Command="{Binding DeleteSelectedFilesCommand}" MinWidth="130" Height="32"
                                IsEnabled="{Binding HasSelectedFiles}"/>
                    </WrapPanel>
                </Grid>

                <!-- 12: Virtualized Results List & Clean Empty States -->
                <Border Grid.Row="12" Style="{StaticResource GlassCardStyle}" Padding="0" MinHeight="260">
                    <Grid>
                        <!-- Empty State 1: Before Scanning -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasNotScannedFiles, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No files scanned yet." FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Scan your drives to find large files and manage storage."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="SCAN FILES"
                                    Command="{Binding ScanAllFilesCommand}" HorizontalAlignment="Center" MinWidth="140" Height="36"/>
                        </StackPanel>

                        <!-- Empty State 2: No Matching Files after Filter/Scan -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                    Visibility="{Binding NoMatchingFilesVisibility}">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No files match the current filters." FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try changing your search keyword, drive filter, or size range."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Virtualized Rows -->
                        <Grid Visibility="{Binding HasScannedFiles, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column Headers (100% matched to row layout) -->
                            <Border Grid.Row="0" Padding="8,8" BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource DividerBrush}" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/><!-- Checkbox -->
                                        <ColumnDefinition Width="*"/><!-- Flexible File & Location -->
                                        <ColumnDefinition Width="72"/><!-- Size -->
                                        <ColumnDefinition Width="72"/><!-- Type -->
                                        <ColumnDefinition Width="120"/><!-- Safety (Ample room for SYSTEM/PROTECTED) -->
                                        <ColumnDefinition Width="90"/><!-- Modified -->
                                        <ColumnDefinition Width="95"/><!-- Actions -->
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="FILE &amp; LOCATION" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="SIZE" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="TYPE" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="SAFETY" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="MODIFIED" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Table Rows -->
                            <ListView Grid.Row="1" ItemsSource="{Binding FilteredFilesView}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      VirtualizingStackPanel.ScrollUnit="Pixel"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="2,2,2,4">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,3"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="ItemRowBorder"
                                                            Background="#08FFFFFF"
                                                            BorderBrush="#14FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="5"
                                                            Padding="8,5"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemRowBorder" Property="Background" Value="#1A18263D"/>
                                                            <Setter TargetName="ItemRowBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemRowBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter TargetName="ItemRowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Main Row Content (Auto height, zero clipping) -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/><!-- Checkbox -->
                                                    <ColumnDefinition Width="*"/><!-- Flexible File & Location -->
                                                    <ColumnDefinition Width="72"/><!-- Size -->
                                                    <ColumnDefinition Width="72"/><!-- Type -->
                                                    <ColumnDefinition Width="120"/><!-- Safety (Ample room for SYSTEM/PROTECTED) -->
                                                    <ColumnDefinition Width="90"/><!-- Modified -->
                                                    <ColumnDefinition Width="95"/><!-- Actions -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <!-- Line 1: [Icon] FileName  |  Line 2: FullPath (Ellipsized with complete ToolTip) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,1,8,1">
                                                    <!-- Line 1: Icon + FileName -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CategoryIcon}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <!-- Line 2: Full Path -->
                                                    <TextBlock Text="{Binding FullPath}" FontSize="8.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" Margin="0,1,0,0"/>
                                                </StackPanel>

                                                <!-- Size -->
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}"
                                                           FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Category -->
                                                <TextBlock Grid.Column="3" Text="{Binding FileTypeCategory}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                <!-- Safety Status (Ample width, NoWrap, vertical centering) -->
                                                <TextBlock Grid.Column="4" Text="{Binding SafetyStatus}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding SafetyBrush}" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,6,0"/>

                                                <!-- Modified Date -->
                                                <TextBlock Grid.Column="5" Text="{Binding FormattedDate}"
                                                           FontSize="8.5" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Premium Action Icons (Guaranteed 100% visible & centered) -->
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Inspect / Details -->
                                                    <Button Style="{StaticResource PremiumIconButton}"
                                                            Width="24" Height="24"
                                                            Command="{Binding ToggleDetailsCommand}"
                                                            Margin="0,0,3,0"
                                                            ToolTip="Inspect File Details &amp; Safety Reasoning">
                                                        <TextBlock Text="&#xE8FF;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Button>

                                                    <!-- Open Location in Explorer -->
                                                    <Button Style="{StaticResource PremiumIconButton}"
                                                            Width="24" Height="24"
                                                            Command="{Binding OpenLocationCommand}"
                                                            Margin="0,0,3,0"
                                                            ToolTip="Open Containing Folder in Windows Explorer">
                                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Button>

                                                    <!-- Delete Single File -->
                                                    <Button Style="{StaticResource PremiumDangerIconButton}"
                                                            Width="24" Height="24"
                                                            Command="{Binding DeleteSingleCommand}"
                                                            ToolTip="Delete this File (Review Required)">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Expandable Details Row -->
                                            <Border Grid.Row="1" Margin="34,4,0,2" Padding="8,5"
                                                    Background="#14000000" CornerRadius="4"
                                                    Visibility="{Binding DetailsVisibility}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="3"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="9.5" TextWrapping="Wrap">
                                                        <Run Text="Full Path: " FontWeight="Bold"/><Run Text="{Binding FullPath, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap">
                                                        <Run Text="Safety Reason: " FontWeight="Bold"/><Run Text="{Binding SafetyReason, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>

        <!-- ============================================================ -->
        <!-- SMART CLEAN IN-PAGE MODAL OVERLAY                            -->
        <!-- ============================================================ -->
        <Border Background="#A6000000" Visibility="{Binding SmartCleanModalVisibility}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource GlassCardStyle}" MaxWidth="720" MaxHeight="620" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- Title & Close -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><!-- Stats Bar -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/><!-- Categories List -->
                        <RowDefinition Height="Auto"/><!-- Progress / Logs -->
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/><!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="⚡ SMART CLEAN" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Quick cleanup of safe, applicable temporary &amp; cache data for THIS PC" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="✕" Width="28" Height="28"
                                Command="{Binding CloseSmartCleanModalCommand}" IsEnabled="{Binding CanCloseSmartCleanModal}"
                                ToolTip="Close Modal"/>
                    </Grid>

                    <!-- Stats Bar -->
                    <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="6" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SAFE REMOVABLE" FontSize="10" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="{Binding SmartCleanSafeText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="REVIEW / LOW RISK" FontSize="10" FontWeight="Bold" Foreground="#2196F3"/>
                                <TextBlock Text="{Binding SmartCleanReviewText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PROTECTED SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#9E9E9E"/>
                                <TextBlock Text="{Binding SmartCleanProtectedText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Category Toolbar: RESCAN, SELECT ALL SAFE, DESELECT ALL -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="RESCAN"
                                    Command="{Binding RescanSmartCleanCommand}" Margin="0,0,6,0" MinWidth="80" Height="26" FontSize="10.5"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="SELECT ALL SAFE"
                                    Command="{Binding SelectAllSafeSmartCleanCommand}" Margin="0,0,6,0" MinWidth="110" Height="26" FontSize="10.5"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="DESELECT ALL"
                                    Command="{Binding DeselectAllSmartCleanCommand}" MinWidth="95" Height="26" FontSize="10.5"/>
                        </WrapPanel>

                        <!-- Category Items List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                            <ItemsControl ItemsSource="{Binding SmartCleanRecommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                                CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsApplicable}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <!-- Name & Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- File Count -->
                                                <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat='{}{0:N0} files'}"
                                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Size -->
                                                <TextBlock Grid.Column="4" Text="{Binding FormattedSize}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Applicability / Verification Badge -->
                                                <Border Grid.Column="6" CornerRadius="3" Padding="6,3" Background="#14FFFFFF" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ApplicabilityState}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding ApplicabilityBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Live Progress & Activity Logs (When Cleaning) -->
                    <StackPanel Grid.Row="5" Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SmartCleanModalCurrentAction}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SmartCleanModalProgressText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <ProgressBar Height="4" Value="{Binding SmartCleanModalProgress}" Maximum="100" Background="#14FFFFFF" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                        <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                            <ItemsControl ItemsSource="{Binding SmartCleanModalLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="CLOSE"
                                Command="{Binding CloseSmartCleanModalCommand}" IsEnabled="{Binding CanCloseSmartCleanModal}" Height="36"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding SmartCleanButtonText}"
                                Command="{Binding ApplySmartCleanCommand}" IsEnabled="{Binding CanApplySmartClean}" Height="36"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ============================================================ -->
        <!-- DEEP CLEAN ADVANCED RESULT & PROGRESS MODAL OVERLAY           -->
        <!-- ============================================================ -->
        <Border Background="#80000000" Visibility="{Binding DeepCleanModalVisibility}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource GlassCardStyle}" MaxWidth="600" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- 0: Header with Icon & Title -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><!-- 2: Subtitle / Current Action -->
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/><!-- 4: Real Statistics Metrics Grid -->
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/><!-- 6: Progress Bar & Detailed Logs -->
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/><!-- 8: Close / Action Button -->
                    </Grid.RowDefinitions>

                    <!-- 0: Header with Icon & Title -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding DeepCleanResultIcon}" FontSize="18" FontWeight="Bold"
                                       Foreground="{Binding DeepCleanResultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeepCleanResultTitle}" FontSize="16" FontWeight="Bold"
                                       Foreground="{Binding DeepCleanResultBrush}"/>
                            <TextBlock Text="Authoritative filesystem-verified optimization results" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="3" CornerRadius="4" Padding="8,4" Background="#14FFFFFF" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeepCleanModalProgressText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>

                    <!-- 2: Current Action Status -->
                    <TextBlock Grid.Row="2" Text="{Binding DeepCleanModalCurrentAction}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                    <!-- 4: Real Statistics Metrics Grid (3x2 Grid) -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Attempted -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="ATTEMPTED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DeepCleanAttemptedCount}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Cleaned -->
                        <Border Grid.Row="0" Grid.Column="2" Background="#144CAF50" BorderBrush="#334CAF50" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="CLEANED" FontSize="8.5" FontWeight="Bold" Foreground="#81C784"/>
                                <TextBlock Text="{Binding DeepCleanCleanedCount}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Partial -->
                        <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="PARTIAL" FontSize="8.5" FontWeight="Bold" Foreground="#EF9A9A"/>
                                <TextBlock Text="{Binding DeepCleanPartialCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Skipped / In Use -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="SKIPPED (IN USE)" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DeepCleanSkippedCount, StringFormat='{}{0:N0} files'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Failed -->
                        <Border Grid.Row="2" Grid.Column="2" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="FAILED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DeepCleanFailedCount}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Verified Reclaimed Space -->
                        <Border Grid.Row="2" Grid.Column="4" Background="#184CAF50" BorderBrush="#404CAF50" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="VERIFIED RECLAIMED" FontSize="8.5" FontWeight="Bold" Foreground="#81C784"/>
                                <TextBlock Text="{Binding DeepCleanReclaimedBytesText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 6: Progress Bar & Detailed Logs -->
                    <StackPanel Grid.Row="6">
                        <ProgressBar Height="4" Value="{Binding DeepCleanModalProgress}" Maximum="100"
                                     Background="#14FFFFFF" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                        <Border Background="#10000000" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8">
                            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                                <ItemsControl ItemsSource="{Binding DeepCleanModalLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- 8: Close Button -->
                    <Button Grid.Row="8" Style="{StaticResource PrimaryButtonStyle}" Content="CLOSE"
                            Command="{Binding CloseDeepCleanModalCommand}" IsEnabled="{Binding CanCloseDeepCleanModal}"
                            HorizontalAlignment="Stretch" Height="36"/>
                </Grid>
            </Border>
        </Border>

        <!-- ============================================================ -->
        <!-- DELETION CONFIRMATION MODAL OVERLAY                          -->
        <!-- ============================================================ -->
        <Border Background="#80000000" Visibility="{Binding DeleteConfirmModalVisibility}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource GlassCardStyle}" MaxWidth="520" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- Title -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><!-- Message -->
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/><!-- Options -->
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/><!-- Actions -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding DeleteModalTitle}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <TextBlock Grid.Row="2" Text="{Binding DeleteModalMessage}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>

                    <!-- Options: Move to Recycle Bin vs Permanent Delete -->
                    <Border Grid.Row="4" Background="#14FFFFFF" CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <RadioButton Content="Move to Recycle Bin (Recommended — Safe &amp; Recoverable)"
                                         IsChecked="{Binding DeleteToRecycleBinSelected, Mode=TwoWay}"
                                         FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                         Margin="0,0,0,8"/>
                            <RadioButton Content="Permanently Delete (Irreversible)"
                                         IsChecked="{Binding PermanentDeleteSelected, Mode=TwoWay}"
                                         FontSize="12" Foreground="#FFFF6B6B"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons: CANCEL (Secondary) and CONFIRM & DELETE (Primary Red) -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="CANCEL"
                                Command="{Binding CancelDeleteModalCommand}" Height="36"/>
                        <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Content="CONFIRM &amp; DELETE"
                                Command="{Binding ConfirmDeleteModalCommand}" Height="36"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
