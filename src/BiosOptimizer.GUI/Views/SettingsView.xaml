<UserControl x:Class="BiosOptimizer.GUI.Views.SettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
              xmlns:vm="clr-namespace:BiosOptimizer.GUI.ViewModels"
              Background="Transparent"
              UseLayoutRounding="True" SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Display"
              TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <!-- Main Scrollable Settings Page -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource SlimScrollViewer}">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><!-- 0: Header -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 2: STARTUP & BACKGROUND -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 4: AI ENGINE STARTUP POLICIES -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 6: APPEARANCE -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 8: PERFORMANCE -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 10: SAFETY -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 12: LOGGING -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 14: ABOUT -->
                </Grid.RowDefinitions>

                <!-- ============================================================
                     1. HEADER
                     ============================================================ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavigationIcon Icon="Settings" IsActive="True" Size="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PREFERENCES &amp; SYSTEM SETTINGS" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Manage Windows startup registration, AI engine boot policies, appearance, safety guardrails, and audit logging."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Top-Right Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetToDefaultsCommand}" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RESET DEFAULTS" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================================================
                     2. STARTUP & BACKGROUND
                     ============================================================ -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="20,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="STARTUP &amp; BACKGROUND RUNTIME" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding RefreshStartupStatusCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="REFRESH STATUS" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Row 1: Start Error Optimizer with Windows -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Real Windows startup registration" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" Content="Start Error Optimizer with Windows Logon" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="StartWithWindows"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 2: Start Minimized -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Start Minimized" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Launch silently to background" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center" Content="Start Minimized (Background Runtime Only)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="StartMinimized"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 3: Live Startup Status Strip -->
                        <Border Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Windows Startup" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding WindowsStartupStatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Startup Bootstrap" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding StartupBootstrapStatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Last Startup" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LastStartupTimeDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     3. AI ENGINE STARTUP POLICIES
                     ============================================================ -->
                <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="AI ENGINE STARTUP POLICIES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>

                        <!-- Row 1: AI Power Plan Auto-Enable -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="AI Power Plan Auto-Enable" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Activate scheme on Windows logon" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding AiPowerPlanAutoEnable}" VerticalAlignment="Center" Content="Auto-Apply Configured AI Power Plan" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Border Grid.Column="2" HorizontalAlignment="Right" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AiPowerPlanStatusDisplay, StringFormat='{}State: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="AiPowerPlanAutoEnable"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 2: AI Workload Auto-Start -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="AI Workload Optimization" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Safe passive monitoring on boot" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding AiWorkloadAutoStart}" VerticalAlignment="Center" Content="Enable AI Workload Classifier on Startup" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Border Grid.Column="2" HorizontalAlignment="Right" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AiWorkloadStatusDisplay, StringFormat='{}State: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="AiWorkloadAutoStart"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 3: AI RAM Limiter Auto-Start -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="AI RAM Limiter" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Memory pressure monitor on boot" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding AiRamLimiterAutoStart}" VerticalAlignment="Center" Content="Enable RAM Limiter Monitor on Startup" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Border Grid.Column="2" HorizontalAlignment="Right" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AiRamStatusDisplay, StringFormat='{}State: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="AiRamLimiterAutoStart"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 4: Smart Auto Optimize Auto-Start -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Smart Auto Optimize" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Authoritative scheduler reconciliation" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding SmartAutoOptimizeAutoStart}" VerticalAlignment="Center" Content="Reconcile Auto Optimize Schedule on Startup" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Border Grid.Column="2" HorizontalAlignment="Right" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SmartAutoOptimizeStatusDisplay, StringFormat='{}State: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="SmartAutoOptimizeAutoStart"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     4. APPEARANCE & DUAL THEME ENGINE (SOLID + GRADIENT)
                     ============================================================ -->
                <Border Grid.Row="6" Style="{StaticResource GlassCardStyle}" Padding="20,18">
                    <StackPanel>
                        <!-- Header & Mode Selector Segmented Pill -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="APPEARANCE &amp; THEME ENGINE" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Select between Solid Single-Hue Family or Multi-Color Cinematic Gradient" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Premium 3D Theme Mode Segmented Selector -->
                            <Border Grid.Column="1" Background="#121520" BorderBrush="#2A3042" BorderThickness="1" CornerRadius="8" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <!-- SOLID MODE BUTTON -->
                                    <Button Command="{Binding SetThemeModeCommand}" CommandParameter="0"
                                            Padding="14,6" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Pill" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                                <TextBlock x:Name="Txt" Text="SOLID COLOR" FontSize="11" FontWeight="Bold" Foreground="#8E92A0"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsSolidThemeMode}" Value="True">
                                                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Pill" Property="Background" Value="#22283A"/>
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- GRADIENT MODE BUTTON -->
                                    <Button Command="{Binding SetThemeModeCommand}" CommandParameter="1"
                                            Padding="14,6" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="2,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Pill" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                                <TextBlock x:Name="Txt" Text="GRADIENT THEME" FontSize="11" FontWeight="Bold" Foreground="#8E92A0"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsGradientThemeMode}" Value="True">
                                                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Pill" Property="Background" Value="#22283A"/>
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,16"/>

                        <!-- ============================================================
                             MODE 1: SOLID COLOR THEME STUDIO (Visible in Solid Mode)
                             ============================================================ -->
                        <Grid Visibility="{Binding IsSolidThemeMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0">
                                <TextBlock Text="Solid Accent Studio" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Global brand &amp; 100% unified hue" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="Controls cards, Siri, buttons, cursor, halo, glow, and parallax tint." FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Color Studio Controls -->
                            <StackPanel Grid.Column="1">
                                <!-- Presets & Hex Row -->
                                <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding AccentPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="26" Height="26" Margin="0,0,6,4" Padding="0" Cursor="Hand"
                                                        Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderThickness="0">
                                                    <Grid>
                                                        <Ellipse Width="22" Height="22" Fill="{Binding ColorBrush}"/>
                                                        <Ellipse Width="26" Height="26" Stroke="#FFFFFF" StrokeThickness="2"
                                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Custom Hex Box -->
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,4" VerticalAlignment="Center">
                                        <Border Background="#18FFFFFF" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Height="26">
                                            <TextBox Text="{Binding CustomHexInput, UpdateSourceTrigger=PropertyChanged}" Width="72" Background="Transparent" 
                                                     BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Live Preview Swatch -->
                                        <Border Width="26" Height="26" Margin="6,0,0,0" CornerRadius="4" Background="{Binding CurrentColorBrush}" BorderBrush="#33FFFFFF" BorderThickness="1"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Manual HSV Precision Studio Panel -->
                                <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <!-- Hue Slider (Full Rainbow Track) -->
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Hue Spectrum" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding Hue, Mode=TwoWay}"
                                                    SmallChange="1" LargeChange="15" VerticalAlignment="Center">
                                                <Slider.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF0000" Offset="0.00"/>
                                                        <GradientStop Color="#FFFF00" Offset="0.17"/>
                                                        <GradientStop Color="#00FF00" Offset="0.33"/>
                                                        <GradientStop Color="#00FFFF" Offset="0.50"/>
                                                        <GradientStop Color="#0000FF" Offset="0.67"/>
                                                        <GradientStop Color="#FF00FF" Offset="0.83"/>
                                                        <GradientStop Color="#FF0000" Offset="1.00"/>
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                            <TextBlock Grid.Column="2" Text="{Binding HueDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Saturation Slider -->
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Saturation" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Saturation, Mode=TwoWay}"
                                                    SmallChange="1" LargeChange="10" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SaturationDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Brightness Slider -->
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Brightness" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="15" Maximum="100" Value="{Binding Brightness, Mode=TwoWay}"
                                                    SmallChange="1" LargeChange="10" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding BrightnessDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="AccentColor"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        </Grid>

                        <!-- ============================================================
                             MODE 2: MULTI-COLOR GRADIENT THEME STUDIO (Visible in Gradient Mode)
                             ============================================================ -->
                        <Grid Visibility="{Binding IsGradientThemeMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0">
                                <TextBlock Text="Gradient Theme Studio" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Multi-color atmospheric spectrum" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="Configures live gradient borders, Siri animation, buttons, parallax tint, and halo." FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <!-- Presets Row -->
                                <TextBlock Text="PRESET GRADIENTS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,14">
                                    <ItemsControl ItemsSource="{Binding GradientPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectGradientPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,6" Padding="10,5" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                        Style="{StaticResource SecondaryButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding PreviewBrush}" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <!-- Live Gradient Preview Bar -->
                                <TextBlock Text="LIVE GRADIENT PREVIEW" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <Border Height="28" CornerRadius="8" Background="{Binding GradientPreviewBrush}" BorderBrush="#33FFFFFF" BorderThickness="1.2" Margin="0,0,0,14" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Color Stops List Panel (2 to 5 Stops) -->
                                <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GRADIENT COLOR STOPS (2 - 5 COLORS)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="+ ADD COLOR STOP" Command="{Binding AddGradientStopCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="10" FontWeight="Bold"
                                                    Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding GradientStops}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="75"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding IndexLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="4" Background="{Binding ColorBrush}" BorderBrush="#FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>

                                                        <!-- Hex Box -->
                                                        <Border Grid.Column="2" Background="#18FFFFFF" BorderBrush="#2A3042" BorderThickness="1" CornerRadius="4" Padding="6,2" Height="26" VerticalAlignment="Center">
                                                            <TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                                                     Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Stop Position Slider -->
                                                        <Slider Grid.Column="4" Minimum="0" Maximum="100" Value="{Binding PercentValue, Mode=TwoWay}"
                                                                SmallChange="1" LargeChange="10" VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="5" Text="{Binding PercentDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                        <!-- Remove Stop Button -->
                                                        <Button Grid.Column="6" Content="✕" Command="{Binding RemoveCommand}"
                                                                IsEnabled="{Binding CanRemove}"
                                                                Style="{StaticResource SecondaryButtonStyle}" Width="22" Height="22" Padding="0"
                                                                FontSize="10" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Direction & Angle Panel -->
                                <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="GRADIENT DIRECTION &amp; ANGLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Content="LEFT → RIGHT" Command="{Binding SetGradientDirectionCommand}" CommandParameter="LeftToRight"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,4"/>
                                            <Button Content="TOP → BOTTOM" Command="{Binding SetGradientDirectionCommand}" CommandParameter="TopToBottom"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,4"/>
                                            <Button Content="DIAGONAL" Command="{Binding SetGradientDirectionCommand}" CommandParameter="Diagonal"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,4"/>
                                            <Button Content="DIAGONAL REV" Command="{Binding SetGradientDirectionCommand}" CommandParameter="DiagonalReverse"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,4"/>
                                            <Button Content="RADIAL" Command="{Binding SetGradientDirectionCommand}" CommandParameter="Radial"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,4"/>
                                        </WrapPanel>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Custom Angle" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding GradientAngle, Mode=TwoWay}"
                                                    SmallChange="1" LargeChange="15" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding GradientAngleDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Siri Focal Point Color Selection Panel -->
                                <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Siri Focal Color" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Center point solid anchor" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="AUTO" Command="{Binding SetSiriFocalColorCommand}" CommandParameter="Auto"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <Button Content="COLOR 1" Command="{Binding SetSiriFocalColorCommand}" CommandParameter="Color 1"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <Button Content="COLOR 2" Command="{Binding SetSiriFocalColorCommand}" CommandParameter="Color 2"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <Button Content="COLOR 3" Command="{Binding SetSiriFocalColorCommand}" CommandParameter="Color 3"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <Button Content="CUSTOM" Command="{Binding SetSiriFocalColorCommand}" CommandParameter="Custom"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <!-- Animation Mode Panel -->
                                <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Gradient Animation" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Slow atmospheric motion" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="OFF" Command="{Binding SetGradientAnimationModeCommand}" CommandParameter="0"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <Button Content="SUBTLE (SLOW)" Command="{Binding SetGradientAnimationModeCommand}" CommandParameter="1"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" FontSize="10" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <Button Content="DYNAMIC" Command="{Binding SetGradientAnimationModeCommand}" CommandParameter="2"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" FontSize="10" FontWeight="Bold"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="AccentColor"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        </Grid>

                        <Border Height="1" Background="#0DFFFFFF" Margin="0,0,0,14"/>

                        <!-- Row 2: Window Glass Transparency Slider -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Window Glass Transparency" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Controls how much of the window behind Error Optimizer is visible." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Slider Grid.Column="1" Value="{Binding WindowGlassTransparencyPercentValue, Mode=TwoWay}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding WindowGlassTransparencyPercent}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="WindowGlass"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#0DFFFFFF" Margin="0,0,0,14"/>

                        <!-- Row 3: Card / Panel Opacity Slider -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Card / Panel Opacity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Controls the opacity of internal Error Optimizer cards and panels." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Slider Grid.Column="1" Value="{Binding CardOpacityPercentValue, Mode=TwoWay}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding CardOpacityPercent}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="CardOpacity"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#0DFFFFFF" Margin="0,0,0,14"/>

                        <!-- Row 3: Animations & Transitions Toggles -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="UI Animations" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Interactive scale &amp; translation storyboards" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding AnimationsEnabled}" VerticalAlignment="Center" Content="Enable Animations" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="Animations"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 4: Page Transitions -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Page Transitions" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Smooth fade animations between routes" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding TransitionsEnabled}" VerticalAlignment="Center" Content="Enable Page Transitions" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="PageTransitions"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 5: Reduced Motion -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Reduced Motion" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Accessibility — suppresses rapid motion" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding ReducedMotion}" VerticalAlignment="Center" Content="Enable Reduced Motion" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="ReducedMotion"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 6: Accent Glow & 3D Depth -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Accent Glow &amp; Depth" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Ambient illumination &amp; 3D card tilt" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding GlowEnabled}" Content="Ambient Glow" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,20,0"/>
                                <CheckBox IsChecked="{Binding ThreeDEffect}" Content="3D Card Depth" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="AccentGlow"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#0DFFFFFF" Margin="0,4,0,14"/>

                        <!-- ── Animation Speed ─────────────────────────────────── -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Animation Speed" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Duration multiplier for all transitions" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Slider Grid.Column="1" Value="{Binding AnimationSpeed}" Minimum="0.25" Maximum="2.0"
                                    SmallChange="0.25" LargeChange="0.5"
                                    VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding AnimationSpeedLabel}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="AnimationSpeed"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ── Glow Intensity ──────────────────────────────────── -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Glow Intensity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Alpha intensity of ambient accent glow" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Slider Grid.Column="1" Value="{Binding GlowIntensity}" Minimum="0.0" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.2"
                                    VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding GlowIntensityPercent}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="GlowIntensity"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ── Blur Intensity ──────────────────────────────────── -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Blur Intensity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Backdrop blur radius on cards &amp; panels" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Slider Grid.Column="1" Value="{Binding BlurIntensity}" Minimum="0.0" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.2"
                                    VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding BlurIntensityPercent}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="BlurIntensity"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ── Particle Density ───────────────────────────────── -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Particle Density" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Background &amp; intelligence orb particles" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Slider Grid.Row="0" Value="{Binding ParticleDensity}" Minimum="0" Maximum="200"
                                        SmallChange="10" LargeChange="25" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="OFF" Command="{Binding SetParticleDensityCommand}" CommandParameter="0"
                                            Style="{StaticResource CategoryPillStyle}" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                    <Button Content="LOW (30)" Command="{Binding SetParticleDensityCommand}" CommandParameter="30"
                                            Style="{StaticResource CategoryPillStyle}" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                    <Button Content="MED (80)" Command="{Binding SetParticleDensityCommand}" CommandParameter="80"
                                            Style="{StaticResource CategoryPillStyle}" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                    <Button Content="HIGH (150)" Command="{Binding SetParticleDensityCommand}" CommandParameter="150"
                                            Style="{StaticResource CategoryPillStyle}" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Column="2" Text="{Binding ParticleDensityLabel}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="ParticleIntensity"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ── Background Motion Mode ──────────────────────────── -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Background Motion Mode" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Ambient gradient drift &amp; light sweep" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="STATIC" Command="{Binding SetBackgroundModeCommand}" CommandParameter="0"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="SUBTLE" Command="{Binding SetBackgroundModeCommand}" CommandParameter="1"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="DYNAMIC" Command="{Binding SetBackgroundModeCommand}" CommandParameter="2"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,10,0" Padding="10,4"/>

                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="{Binding BackgroundModeLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="BackgroundMode"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ── 3D Spatial Depth Mode ────────────────────────── -->
                        <Grid Margin="0,0,0,14" Visibility="{Binding Capabilities.Supports3DDepth, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="3D Spatial Depth" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Card hover tilt, bevel &amp; Z-elevation" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="LOW (2D)" Command="{Binding SetThreeDDepthModeCommand}" CommandParameter="0"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="MEDIUM (3D)" Command="{Binding SetThreeDDepthModeCommand}" CommandParameter="1"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="HIGH (DEEP)" Command="{Binding SetThreeDDepthModeCommand}" CommandParameter="2"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,10,0" Padding="10,4"/>

                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="{Binding ThreeDDepthModeLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                     Command="{Binding OpenSettingDetailsCommand}" CommandParameter="ThreeDDepth"
                                     Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ── 3D Scene & Lighting Intensity ───────────────────── -->
                        <Grid Margin="0,0,0,14" Visibility="{Binding Capabilities.Supports3DDepth, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="3D Scene Intensity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Spotlight tracking &amp; crystal lighting" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Slider Grid.Column="1" Value="{Binding ThreeDSceneIntensity}" Minimum="0.0" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.2"
                                    VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding ThreeDSceneIntensityPercent}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="ThreeDSceneIntensity"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        
                        <!-- ── Parallax Star Background (Continuous 3D Space Engine) ── -->
                        <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,4,0,16"
                                Visibility="{Binding Capabilities.SupportsParallax, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Header & Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="PARALLAX STAR BACKGROUND" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="3-layer deep space parallax starfield with interactive mouse tracking &amp; dynamic theme tint" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ParallaxBackground}" Content="Parallax Background Active"
                                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#0AFFFFFF" Margin="0,0,0,10"/>

                                <!-- Controls Grid: 2 Columns -->
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <!-- Left Column: Star Density, Star Opacity, Parallax Strength, Star Speed -->
                                    <StackPanel Margin="0,0,12,0">
                                        <!-- Star Density -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Star Density" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="LOW" Command="{Binding SetStarDensityCommand}" CommandParameter="0"
                                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                                <Button Content="MEDIUM" Command="{Binding SetStarDensityCommand}" CommandParameter="1"
                                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                                <Button Content="HIGH" Command="{Binding SetStarDensityCommand}" CommandParameter="2"
                                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,8,0" Padding="6,2" FontSize="9"/>
                                                <TextBlock Text="{Binding StarDensityLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Star Opacity -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Star Opacity" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Value="{Binding StarOpacityPercentValue, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                    SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StarOpacityPercent}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Parallax Strength -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Parallax Strength" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Value="{Binding ParallaxStrengthPercentValue, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                    SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ParallaxStrengthPercent}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Star Speed -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Star Speed" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Value="{Binding StarSpeed}" Minimum="0.0" Maximum="2.0"
                                                    SmallChange="0.1" LargeChange="0.25" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StarSpeedLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Right Column: Star Glow, Depth, Twinkle -->
                                    <StackPanel Margin="12,0,0,0">
                                        <!-- Star Glow -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Star Glow" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Value="{Binding StarGlowPercentValue, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                    SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StarGlowPercent}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Depth Mode -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Depth" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="LOW" Command="{Binding SetStarDepthCommand}" CommandParameter="0"
                                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                                <Button Content="MEDIUM" Command="{Binding SetStarDepthCommand}" CommandParameter="1"
                                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,4,0" Padding="6,2" FontSize="9"/>
                                                <Button Content="HIGH" Command="{Binding SetStarDepthCommand}" CommandParameter="2"
                                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,8,0" Padding="6,2" FontSize="9"/>
                                                <TextBlock Text="{Binding StarDepthLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Twinkle Toggle -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Twinkle" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding StarTwinkle}" Content="Enable Star Twinkle"
                                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- ── Motion Toggles ──────────────────────────────────── -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Motion Toggles" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Cursor effects, hover halo &amp; parallax" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding CursorEffects}" Content="Cursor Effects"
                                          Visibility="{Binding Capabilities.SupportsCursorEffects, Converter={StaticResource BoolToVis}}"
                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding CursorTrail}" Content="Cursor Trail"
                                          Visibility="{Binding Capabilities.SupportsCursorTrail, Converter={StaticResource BoolToVis}}"
                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding HoverEffectsEnabled}" Content="Hover Effects"
                                          Visibility="{Binding Capabilities.SupportsHoverEffects, Converter={StaticResource BoolToVis}}"
                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding CardDepthEnabled}" Content="3D Depth"
                                          Visibility="{Binding Capabilities.Supports3DDepth, Converter={StaticResource BoolToVis}}"
                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding CardProximityGlow}" Content="Proximity Glow"
                                          Visibility="{Binding Capabilities.SupportsProximityGlow, Converter={StaticResource BoolToVis}}"
                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding TextProximityGlow}" Content="Text Proximity"
                                          Visibility="{Binding Capabilities.SupportsTextProximity, Converter={StaticResource BoolToVis}}"
                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="MotionToggles"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="#0DFFFFFF" Margin="0,8,0,14"/>

                        <!-- ── HALO CURSOR SIZE & GLOW INTENSITY CONTROLS ── -->
                        <Border Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="HALO CURSOR DYNAMICS &amp; LUMINESCENCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Real-time control over custom cursor halo diameter, outer bloom radius, and glow emission intensity." FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="REAL-TIME D2D" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#0AFFFFFF" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="HALO CURSOR SIZE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Diameter &amp; ambient halo radius" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Slider Grid.Column="1" Value="{Binding CursorHaloSizePercentValue, Mode=TwoWay}"
                                            Minimum="10" Maximum="200" SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <TextBlock Grid.Column="2" Text="{Binding CursorHaloSizePercent}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="HALO GLOW INTENSITY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Luminance alpha &amp; bloom power" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Slider Grid.Column="1" Value="{Binding CursorGlowIntensityPercentValue, Mode=TwoWay}"
                                            Minimum="20" Maximum="150" SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <TextBlock Grid.Column="2" Text="{Binding CursorGlowIntensityPercent}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                
                    <!-- ============================================================
                     5. PERFORMANCE & TELEMETRY
                     ============================================================ -->
                <Border Grid.Row="8" Style="{StaticResource GlassCardStyle}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE &amp; TELEMETRY ENGINE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>

                        <!-- Row 1: Adaptive Performance Mode -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="System Performance Mode" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Adaptive resource consumption budget" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Mode Pills -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="AUTO" Command="{Binding SetPerformanceModeCommand}" CommandParameter="AUTO (RECOMMENDED)"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="LOW RESOURCE (SMOOTH)" Command="{Binding SetPerformanceModeCommand}" CommandParameter="LOW RESOURCE (SMOOTH)"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="BALANCED" Command="{Binding SetPerformanceModeCommand}" CommandParameter="BALANCED"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="HIGH TELEMETRY" Command="{Binding SetPerformanceModeCommand}" CommandParameter="HIGH TELEMETRY"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,10,0" Padding="10,4"/>

                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="{Binding SelectedPerformanceMode}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="PerformanceMode"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 2: Monitor Update Interval -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Monitor Update Interval" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Live hardware metric polling rate" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Interval Pills -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="1s (Fast)" Command="{Binding SetMonitorIntervalCommand}" CommandParameter="1"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="2s" Command="{Binding SetMonitorIntervalCommand}" CommandParameter="2"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="3s (Default)" Command="{Binding SetMonitorIntervalCommand}" CommandParameter="3"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="5s" Command="{Binding SetMonitorIntervalCommand}" CommandParameter="5"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="10s (Eco)" Command="{Binding SetMonitorIntervalCommand}" CommandParameter="10"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,10,0" Padding="10,4"/>

                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="{Binding SelectedMonitorInterval, StringFormat='{}Active: {0}s'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="MonitorInterval"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     6. SAFETY GUARDRAILS
                     ============================================================ -->
                <Border Grid.Row="10" Style="{StaticResource GlassCardStyle}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="SAFETY GUARDRAILS &amp; TRANSACTIONAL RECOVERY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>

                        <!-- Row 1: Medium Risk Confirmation -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Confirm Medium Risk" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Prompt before moderate system changes" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding ConfirmMediumRisk}" VerticalAlignment="Center" Content="Require Confirmation for Medium-Risk Actions" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="ConfirmMediumRisk"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 2: High Risk Confirmation -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Confirm High Risk" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Enforce dialogs on sensitive parameters" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding ConfirmHighRisk}" VerticalAlignment="Center" Content="Enforce Strict High-Risk Confirmation (Recommended)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="ConfirmHighRisk"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 3: Auto Backup -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Automatic Transactional Backup" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Pre-execution registry &amp; service snapshots" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoBackup}" VerticalAlignment="Center" Content="Automatic Pre-Execution State Snapshots" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="AutoBackup"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     7. AUDIT LOGGING & RETENTION
                     ============================================================ -->
                <Border Grid.Row="12" Style="{StaticResource GlassCardStyle}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="AUDIT LOGGING &amp; LOG RETENTION" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>

                        <!-- Row 1: Detailed Logs -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Detailed Execution Logs" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Record verbose API return codes &amp; traces" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" IsChecked="{Binding DetailedLogs}" VerticalAlignment="Center" Content="Capture Verbose Execution Diagnostics" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="DetailedLogs"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 2: Log Retention -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Log Retention Period" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Automatic cleanup of older transaction logs" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="3 Days" Command="{Binding SetLogRetentionCommand}" CommandParameter="3"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="7 Days (Default)" Command="{Binding SetLogRetentionCommand}" CommandParameter="7"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="14 Days" Command="{Binding SetLogRetentionCommand}" CommandParameter="14"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0" Padding="10,4"/>
                                <Button Content="30 Days" Command="{Binding SetLogRetentionCommand}" CommandParameter="30"
                                        Style="{StaticResource CategoryPillStyle}" Margin="0,0,10,0" Padding="10,4"/>

                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="{Binding SelectedLogRetentionDays, StringFormat='{}Active: {0} Days'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                    Command="{Binding OpenSettingDetailsCommand}" CommandParameter="LogRetention"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     8. ABOUT & SPECIFICATIONS
                     ============================================================ -->
                <Border Grid.Row="14" Style="{StaticResource GlassCardStyle}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="SYSTEM SPECIFICATIONS &amp; VERSION" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Version" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding AppVersion}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Build Identifier" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding BuildId}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Optimization Architecture" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Unified Safe IPC Service" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================
             DETAILS DRAWER / MODAL POPUP
             ============================================================ -->
        <Grid Visibility="{Binding IsSettingDetailsOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000">
            <Border Width="560" MaxHeight="600" Style="{StaticResource GlassCardStyle}" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FA0D0E12" BorderBrush="{DynamicResource AccentBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><!-- Title & Close -->
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/><!-- Body -->
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/><!-- Close Button -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SettingDetailTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="✕" Style="{StaticResource TextButtonStyle}" Command="{Binding CloseSettingDetailsCommand}" FontSize="14"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                        <StackPanel>
                            <TextBlock Text="FUNCTIONAL PURPOSE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SettingDetailDescription}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                            <TextBlock Text="RUNTIME BEHAVIOR &amp; ARCHITECTURE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBlock Text="{Binding SettingDetailTechnical}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="4" Content="CLOSE" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CloseSettingDetailsCommand}" HorizontalAlignment="Right" Width="100"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
