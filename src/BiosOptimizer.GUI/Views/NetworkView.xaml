<UserControl x:Class="BiosOptimizer.GUI.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Filter Chip Style for RadioButton -->
        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Mini Button -->
        <Style x:Key="ActionMiniButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start / Optimize Mini Button -->
        <Style x:Key="StartMiniButton" TargetType="Button" BasedOn="{StaticResource ActionMiniButton}">
            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3310B981"/>
                    <Setter Property="Foreground" Value="#6EE7B7"/>
                    <Setter Property="BorderBrush" Value="#6610B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Common Optimize All Button Style -->
        <Style x:Key="OptimizeAllButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch">
        <!-- MAIN SCROLLABLE CONTENT -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Style="{StaticResource SlimScrollViewer}">
            <Grid Margin="20,16,20,24" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Live Overview (Active Adapter, Diagnostics, Throughput & DNS) -->
                    <RowDefinition Height="Auto"/> <!-- 2: Summary Metrics Strip -->
                    <RowDefinition Height="Auto"/> <!-- 3: Filter Toolbar -->
                    <RowDefinition Height="Auto"/> <!-- 4: Dedicated Common Optimize Action Bar -->
                    <RowDefinition Height="*"/>    <!-- 5: Optimization Cards List -->
                </Grid.RowDefinitions>

                <!-- 0: TOP HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Network Boost" Style="{StaticResource PageTitleStyle}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Border Background="#1A10B981" BorderBrush="{Binding PageStatusColor}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding PageStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PageStatus, StringFormat='CONFIG: {0}'}" Foreground="{Binding PageStatusColor}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A3B82F6" BorderBrush="{Binding NetworkHealthBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding NetworkHealthBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NetworkHealthText, StringFormat='HEALTH: {0}'}" Foreground="{Binding NetworkHealthBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="Analyze and optimize the Windows network stack for lower latency and stable connectivity."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="⚡ RUN NETWORK TEST"
                                Command="{Binding RunDiagnosticsCommand}"
                                IsEnabled="{Binding IsNotScanning}"
                                Margin="0,0,8,4"
                                Padding="12,7"/>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="↺ RESTORE BACKUP"
                                Command="{Binding RestoreBackupCommand}"
                                IsEnabled="{Binding IsNotScanning}"
                                Margin="0,0,8,4"
                                Padding="12,7"/>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="↻ REFRESH"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsNotScanning}"
                                Margin="0,0,0,4"
                                Padding="12,7"/>
                    </WrapPanel>
                </Grid>

                <!-- 1: LIVE OVERVIEW (Active Adapter, Diagnostics, Throughput & DNS) -->
                <Grid Grid.Row="1" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1: ACTIVE NETWORK INTERFACE (Clearly Labeled LINK SPEED) -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding ActiveConnectionIcon}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ACTIVE NETWORK INTERFACE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="{Binding ActiveAdapterName}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ActiveConnectionType}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text=" • Status: " Foreground="#4B5563"/>
                                    <TextBlock Text="{Binding ActiveStatus}" FontSize="11" Foreground="{Binding ActiveStatusBrush}" FontWeight="Bold"/>
                                </WrapPanel>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Link Speed clearly labeled -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,6">
                                    <TextBlock Text="LINK SPEED (RATE)" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding ActiveLinkSpeed}" FontSize="11" FontWeight="Bold" Foreground="#10B981" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                    <TextBlock Text="GATEWAY" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding ActiveGateway}" FontSize="11" FontFamily="Consolas" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,6">
                                    <TextBlock Text="IPv4 ADDRESS" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding ActiveIpv4}" FontSize="11" FontFamily="Consolas" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                    <TextBlock Text="MTU" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding ActiveMtu}" FontSize="11" FontFamily="Consolas" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                    <TextBlock Text="DNS SERVERS" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding ActiveDns}" FontSize="11" FontFamily="Consolas" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 2: LIVE HEALTH & DIAGNOSTICS -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="NETWORK HEALTH &amp; DIAGNOSTICS" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LastTestedText}" FontSize="10" Foreground="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 4 Diagnostic Metric Tiles -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Latency -->
                                <Border Grid.Column="0" Background="#0AFFFFFF" CornerRadius="6" Padding="6,5" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="LATENCY" FontSize="8" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LatencyText}" FontSize="13" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- Jitter -->
                                <Border Grid.Column="1" Background="#0AFFFFFF" CornerRadius="6" Padding="6,5" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="JITTER" FontSize="8" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding JitterText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- Packet Loss -->
                                <Border Grid.Column="2" Background="#0AFFFFFF" CornerRadius="6" Padding="6,5" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="LOSS" FontSize="8" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding PacketLossText}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- DNS Resolution -->
                                <Border Grid.Column="3" Background="#0AFFFFFF" CornerRadius="6" Padding="6,5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DNS TIME" FontSize="8" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DnsResolutionText}" FontSize="13" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Text="Gateway: " FontSize="10" Foreground="#9CA3AF"/>
                                <TextBlock Text="{Binding GatewayPingText}" FontSize="10" FontWeight="SemiBold" Foreground="#E5E7EB" Margin="0,0,10,0"/>
                                <TextBlock Text="Internet: " FontSize="10" Foreground="#9CA3AF"/>
                                <TextBlock Text="{Binding InternetPingText}" FontSize="10" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- CARD 3: REAL INTERNET THROUGHPUT & DNS FLUSH -->
                    <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="INTERNET THROUGHPUT" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Throughput Display -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#0AFFFFFF" CornerRadius="6" Padding="6,5" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DOWNLOAD" FontSize="8" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadThroughputText}" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#0AFFFFFF" CornerRadius="6" Padding="6,5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="UPLOAD" FontSize="8" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding UploadThroughputText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding LastDnsFlushText}" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <Button Grid.Row="3"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="🚀 FLUSH DNS CACHE"
                                    Command="{Binding FlushDnsCommand}"
                                    IsEnabled="{Binding IsNotScanning}"
                                    HorizontalAlignment="Stretch"
                                    Padding="10,6"
                                    Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2: SUMMARY METRICS STRIP -->
                <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                    <!-- Total -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding TotalOptimizations}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Supported -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="SUPPORTED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding SupportedCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Applicable -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="APPLICABLE" FontSize="9" FontWeight="Bold" Foreground="#A78BFA"/>
                            <TextBlock Text="{Binding ApplicableCount}" FontSize="18" FontWeight="Bold" Foreground="#A78BFA" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Pending -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="PENDING" FontSize="9" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding PendingCount}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Optimized -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="OPTIMIZED" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding OptimizedCount}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Not Applicable -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="NOT APPLICABLE" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Text="{Binding NotApplicableCount}" FontSize="18" FontWeight="Bold" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 3: FILTER TOOLBAR -->
                <Grid Grid.Row="3" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Height="34" Width="220" HorizontalAlignment="Left" Padding="8,0" Margin="0,0,12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#9CA3AF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     FontSize="12"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Filter Chips -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="ALL" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="ALL" IsChecked="True"/>
                        <RadioButton Content="TCP/IP" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="TCP/IP"/>
                        <RadioButton Content="MMCSS" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="MMCSS"/>
                        <RadioButton Content="HARDWARE" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="HARDWARE"/>
                        <RadioButton Content="PENDING" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="PENDING"/>
                        <RadioButton Content="OPTIMIZED" Style="{StaticResource FilterChipStyle}" Command="{Binding SetFilterCommand}" CommandParameter="OPTIMIZED"/>
                    </WrapPanel>
                </Grid>

                <!-- 4: DEDICATED COMMON OPTIMIZE ACTION BAR -->
                <Border Grid.Row="4" Margin="0,0,0,16" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="BATCH SYSTEM NETWORK OPTIMIZATION" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Executes, backs up, applies, and readback-verifies all currently pending applicable network optimizations." FontSize="10" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource OptimizeAllButtonStyle}"
                                Content="{Binding OptimizeAllButtonText}"
                                Command="{Binding OptimizeAllCommand}"
                                IsEnabled="{Binding CanOptimizeAll}"
                                Padding="20,9"
                                FontSize="12"
                                FontWeight="Bold"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 5: PERSISTENT NETWORK OPTIMIZATIONS & ONE-TIME NETWORK ACTIONS -->
                <StackPanel Grid.Row="5" HorizontalAlignment="Stretch">
                    <!-- Persistent Optimizations Header -->
                    <TextBlock Text="PERSISTENT NETWORK OPTIMIZATION TARGETS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>

                    <!-- Optimization Cards List (Exact 6-Column Responsive Grid per Card) -->
                    <ItemsControl ItemsSource="{Binding VisibleActions}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10" Padding="14,12" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Main Row -->
                                        <RowDefinition Height="Auto"/> <!-- Expandable Details Accordion -->
                                    </Grid.RowDefinitions>

                                    <!-- Main Row: Responsive 6-Column Grid -->
                                    <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Col 0: Icon (Auto) -->
                                            <ColumnDefinition Width="*"/>    <!-- Col 1: Optimization Information (*) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Col 2: Current / Target (Auto) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Col 3: Status (Auto) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Col 4: Action (Auto) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Col 5: Details (Auto) -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 0: Category Glyph Icon -->
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                CornerRadius="18"
                                                Background="#0DFFFFFF"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding CategoryGlyph}"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Col 1: Optimization Information (The ONLY * flexible column) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#FFFFFF"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Category, StringFormat=' • {0}'}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"/>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#9CA3AF"
                                                       FontSize="11"
                                                       Margin="0,2,0,5"
                                                       TextWrapping="Wrap"/>

                                            <!-- Metadata Tag Badges -->
                                            <WrapPanel Orientation="Horizontal">
                                                <!-- Recommendation Badge -->
                                                <Border Background="#0DFFFFFF" BorderBrush="{Binding RecommendationColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding Recommendation}" Foreground="{Binding RecommendationColor}" FontSize="9" FontWeight="Bold"/>
                                                </Border>

                                                <!-- Risk Badge -->
                                                <Border Background="#0DFFFFFF" BorderBrush="{Binding RiskColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding Risk, StringFormat='RISK: {0}'}" Foreground="{Binding RiskColor}" FontSize="9" FontWeight="Bold"/>
                                                </Border>

                                                <!-- Scope Badge -->
                                                <Border Background="#0DFFFFFF" BorderBrush="#2060A5FA" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding Scope}" Foreground="#93C5FD" FontSize="9"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Col 2: Current / Target (Auto) -->
                                        <Border Grid.Column="2"
                                                Background="#0AFFFFFF"
                                                BorderBrush="#14FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="CURRENT" FontSize="8" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding CurrentValue}" FontSize="11" FontWeight="SemiBold" Foreground="#E5E7EB" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="➔" FontSize="11" Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="TARGET" FontSize="8" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding TargetValue}" FontSize="11" FontWeight="Bold" Foreground="#10B981" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Col 3: Status (Auto) -->
                                        <Border Grid.Column="3"
                                                Background="{Binding StatusBadgeBackground}"
                                                BorderBrush="{Binding StatusColor}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,5"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Col 4: Action Button (Auto) -->
                                        <Button Grid.Column="4"
                                                Style="{StaticResource StartMiniButton}"
                                                Content="{Binding ActionButtonText}"
                                                Command="{Binding ApplyCommand}"
                                                IsEnabled="{Binding IsActionButtonEnabled}"
                                                Visibility="{Binding IsActionButtonVisible, Converter={StaticResource BoolToVis}}"
                                                MinWidth="95"
                                                Margin="0,0,6,0"
                                                Padding="10,5"
                                                VerticalAlignment="Center"/>

                                        <!-- Col 5: Details Toggle (Auto) -->
                                        <Button Grid.Column="5"
                                                Style="{StaticResource ActionMiniButton}"
                                                Command="{Binding ToggleDetailsCommand}"
                                                MinWidth="75"
                                                Padding="8,5"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DetailsToggleText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- Expandable Details Accordion -->
                                    <Border Grid.Row="1"
                                            Background="#08FFFFFF"
                                            BorderBrush="#14FFFFFF"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,10,0,0"
                                            Padding="10,10,10,2"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                            HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Row 0: Recommendation Rationale Banner -->
                                                <RowDefinition Height="Auto"/> <!-- Row 1: Technical Verification Grid -->
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Recommendation Rationale Banner -->
                                            <Border Grid.Row="0"
                                                    Background="#0DFFFFFF"
                                                    BorderBrush="{Binding RecommendationColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="RECOMMENDATION RATIONALE" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF"/>
                                                            <TextBlock Text="{Binding Risk, StringFormat=' • RISK: {0}'}" FontSize="9" FontWeight="Bold" Foreground="{Binding RiskColor}"/>
                                                            <TextBlock Text="{Binding Scope, StringFormat=' • SCOPE: {0}'}" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RecommendationReason}"
                                                                   FontSize="11"
                                                                   Foreground="#FFFFFF"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,2,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Row 1: Technical Verification Grid -->
                                            <Grid Grid.Row="1" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Verification Method & ID -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="VERIFICATION METHOD" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding VerificationMethod}" FontSize="11" FontFamily="Consolas" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,2,0,6"/>

                                                    <TextBlock Text="OPTIMIZATION ID" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding Id}" FontSize="11" FontFamily="Consolas" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Execution Attributes -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="ADMIN PRIVILEGES" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <TextBlock Text="Required (Elevated Service Execution)" FontSize="11" Foreground="#E5E7EB" Margin="0,2,0,6"/>

                                                    <TextBlock Text="RESTART REQUIRED" FontSize="9" FontWeight="Bold" Foreground="#6B7280"/>
                                                    <Border Background="#0DFFFFFF" BorderBrush="{Binding RequiresRestartBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding RequiresRestartText}" Foreground="{Binding RequiresRestartBrush}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ONE-TIME NETWORK ACTIONS SECTION -->
                    <TextBlock Text="ONE-TIME NETWORK ACTIONS &amp; MAINTENANCE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,16,0,10"/>

                    <Border Style="{StaticResource GlassCardStyle}" Padding="14,12" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Col 0: Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Col 1: Description -->
                                <ColumnDefinition Width="Auto"/> <!-- Col 2: Timestamp / Status -->
                                <ColumnDefinition Width="Auto"/> <!-- Col 3: Action Button -->
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Icon -->
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <TextBlock Text="🚀" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Col 1: Description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DNS Resolver Cache Flush" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text=" • Maintenance Action" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </WrapPanel>
                                <TextBlock Text="Flushes and purges the Windows DNS client resolver cache to resolve domain resolution conflicts, outdated IP entries, and DNS staleness."
                                           Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Col 2: Status & Last Executed -->
                            <Border Grid.Column="2"
                                    Background="#0AFFFFFF"
                                    BorderBrush="#14FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="SESSION STATUS" FontSize="8" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding LastDnsFlushText}" FontSize="11" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                                </StackPanel>
                            </Border>

                            <!-- Col 3: Action Button -->
                            <Button Grid.Column="3"
                                    Style="{StaticResource StartMiniButton}"
                                    Content="🚀 FLUSH DNS CACHE"
                                    Command="{Binding FlushDnsCommand}"
                                    IsEnabled="{Binding IsNotScanning}"
                                    Padding="14,8"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        
    </Grid>
</UserControl>
