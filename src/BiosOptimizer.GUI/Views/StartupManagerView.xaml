<UserControl x:Class="BiosOptimizer.GUI.Views.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <!-- MAIN SCROLLABLE CONTENT                              -->
        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
            <Grid MaxWidth="1600" Margin="28,20,28,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Metrics Summary -->
                    <RowDefinition Height="Auto"/> <!-- 2: Search & Filter Toolbar -->
                    <RowDefinition Height="*"/>    <!-- 3: Startup Items List -->
                </Grid.RowDefinitions>

                <!-- ──────────────────────────────────────────────── -->
                <!-- 0. PAGE HEADER (COMPACT & CLEAN)                 -->
                <!-- ──────────────────────────────────────────────── -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <controls:NavigationIcon Icon="startupmanager" Size="26" IsActive="True" GlowEnabled="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="STARTUP MANAGER" Style="{StaticResource PageTitleStyle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Manage startup applications and background tasks that launch automatically with Windows. Accelerate boot latency."
                                   Style="{StaticResource PageSubtitleStyle}" FontSize="11" Margin="36,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Rescan Button -->
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotScanning}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RESCAN STARTUP" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ──────────────────────────────────────────────── -->
                <!-- 1. COMPACT METRICS SUMMARY STRIP                -->
                <!-- ──────────────────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="20,14" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TOTAL APPS -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TOTAL APPS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- ENABLED -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="ENABLED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding EnabledCount}" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- DISABLED -->
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="DISABLED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding DisabledCount}" FontSize="16" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- HIGH IMPACT -->
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="HIGH IMPACT" FontSize="8.5" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="{Binding HighImpactCount}" FontSize="16" FontWeight="Bold" Foreground="#EF4444" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- MEDIUM IMPACT -->
                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Text="MEDIUM IMPACT" FontSize="8.5" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding MediumImpactCount}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- LOW IMPACT -->
                        <StackPanel Grid.Column="5">
                            <TextBlock Text="LOW IMPACT" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding LowImpactCount}" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ──────────────────────────────────────────────── -->
                <!-- 2. SEARCH & FILTER TOOLBAR                       -->
                <!-- ──────────────────────────────────────────────── -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Search + Sort Row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Input -->
                            <Border Grid.Column="0" Background="#121520" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                    <Button Grid.Column="2" Content="✕" Command="{Binding ResetFiltersCommand}" Style="{StaticResource TitleBarCloseButton}"
                                            Width="16" Height="16" FontSize="8" Padding="0" Margin="4,0,0,0"
                                            Visibility="{Binding SearchQuery.Length, Converter={StaticResource CountToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Sort Selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SORT:" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox SelectedValue="{Binding SelectedSort}" SelectedValuePath="Tag" Width="140" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}">
                                    <ComboBoxItem Content="Name" Tag="NAME"/>
                                    <ComboBoxItem Content="Impact" Tag="IMPACT"/>
                                    <ComboBoxItem Content="Status" Tag="STATUS"/>
                                    <ComboBoxItem Content="Publisher" Tag="PUBLISHER"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Filter Chips -->
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PillFilterButton}" Content="ALL" Command="{Binding SetFilterCommand}" CommandParameter="ALL" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="ENABLED" Command="{Binding SetFilterCommand}" CommandParameter="ENABLED" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="DISABLED" Command="{Binding SetFilterCommand}" CommandParameter="DISABLED" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="HIGH IMPACT" Command="{Binding SetFilterCommand}" CommandParameter="HIGH" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="MEDIUM" Command="{Binding SetFilterCommand}" CommandParameter="MEDIUM" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="LOW" Command="{Binding SetFilterCommand}" CommandParameter="LOW" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="USER APPS" Command="{Binding SetFilterCommand}" CommandParameter="USER" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="SYSTEM" Command="{Binding SetFilterCommand}" CommandParameter="SYSTEM" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="UNMEASURED" Command="{Binding SetFilterCommand}" CommandParameter="UNKNOWN" Margin="0,0,0,4" Padding="11,4" FontSize="9"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ──────────────────────────────────────────────── -->
                <!-- 3. STARTUP ITEMS LIST (COMPACT & CLEAN)          -->
                <!-- ──────────────────────────────────────────────── -->
                <Grid Grid.Row="3">
                    <ItemsControl ItemsSource="{Binding VisibleItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardSmallStyle}" Padding="18,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- App Icon -->
                                            <ColumnDefinition Width="*"/>    <!-- Name & Publisher -->
                                            <ColumnDefinition Width="Auto"/> <!-- Badges (Status & Impact) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Actions (Toggle & Details) -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 0: App Icon / Category Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#14FFFFFF"
                                                BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Grid>
                                                <!-- Extracted Executable Icon if Available -->
                                                <Image Source="{Binding AppIcon}" Width="22" Height="22"
                                                       Visibility="{Binding HasAppIcon, Converter={StaticResource BoolToVis}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <!-- Fallback Category Glyph -->
                                                <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasAppIcon, Converter={StaticResource InverseBoolToVis}}"
                                                           Foreground="{Binding CategoryColor}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Column 1: Application Name & Publisher • Category (NO PATHS) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Publisher}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" • " FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding CategoryColor}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Column 2: Status & Impact Badges -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <!-- Status Badge -->
                                            <Border CornerRadius="4" Padding="8,3" Background="{Binding StatusBadgeBackground}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            </Border>

                                            <!-- Impact Badge -->
                                            <Border CornerRadius="4" Padding="8,3" Background="#0AFFFFFF" BorderBrush="{Binding ImpactColor}" BorderThickness="1">
                                                <TextBlock Text="{Binding Impact, StringFormat='{}{0} IMPACT'}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding ImpactColor}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Column 3: Action Buttons (Toggle + Details) -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Toggle Enable / Disable -->
                                            <Button Style="{StaticResource PillFilterButton}" Content="{Binding ActionButtonText}"
                                                    Command="{Binding ToggleCommand}"
                                                    Padding="12,5" FontSize="9" FontWeight="Bold" Margin="0,0,8,0"
                                                    Foreground="{Binding StatusColor}" BorderBrush="{Binding StatusColor}"/>

                                            <!-- Details Modal Trigger -->
                                            <Button Style="{StaticResource PillFilterButton}" Content="DETAILS"
                                                    Command="{Binding DataContext.OpenDetailModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,5" FontSize="9" FontWeight="Bold"
                                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="32,36" HorizontalAlignment="Stretch"
                            Visibility="{Binding HasVisibleItems, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="NO STARTUP ITEMS MATCH CRITERIA" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No startup applications or background entries match your current search query or filter selection." 
                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" HorizontalAlignment="Center"
                                    Command="{Binding ResetFiltersCommand}" Content="RESET ALL FILTERS"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <!-- STARTUP TECHNICAL DETAILS MODAL                      -->
        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Grid Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10000">
            <!-- Modal Backdrop (Click to dismiss) -->
            <Border Background="#E003050B">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseDetailModalCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border MaxWidth="750" MaxHeight="600" Margin="24" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#141724" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.85"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Content -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#14FFFFFF" Margin="0,0,12,0">
                            <Image Source="{Binding SelectedDetailItem.AppIcon}" Width="24" Height="24"
                                   Visibility="{Binding SelectedDetailItem.HasAppIcon, Converter={StaticResource BoolToVis}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title + Category -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDetailItem.DisplayName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedDetailItem.Publisher, StringFormat='Publisher: {0}'}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Status Badge -->
                        <Border Grid.Column="2" CornerRadius="5" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{Binding SelectedDetailItem.StatusBadgeBackground}">
                            <TextBlock Text="{Binding SelectedDetailItem.StatusText}" FontSize="9" FontWeight="Bold" Foreground="{Binding SelectedDetailItem.StatusColor}"/>
                        </Border>

                        <!-- Close Button -->
                        <Button Grid.Column="3" Content="✕" Command="{Binding CloseDetailModalCommand}" Style="{StaticResource TitleBarCloseButton}"
                                Width="30" Height="30" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Modal Body (Sectioned Technical Details) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
                        <StackPanel Margin="0,0,10,0">

                            <!-- SECTION 1: APPLICATION IDENTITY -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SECTION 1: APPLICATION IDENTITY &amp; CLASSIFICATION" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                            <TextBlock Text="CATEGORY / TYPE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.Category}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                            <TextBlock Text="FILE VERSION" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.Version}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="SYSTEM COMPONENT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.IsSystemItem, Converter={StaticResource BooleanToYesNoConverter}}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="DISK FILE VERIFICATION" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.FileExists, Converter={StaticResource BooleanToYesNoConverter}}" FontSize="10" Foreground="#10B981" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: STARTUP COMMAND & EXECUTION PATH -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SECTION 2: STARTUP COMMAND &amp; EXECUTION PATH" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Text="STARTUP COMMAND LINE:" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="#08FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,2,0,8">
                                        <TextBox Text="{Binding SelectedDetailItem.CommandLine, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                 FontSize="9.5" FontFamily="Consolas" Foreground="#38BDF8" TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="TARGET EXECUTABLE PATH:" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="#08FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,2,0,0">
                                        <TextBox Text="{Binding SelectedDetailItem.ExePath, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                 FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: REGISTRY & SOURCE LOCATION -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SECTION 3: RAW REGISTRY &amp; SOURCE LOCATION" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Text="REGISTRY HIVE / STARTUP LOCATION:" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="#08FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,2,0,8">
                                        <TextBox Text="{Binding SelectedDetailItem.Path, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                 FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="VALUE NAME / ENTRY KEY:" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="#08FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,2,0,0">
                                        <TextBox Text="{Binding SelectedDetailItem.ValueName, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                 FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: IMPACT & BEHAVIOR -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 4: SYSTEM IMPACT &amp; REQUIREMENTS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="BOOT IMPACT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.Impact, StringFormat='{}{0} IMPACT'}" FontSize="10" FontWeight="Bold" Foreground="{Binding SelectedDetailItem.ImpactColor}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="ELEVATED ADMIN" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.RequiresAdmin, Converter={StaticResource BooleanToYesNoConverter}}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="RESTART REQUIRED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.RequiresRestart, Converter={StaticResource BooleanToYesNoConverter}}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding SelectedDetailItem.ActionButtonText}"
                                    Command="{Binding SelectedDetailItem.ToggleCommand}"
                                    Style="{StaticResource PillFilterButton}"
                                    Padding="14,6" Margin="0,0,10,0"
                                    Foreground="{Binding SelectedDetailItem.StatusColor}" BorderBrush="{Binding SelectedDetailItem.StatusColor}"/>

                            <Button Content="CLOSE DETAILS" Command="{Binding CloseDetailModalCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <!-- SAFETY CONFIRMATION MODAL                            -->
        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Grid Background="#CC000000" Visibility="{Binding IsSafetyModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="20000">
            <Border Style="{StaticResource GlassCardStyle}" MaxWidth="500" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#80EF4444" BorderThickness="1.2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DISABLE SYSTEM STARTUP ENTRY?" FontSize="13" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="Safety Confirmation Required" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SafetyModalItem.DisplayName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SafetyModalItem.Publisher, StringFormat='Publisher: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="This entry is identified as an IMPORTANT SYSTEM OR DRIVER COMPONENT. Disabling it may impair Windows security monitoring or hardware capabilities."
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0"
                                Command="{Binding CancelSafetyModalCommand}" Content="CANCEL"/>

                        <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Padding="14,6"
                                Command="{Binding ConfirmSafetyDisableCommand}" Content="DISABLE ANYWAY"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
