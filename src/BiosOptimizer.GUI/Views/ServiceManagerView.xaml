<UserControl x:Class="BiosOptimizer.GUI.Views.ServiceManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <!-- MAIN SCROLLABLE CONTENT                              -->
        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
            <Grid MaxWidth="1600" Margin="28,20,28,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Metrics Summary -->
                    <RowDefinition Height="Auto"/> <!-- 2: Search & Filter Toolbar -->
                    <RowDefinition Height="*"/>    <!-- 3: Service Items List -->
                </Grid.RowDefinitions>

                <!-- ──────────────────────────────────────────────── -->
                <!-- 0. PAGE HEADER (COMPACT & CLEAN)                 -->
                <!-- ──────────────────────────────────────────────── -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <controls:NavigationIcon Icon="servicemanager" Size="26" IsActive="True" GlowEnabled="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SERVICE MANAGER" Style="{StaticResource PageTitleStyle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Inspect, monitor, and optimize Windows background services. Identify safe-to-stop non-essential services."
                                   Style="{StaticResource PageSubtitleStyle}" FontSize="11" Margin="36,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Rescan Button -->
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotScanning}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RESCAN SERVICES" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ──────────────────────────────────────────────── -->
                <!-- 1. COMPACT METRICS SUMMARY STRIP                -->
                <!-- ──────────────────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="20,14" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TOTAL SERVICES -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TOTAL SERVICES" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- RUNNING -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="RUNNING" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding RunningCount}" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- STOPPED -->
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="STOPPED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StoppedCount}" FontSize="16" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- SAFE TO STOP -->
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="SAFE TO STOP" FontSize="8.5" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding SafeToStopCount}" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- WITH CAUTION -->
                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Text="WITH CAUTION" FontSize="8.5" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding SafeWithCautionCount}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- DO NOT STOP -->
                        <StackPanel Grid.Column="5">
                            <TextBlock Text="DO NOT STOP" FontSize="8.5" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="{Binding DoNotStopCount}" FontSize="16" FontWeight="Bold" Foreground="#EF4444" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ──────────────────────────────────────────────── -->
                <!-- 2. SEARCH & FILTER TOOLBAR                       -->
                <!-- ──────────────────────────────────────────────── -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="18,14" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Search + Sort Row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Input -->
                            <Border Grid.Column="0" Background="#121520" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                    <Button Grid.Column="2" Content="✕" Command="{Binding ResetFiltersCommand}" Style="{StaticResource TitleBarCloseButton}"
                                            Width="16" Height="16" FontSize="8" Padding="0" Margin="4,0,0,0"
                                            Visibility="{Binding SearchQuery.Length, Converter={StaticResource CountToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Sort Selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SORT:" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox SelectedValue="{Binding SelectedSort}" SelectedValuePath="Tag" Width="150" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}">
                                    <ComboBoxItem Content="Action Safety" Tag="SAFETY"/>
                                    <ComboBoxItem Content="Display Name" Tag="NAME"/>
                                    <ComboBoxItem Content="Running State" Tag="STATUS"/>
                                    <ComboBoxItem Content="Startup Mode" Tag="STARTUP"/>
                                    <ComboBoxItem Content="Publisher" Tag="PUBLISHER"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Filter Chips -->
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PillFilterButton}" Content="ALL" Command="{Binding SetFilterCommand}" CommandParameter="ALL" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="RUNNING" Command="{Binding SetFilterCommand}" CommandParameter="RUNNING" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="STOPPED" Command="{Binding SetFilterCommand}" CommandParameter="STOPPED" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="SAFE TO STOP" Command="{Binding SetFilterCommand}" CommandParameter="SAFE_TO_STOP" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="WITH CAUTION" Command="{Binding SetFilterCommand}" CommandParameter="CAUTION" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="THIRD PARTY" Command="{Binding SetFilterCommand}" CommandParameter="THIRD_PARTY" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="MICROSOFT" Command="{Binding SetFilterCommand}" CommandParameter="MICROSOFT" Margin="0,0,6,4" Padding="11,4" FontSize="9"/>
                            <Button Style="{StaticResource PillFilterButton}" Content="DISABLED" Command="{Binding SetFilterCommand}" CommandParameter="DISABLED" Margin="0,0,0,4" Padding="11,4" FontSize="9"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ──────────────────────────────────────────────── -->
                <!-- 3. SERVICE ITEMS LIST (COMPACT & CLEAN)          -->
                <!-- ──────────────────────────────────────────────── -->
                <Grid Grid.Row="3">
                    <ItemsControl ItemsSource="{Binding VisibleItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardSmallStyle}" Padding="18,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Service Icon -->
                                            <ColumnDefinition Width="*"/>    <!-- Name & Publisher -->
                                            <ColumnDefinition Width="Auto"/> <!-- Badges (State, Startup, Safety) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Actions (Start/Stop, Restart, Details) -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 0: Service Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#14FFFFFF"
                                                BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding CategoryColor}"/>
                                        </Border>

                                        <!-- Column 1: Service Name & Publisher • Service Type (NO PATHS) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Publisher}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" • " FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding ServiceType}" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Column 2: Status, Startup Type & Safety Badges -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <!-- Running State Badge -->
                                            <Border CornerRadius="4" Padding="8,3" Background="{Binding StatusBadgeBackground}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            </Border>

                                            <!-- Startup Type Badge -->
                                            <Border CornerRadius="4" Padding="8,3" Background="#0AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StartupType}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>

                                            <!-- Action Safety Badge -->
                                            <Border CornerRadius="4" Padding="8,3" Background="{Binding ActionSafetyBadgeBackground}" BorderBrush="{Binding ActionSafetyColor}" BorderThickness="1">
                                                <TextBlock Text="{Binding ActionSafetyBadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding ActionSafetyColor}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Column 3: Action Buttons (Start/Stop + Restart + Details) -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Start Service Button (Visible when Stopped) -->
                                            <Button Style="{StaticResource PillFilterButton}" Content="START"
                                                    Command="{Binding StartCommand}"
                                                    Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}"
                                                    Padding="11,5" FontSize="9" FontWeight="Bold" Margin="0,0,6,0"
                                                    Foreground="#10B981" BorderBrush="#10B981"/>

                                            <!-- Stop Service Button (Visible when Running) -->
                                            <Button Style="{StaticResource PillFilterButton}" Content="STOP"
                                                    Command="{Binding StopCommand}"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                    Padding="11,5" FontSize="9" FontWeight="Bold" Margin="0,0,6,0"
                                                    Foreground="#EF4444" BorderBrush="#EF4444"/>

                                            <!-- Restart Button (Visible when Running) -->
                                            <Button Style="{StaticResource PillFilterButton}" Content="RESTART"
                                                    Command="{Binding RestartCommand}"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                    Padding="11,5" FontSize="9" FontWeight="Bold" Margin="0,0,6,0"
                                                    Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"/>

                                            <!-- Details Modal Trigger -->
                                            <Button Style="{StaticResource PillFilterButton}" Content="DETAILS"
                                                    Command="{Binding DataContext.OpenDetailModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="11,5" FontSize="9" FontWeight="Bold"
                                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border Style="{StaticResource GlassCardStyle}" Padding="32,36" HorizontalAlignment="Stretch"
                            Visibility="{Binding HasVisibleItems, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="NO SERVICES MATCH CRITERIA" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No Windows services match your current search query or filter selection." 
                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" HorizontalAlignment="Center"
                                    Command="{Binding ResetFiltersCommand}" Content="RESET ALL FILTERS"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <!-- SERVICE TECHNICAL DETAILS MODAL                      -->
        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Grid Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10000">
            <!-- Modal Backdrop (Click to dismiss) -->
            <Border Background="#E003050B">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseDetailModalCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border MaxWidth="800" MaxHeight="640" Margin="24" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#141724" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.85"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Content -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#14FFFFFF" Margin="0,0,12,0">
                            <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <!-- Title + Service Name -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDetailItem.DisplayName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedDetailItem.ServiceName, StringFormat='SERVICE NAME: {0}'}" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Safety Badge -->
                        <Border Grid.Column="2" CornerRadius="5" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{Binding SelectedDetailItem.ActionSafetyBadgeBackground}"
                                BorderBrush="{Binding SelectedDetailItem.ActionSafetyColor}" BorderThickness="1">
                            <TextBlock Text="{Binding SelectedDetailItem.ActionSafetyBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding SelectedDetailItem.ActionSafetyColor}"/>
                        </Border>

                        <!-- Close Button -->
                        <Button Grid.Column="3" Content="✕" Command="{Binding CloseDetailModalCommand}" Style="{StaticResource TitleBarCloseButton}"
                                Width="30" Height="30" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Modal Body (Sectioned Technical Details) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
                        <StackPanel Margin="0,0,10,0">

                            <!-- SECTION 1: SERVICE DESCRIPTION & IDENTITY -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SECTION 1: SERVICE IDENTITY &amp; DESCRIPTION" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedDetailItem.Description}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PUBLISHER" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.Publisher}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ACCOUNT CONTEXT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.Account}" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: BINARY & EXECUTION PATH -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SECTION 2: BINARY &amp; EXECUTION PATH" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>

                                    <TextBlock Text="EXECUTABLE / BINARY PATH:" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="#08FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,2,0,8">
                                        <TextBox Text="{Binding SelectedDetailItem.ExePath, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                 FontSize="9.5" FontFamily="Consolas" Foreground="#38BDF8" TextWrapping="Wrap"/>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SERVICE PROCESS TYPE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.ServiceType}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="CURRENT STARTUP MODE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.StartupType}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: ACTION SAFETY & RISK ANALYSIS -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SECTION 3: ACTION SAFETY &amp; RISK ANALYSIS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    
                                    <Border Background="{Binding SelectedDetailItem.ActionSafetyBadgeBackground}"
                                            BorderBrush="{Binding SelectedDetailItem.ActionSafetyColor}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedDetailItem.ActionSafetyBadgeText, StringFormat='SAFETY CLASSIFICATION: {0}'}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding SelectedDetailItem.ActionSafetyColor}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.ActionSafetyReason}" FontSize="9.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="14"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="WINDOWS CRITICAL SERVICE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.IsCritical, Converter={StaticResource BooleanToYesNoConverter}}" FontSize="9.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="MICROSOFT SIGNATURE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.IsMicrosoft, Converter={StaticResource BooleanToYesNoConverter}}" FontSize="9.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: DEPENDENCIES & DEPENDENTS -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SECTION 4: DEPENDENCIES &amp; ACTIVE DEPENDENTS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="DEPENDS ON (PARENT SERVICES)" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.DependsOnSummary}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ACTIVE DEPENDENTS (SUBSYSTEMS AFFECTED)" FontSize="8" FontWeight="Bold" Foreground="#EF4444"/>
                                            <TextBlock Text="{Binding SelectedDetailItem.DependentsSummary}" FontSize="9.5" Foreground="#FCA5A5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 5: STARTUP CONFIGURATION QUICK ACTIONS -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 5: STARTUP CONFIGURATION QUICK ACTIONS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PillFilterButton}" Content="AUTOMATIC"
                                                Command="{Binding SelectedDetailItem.SetStartupModeCommand}" CommandParameter="Automatic"
                                                Padding="12,5" FontSize="9" FontWeight="Bold" Margin="0,0,8,4"/>
                                        <Button Style="{StaticResource PillFilterButton}" Content="AUTOMATIC (DELAYED)"
                                                Command="{Binding SelectedDetailItem.SetStartupModeCommand}" CommandParameter="AutomaticDelayedStart"
                                                Padding="12,5" FontSize="9" FontWeight="Bold" Margin="0,0,8,4"/>
                                        <Button Style="{StaticResource PillFilterButton}" Content="MANUAL"
                                                Command="{Binding SelectedDetailItem.SetStartupModeCommand}" CommandParameter="Manual"
                                                Padding="12,5" FontSize="9" FontWeight="Bold" Margin="0,0,8,4"/>
                                        <Button Style="{StaticResource PillFilterButton}" Content="DISABLED"
                                                Command="{Binding SelectedDetailItem.SetStartupModeCommand}" CommandParameter="Disabled"
                                                Padding="12,5" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"
                                                Foreground="#EF4444" BorderBrush="#EF4444"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="START" Command="{Binding SelectedDetailItem.StartCommand}"
                                    Visibility="{Binding SelectedDetailItem.IsStopped, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource PillFilterButton}" Padding="14,6" Margin="0,0,8,0"
                                    Foreground="#10B981" BorderBrush="#10B981"/>

                            <Button Content="STOP" Command="{Binding SelectedDetailItem.StopCommand}"
                                    Visibility="{Binding SelectedDetailItem.IsRunning, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource PillFilterButton}" Padding="14,6" Margin="0,0,8,0"
                                    Foreground="#EF4444" BorderBrush="#EF4444"/>

                            <Button Content="RESTART" Command="{Binding SelectedDetailItem.RestartCommand}"
                                    Visibility="{Binding SelectedDetailItem.IsRunning, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource PillFilterButton}" Padding="14,6" Margin="0,0,10,0"
                                    Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"/>

                            <Button Content="CLOSE DETAILS" Command="{Binding CloseDetailModalCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <!-- SAFETY CONFIRMATION MODAL                            -->
        <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
        <Grid Background="#CC000000" Visibility="{Binding IsSafetyModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="20000">
            <Border Style="{StaticResource GlassCardStyle}" MaxWidth="500" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#80EF4444" BorderThickness="1.2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SafetyModalTitle}" FontSize="13" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="Action requires explicit user confirmation" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SafetyModalItem.DisplayName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SafetyModalItem.ServiceName, StringFormat='Internal Service Name: {0}'}" FontSize="10" FontFamily="Consolas" Foreground="#FCA5A5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding SafetyModalMessage}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid Visibility="{Binding IsModalActionAllowed, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0"
                                Command="{Binding CancelSafetyModalCommand}" Content="CANCEL (SAFE)"/>

                        <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Padding="14,6"
                                Command="{Binding ConfirmSafetyActionCommand}" Content="CONFIRM &amp; PROCEED"/>
                    </Grid>

                    <Button Visibility="{Binding IsModalActionBlocked, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" HorizontalAlignment="Right"
                            Command="{Binding CancelSafetyModalCommand}" Content="CLOSE (BLOCKED)"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
