<UserControl x:Class="BiosOptimizer.GUI.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" 
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
            <Grid Margin="24,20,24,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Summary Counter Strip -->
                    <RowDefinition Height="Auto"/> <!-- Profile Backup Container Groups -->
                    <RowDefinition Height="Auto"/> <!-- Search & Filter Bar -->
                    <RowDefinition Height="*"/>    <!-- All Optimization Transactions List -->
                </Grid.RowDefinitions>

                <!-- ======================================================== -->
                <!-- ROW 0: PAGE HEADER & PRIMARY ACTION BUTTONS              -->
                <!-- ======================================================== -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:NavigationIcon Icon="BackupRestore" IsActive="True" Size="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BACKUP &amp; RESTORE" Style="{StaticResource PageTitleStyle}" FontSize="20" VerticalAlignment="Center"/>
                            <Border Margin="12,0,0,0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="UNIVERSAL TRANSACTION ENGINE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Authoritative per-optimization real state backups, profile containers, and verified rollback history." 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadBackupsCommand}" Height="34" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="REFRESH" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CreateSnapshotCommand}" Height="34" Padding="14,0" Margin="0,0,8,0"
                                ToolTip="Create a verified Windows System Restore Point using real System Protection">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CREATE RESTORE POINT" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding RestoreSystemCommand}" Height="34" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RESTORE ENTIRE SYSTEM" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!-- ROW 1: LIVE 8-METRIC SUMMARY STRIP                       -->
                <!-- ======================================================== -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,16" BorderBrush="{DynamicResource AccentBorderSubtleBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TOTAL TRANSACTIONS -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL BACKUPS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalBackupsCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Fill="#14FFFFFF" Margin="0,2"/>

                        <!-- PROFILE CONTAINERS -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="PROFILES" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ProfileBackupsCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Fill="#14FFFFFF" Margin="0,2"/>

                        <!-- OPTIMIZATIONS -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="OPTIMIZATIONS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding OptimizationBackupsCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="5" Fill="#14FFFFFF" Margin="0,2"/>

                        <!-- REGISTRY -->
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                            <TextBlock Text="REGISTRY VALUES" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RegistryBackupsCount}" FontSize="16" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="7" Fill="#14FFFFFF" Margin="0,2"/>

                        <!-- SNAPSHOTS -->
                        <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                            <TextBlock Text="SYSTEM RESTORE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SystemSnapshotsCount}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="9" Fill="#14FFFFFF" Margin="0,2"/>

                        <!-- RESTORABLE -->
                        <StackPanel Grid.Column="10" HorizontalAlignment="Center">
                            <TextBlock Text="RESTORABLE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RestorableCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="11" Fill="#14FFFFFF" Margin="0,2"/>

                        <!-- NON-REVERSIBLE -->
                        <StackPanel Grid.Column="12" HorizontalAlignment="Center">
                            <TextBlock Text="NON-REVERSIBLE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding NonReversibleCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- ROW 2: 6 PROFILE BACKUP CONTAINERS                       -->
                <!-- ======================================================== -->
                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                    <TextBlock Text="PROFILE CONTAINERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding ProfileGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Padding="14,12" Margin="4,4" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border HorizontalAlignment="Right" Background="#1410B981" CornerRadius="3" Padding="6,1">
                                                <TextBlock Text="{Binding RestorableTransactions, StringFormat='{}{0} RESTORABLE'}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Subtitle & Last Backup -->
                                        <TextBlock Grid.Row="1" Text="{Binding DisplayLastBackup, StringFormat='Last: {0}'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,2"/>
                                        <TextBlock Grid.Row="2" Text="{Binding StatusSummary}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- Action Buttons -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ProfileName}"
                                                    Height="26" Padding="0">
                                                <TextBlock Text="VIEW ITEMS" FontSize="8" FontWeight="Bold"/>
                                            </Button>

                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.RestoreProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ProfileName}"
                                                    Height="26" Padding="0">
                                                <TextBlock Text="RESTORE PROFILE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- ROW 3: SEARCH BAR & CATEGORY FILTER CHIPS                -->
                <!-- ======================================================== -->
                <Border Grid.Row="3" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#121216" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="4" Padding="10,0" Height="32">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" 
                                             FontSize="10" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </Border>

                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetFilterCommand}" Height="32" Padding="14,0">
                                <TextBlock Text="RESET FILTERS" FontSize="9" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <!-- Filter Chips Scrollable List -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="ALL" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="ALL" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="REGISTRY" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="REGISTRY" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="POWER" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="POWER" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="INPUT" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="INPUT" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="NETWORK" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="NETWORK" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="STORAGE" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="STORAGE" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="MEMORY" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="MEMORY" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="SERVICES" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="SERVICES" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="REPAIR" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="REPAIR" FontSize="8" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="RESTORABLE" Height="24" Padding="10,0" Margin="0,0,6,0">
                                    <TextBlock Text="✓ RESTORABLE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="NON-REVERSIBLE" Height="24" Padding="10,0">
                                    <TextBlock Text="NON-REVERSIBLE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- ROW 4: ALL OPTIMIZATION TRANSACTIONS LIST                -->
                <!-- ======================================================== -->
                <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="16" BorderBrush="{DynamicResource AccentBorderSubtleBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="TRANSACTION HISTORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding FilteredTransactions.Count, StringFormat='Showing {0} records'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>

                        <!-- Empty State Notification -->
                        <Border Visibility="{Binding HasNoTransactions, Converter={StaticResource BoolToVis}}" 
                                Background="#05FFFFFF" BorderBrush="#0AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="32,24" Margin="0,4,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="NO BACKUP TRANSACTIONS RECORDED YET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Universal transaction records and state backups will appear here automatically whenever Error Optimizer applies a profile, tweaks registry values, alters power schemes, or cleans system files." 
                                           FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
                            <ItemsControl ItemsSource="{Binding FilteredTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left info -->
                                                <StackPanel Grid.Column="0">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding OptimizationName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <Border Margin="8,0,0,0" Background="#12FFFFFF" CornerRadius="3" Padding="5,1">
                                                                <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            </Border>
                                                            <Border Margin="6,0,0,0" Background="#10FFFFFF" CornerRadius="3" Padding="5,1">
                                                                <TextBlock Text="{Binding ProfileName}" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock HorizontalAlignment="Right" Text="{Binding DisplayTimestamp}" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding TargetKey, StringFormat='Target: {0}'}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,2" TextTrimming="CharacterEllipsis"/>

                                                    <!-- Before / After Strip -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <Run Text="Before: "/><Run Text="{Binding BeforeState}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <Run Text="  →  After: "/><Run Text="{Binding AfterState}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right Badges & Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Status Badge -->
                                                    <Border Background="#10FFFFFF" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>

                                                    <!-- Rollback Status Badge -->
                                                    <Border Background="#10FFFFFF" CornerRadius="3" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RollbackStatus}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                    </Border>

                                                    <!-- Details Button -->
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Height="26" Padding="10,0" Margin="0,0,6,0">
                                                        <TextBlock Text="DETAILS" FontSize="8" FontWeight="Bold"/>
                                                    </Button>

                                                    <!-- Restore Button -->
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.RestoreSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanRollback}"
                                                            Height="26" Padding="12,0">
                                                        <TextBlock Text="RESTORE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- TRANSACTION DETAILS MODAL                                    -->
        <!-- ============================================================ -->
        <Grid Background="#D8000000" Visibility="{Binding IsDetailsModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="998">
            <Border Style="{StaticResource GlassCardStyle}" Width="640" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="#F2111114" BorderBrush="{DynamicResource AccentBorderBrush}" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="TRANSACTION DETAILS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedTransaction.TransactionId, StringFormat='Transaction ID: {0}'}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4" FontSize="9"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Optimization:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedTransaction.OptimizationName}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Profile / Module:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedTransaction.ProfileName}" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Category &amp; Risk:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedTransaction.Category, StringFormat='{}{0} • Risk: SAFE'}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Timestamp:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedTransaction.DisplayTimestamp}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Machine Identity:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedTransaction.MachineId}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Target Key / Path:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedTransaction.TargetKey}" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Separator Background="#14FFFFFF" Margin="0,6,0,8"/>

                            <TextBlock Text="STATE TRANSITION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Background="#08FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Before State: " FontWeight="Bold"/><Run Text="{Binding SelectedTransaction.BeforeState}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="After State: " FontWeight="Bold"/><Run Text="{Binding SelectedTransaction.AfterState}" Foreground="{DynamicResource AccentBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ROLLBACK DIAGNOSTICS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Background="#08FFFFFF" CornerRadius="4" Padding="10,8">
                                <StackPanel>
                                    <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Rollback Method: "/><Run Text="{Binding SelectedTransaction.RollbackMethod}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                        <Run Text="Status: "/><Run Text="{Binding SelectedTransaction.RollbackStatus}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="8" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding SelectedTransaction.Notes}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Button Content="CLOSE" Command="{Binding CloseDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                HorizontalAlignment="Right" Padding="20,8"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- RESTORE CONFIRMATION MODAL                                   -->
        <!-- ============================================================ -->
        <Grid Background="#D8000000" Visibility="{Binding IsRestoreConfirmOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="999">
            <Border Style="{StaticResource GlassCardStyle}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="#F2141418" BorderBrush="{DynamicResource AccentBorderBrush}" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{Binding RestoreConfirmTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding RestoreConfirmMessage}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,18" TextWrapping="Wrap" LineHeight="16"/>

                    <Grid>
                        <Button Content="CANCEL" Command="{Binding CancelRestoreCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                HorizontalAlignment="Left" Padding="18,8"/>
                        <Button Content="PROCEED WITH RESTORE" Command="{Binding ConfirmRestoreCommand}" Style="{StaticResource PrimaryOptimizationButton}" 
                                HorizontalAlignment="Right" Padding="20,8"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- ADVANCED RESTORE RESULT MODAL                                -->
        <!-- ============================================================ -->
        <Grid Background="#E0000000" Visibility="{Binding IsRestoreResultModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000">
            <Border Style="{StaticResource GlassCardStyle}" Width="580" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="#F2141418" BorderBrush="{Binding RestoreResultBrush}" BorderThickness="1.5" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header -->
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/> <!-- 2: Summary Stats Grid -->
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>    <!-- 4: Detailed Logs -->
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/> <!-- 6: Close Button -->
                    </Grid.RowDefinitions>

                    <!-- 0: Header with Icon & Result Title -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#18FFFFFF" BorderBrush="{Binding RestoreResultBrush}" BorderThickness="1.5">
                            <TextBlock Text="{Binding RestoreResultIcon}" FontSize="20" FontWeight="Bold" Foreground="{Binding RestoreResultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"/>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RestoreResultTitle}" FontSize="16" FontWeight="Bold" Foreground="{Binding RestoreResultBrush}"/>
                            <TextBlock Text="Authoritative Windows-verified rollback results and readback verification" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2: Summary Stats Grid -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Target / Backup Name -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="BACKUP TARGET / NAME" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RestoreResultBackupName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Category -->
                        <Border Grid.Row="0" Grid.Column="2" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="RESTORE CATEGORY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RestoreResultCategory}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Items Restored & Verification -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#144CAF50" BorderBrush="#334CAF50" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="ITEMS RESTORED" FontSize="8.5" FontWeight="Bold" Foreground="#81C784"/>
                                <TextBlock Text="{Binding RestoreResultItemsRestored}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Verification & Time -->
                        <Border Grid.Row="2" Grid.Column="2" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="EXECUTION TIME &amp; VERIFICATION" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RestoreResultExecutionTime, StringFormat='{}Elapsed: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 4: Verification Result & Detailed Logs -->
                    <Border Grid.Row="4" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="VERIFICATION AUDIT LOG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding RestoreResultVerification}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RestoreResultBrush}" Margin="0,0,0,8"/>

                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                                <ItemsControl ItemsSource="{Binding RestoreResultLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- 6: Close Action Button -->
                    <Button Grid.Row="6" Content="CLOSE" Command="{Binding CloseRestoreResultModalCommand}" Style="{StaticResource PrimaryButtonStyle}" 
                            HorizontalAlignment="Stretch" Height="36"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
