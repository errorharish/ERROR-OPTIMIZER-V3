<UserControl x:Class="BiosOptimizer.GUI.Views.RegistryValuesRamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:vm="clr-namespace:BiosOptimizer.GUI.ViewModels"
             xmlns:conv="clr-namespace:BiosOptimizer.GUI.Converters"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <!-- Main Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource SlimScrollViewer}">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><!-- 0: Header -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 2: Target Value Info Card -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 4: RAM Selector & Calculation Cards -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/><!-- 6: Action Buttons -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 8: Status & Verification Banner -->
                </Grid.RowDefinitions>

                <!-- 1. RAM HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavigationIcon Icon="RegistryValuesRam" IsActive="True" Size="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RAM REGISTRY VALUES" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Hardware-aware RAM Service Host (svchost) split threshold configuration."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Top-Right Rescan Button -->
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" Height="32" Padding="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RESCAN REGISTRY" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 2. TARGET VALUE SPECIFICATION CARD -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Target Value Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="{DynamicResource AccentOverlayBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock Text="TARGET VALUE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding TargetValueName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding OpenDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DETAILS" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Path & Type Badges -->
                        <WrapPanel Grid.Row="2" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="Path: " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TargetRegistryPath}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="Type: " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TargetValueType}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding TargetDescription}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 4. RAM SELECTOR & COMPARISON CARDS -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: RAM Selection Card -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="CHOOSE YOUR RAM SIZE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Select the physical RAM installed in your system." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableRamSizes}"
                                          SelectedItem="{Binding SelectedRamSize}"
                                          Height="36"
                                          Style="{StaticResource FlatComboBox}"/>

                                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Detected: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding DetectedRamText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                                    Visibility="{Binding IsDifferentFromDetected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="⚠️ Selected RAM differs from detected hardware. Verify before applying." FontSize="11" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Target Calculation Display -->
                            <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="TARGET CONFIGURATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hex Value:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TargetHexValue}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Decimal KB:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TargetDecimalValue}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Formula:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TargetFormula}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT: Current State & Comparison Card -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="CURRENT REGISTRY STATE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Live value read from Windows Registry." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                            <!-- Current Value Box -->
                            <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="READBACK VALUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hex Value:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentHexValue}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Decimal KB:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentDecimalValue}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Live Svchost Metrics -->
                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Svchost Instances" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LiveSvchostCount, StringFormat='{}{0} processes'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Svchost RAM Usage" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LiveSvchostMemoryMb, StringFormat='{}{0:F1} MB'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 6. ACTION BUTTONS -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- APPLY BUTTON -->
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Height="38" Padding="20,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="APPLY VALUE" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- RESTORE PREVIOUS BUTTON -->
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" Height="38" Padding="16,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RESTORE PREVIOUS" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- RESET SELECTION BUTTON -->
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetSelectionCommand}" Height="38" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RESET SELECTION" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 8. STATUS & VERIFICATION BANNER -->
                <Border Grid.Row="8" Background="#10FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{Binding StatusBrush}" CornerRadius="4" Width="4" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusBrush}"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Restart Button if required -->
                        <Button Grid.Column="2" Command="{Binding RestartLaterCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="12,0" VerticalAlignment="Center"
                                Visibility="{Binding RequiresRestart, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="SCHEDULE RESTART" FontSize="10" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- DETAILS MODAL (FOR RAM VALUE) -->
        <Grid Background="#B0000000" Visibility="{Binding IsDetailsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#161B22" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="TECHNICAL VALUE SPECIFICATION" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Registry Path" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="HKLM\SYSTEM\CurrentControlSet\Control" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Value Name" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="SvcHostSplitThresholdInKB" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Value Type" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="REG_DWORD" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="What It Controls" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="Changes the configured Service Host split threshold." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Selected RAM Mapping" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TargetFormula}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Target Value" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TargetHexValue, StringFormat='{}{0}'}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Backup State" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="Automatic snapshot created prior to registry write." FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Restart Requirement" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="Requires Windows restart for full system effect." FontSize="11" Foreground="{StaticResource WarningBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Verification State" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="Immediate readback verification required on write." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="#1AFFFFFF" Margin="0,0,0,14"/>

                    <!-- Modal Close Button -->
                    <Button Command="{Binding CloseDetailsCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="CLOSE DETAILS" Height="32" HorizontalAlignment="Right" Padding="18,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
