<UserControl x:Class="BiosOptimizer.GUI.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0: Header & Action Buttons -->
                <RowDefinition Height="24"/>     <!-- 1: Spacer -->
                <RowDefinition Height="Auto"/>   <!-- 2: Summary Cards -->
                <RowDefinition Height="16"/>     <!-- 3: Spacer -->
                <RowDefinition Height="Auto"/>   <!-- 4: Filter Bar -->
                <RowDefinition Height="16"/>     <!-- 5: Spacer -->
                <RowDefinition Height="*"/>      <!-- 6: Main Scrollable List -->
                <RowDefinition Height="12"/>     <!-- 7: Spacer -->
                <RowDefinition Height="Auto"/>   <!-- 8: Progress Bar -->
                <RowDefinition Height="8"/>      <!-- 9: Spacer -->
                <RowDefinition Height="Auto"/>   <!-- 10: Action buttons -->
            </Grid.RowDefinitions>

            <!-- ═══ ROW 0: Header & Action Buttons ═══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="App Debloat" Style="{StaticResource PageTitleStyle}"/>
                        <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,3"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DYNAMIC" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Remove unnecessary pre-installed Windows packages, telemetry apps, and sponsored bloatware safely." 
                               Style="{StaticResource PageSubtitleStyle}"
                               TextWrapping="Wrap" MaxWidth="800" Margin="0,8,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="SCAN NOW" Command="{Binding ScanCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="SELECT ALL" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="CLEAR ALL" Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ═══ ROW 2: Summary Cards ═══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DETECTED" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalDetected}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SAFE" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SafeCount}" Foreground="{StaticResource SuccessBrush}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MEDIUM" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MediumCount}" Foreground="{StaticResource WarningBrush}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="HIGH RISK" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding HighRiskCount}" Foreground="{StaticResource DangerBrush}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="PROTECTED" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProtectedCount}" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- ═══ ROW 4: Filter Bar ═══ -->
            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="ALL" Command="{Binding SetFilterCommand}" CommandParameter="ALL" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="SAFE" Command="{Binding SetFilterCommand}" CommandParameter="SAFE" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="MEDIUM" Command="{Binding SetFilterCommand}" CommandParameter="MEDIUM" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="HIGH RISK" Command="{Binding SetFilterCommand}" CommandParameter="HIGH RISK" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="PROTECTED" Command="{Binding SetFilterCommand}" CommandParameter="PROTECTED" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ═══ ROW 6: List Content ═══ -->
            <Grid Grid.Row="6">
                <!-- Empty State -->
                <Border Style="{StaticResource GlassCardStyle}" Visibility="{Binding HasNoTargets}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" Panel.ZIndex="10">
                    <TextBlock Text="{Binding EmptyStateMessage}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="14" HorizontalAlignment="Center"/>
                </Border>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}" Visibility="{Binding HasDebloatItemsVisibility}">
                    <ItemsControl ItemsSource="{Binding VisibleDebloatItems}" Margin="0,0,10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12" Background="#16191F" CornerRadius="8"
                                        BorderThickness="1" BorderBrush="#202229">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Checkbox / Lock -->
                                            <ColumnDefinition Width="*"/>    <!-- Text details -->
                                            <ColumnDefinition Width="Auto"/> <!-- Risk Badge -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Select Checkbox -->
                                        <Button Grid.Column="0" Command="{Binding ToggleSelectionCommand}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                VerticalAlignment="Center" Margin="0,0,12,0" Padding="0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="CheckboxBorder" Width="20" Height="20" CornerRadius="4" 
                                                                        BorderBrush="#3A3D48" BorderThickness="1" Background="#0C0D11">
                                                                    <!-- Checkmark -->
                                                                    <Path x:Name="CheckIcon" Width="10" Height="10" Stretch="Uniform" Fill="White" 
                                                                          Data="M9,16.2L4.8,12l-1.4,1.4L9,19 21,7l-1.4-1.4L9,16.2z" Visibility="Collapsed"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- Selected State -->
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="CheckboxBorder" Property="Background" Value="#4CAF50"/>
                                                                        <Setter TargetName="CheckboxBorder" Property="BorderThickness" Value="0"/>
                                                                        <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <!-- Mouse Over -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                            <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter TargetName="CheckboxBorder" Property="BorderBrush" Value="#4CAF50"/>
                                                                    </MultiDataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <!-- Protected Disabled State -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="SYSTEM PACKAGE">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="FRAMEWORK">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="RESOURCE">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="PROTECTED">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Protected Lock Icon (Visible only if Protected) -->
                                        <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                              Data="M12,17C10.89,17 10,16.1 10,15C10,13.89 10.89,13 12,13A2,2 0 0,1 14,15A2,2 0 0,1 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V10A2,2 0 0,1 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                              VerticalAlignment="Center" Margin="3,0,15,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="SYSTEM PACKAGE">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="FRAMEWORK">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="RESOURCE">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="PROTECTED">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>

                                        <!-- Text Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Publisher}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Risk Badge -->
                                        <Border Grid.Column="2" Background="#1A1C23" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FFA000"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="SAFE TO REMOVE">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="SYSTEM PACKAGE">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="FRAMEWORK">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="RESOURCE">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="PROTECTED">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ═══ ROW 8: ONE GLOBAL PROGRESS BAR — above RUN OPTIMIZATION ═══ -->
            <Grid Grid.Row="8">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="#0C0D11" CornerRadius="8" Height="48"
                        BorderThickness="1" BorderBrush="#1A1C23" ClipToBounds="True">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding OptimizationProgress}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="Transparent" BorderThickness="0"
                                 IsHitTestVisible="False"/>
                </Border>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontSize="12" FontWeight="SemiBold" IsHitTestVisible="False"/>
            </Grid>

            <!-- ═══ ROW 10: Action buttons ═══ -->
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCountText}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                </StackPanel>

                <!-- SAFE OPTIMIZE button -->
                <Button Grid.Column="1" Command="{Binding SafeOptimizeCommand}"
                        Padding="0,18" HorizontalAlignment="Stretch"
                        Cursor="Hand" BorderThickness="0"
                        IsEnabled="{Binding IsNotExecuting}">
                    <Button.Background>
                        <SolidColorBrush Color="#2E7D32"/>
                    </Button.Background>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background" Value="#2E7D32"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#388E3C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1B5E20"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Fill="White" Margin="0,0,12,0" VerticalAlignment="Center"
                              Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,10.99H19C18.47,15.11 15.72,18.78 12,20.92V10.99H5V6.3L12,3.19V10.99Z" />
                        <TextBlock Grid.Column="1" Text="SAFE OPTIMIZE" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- RUN OPTIMIZATION button -->
                <Button Grid.Column="3" Command="{Binding ApplyCommand}"
                        Padding="0,18" HorizontalAlignment="Stretch"
                        Cursor="Hand" BorderThickness="0"
                        IsEnabled="{Binding IsNotExecuting}">
                    <Button.Background>
                        <SolidColorBrush Color="{DynamicResource BrandPrimaryColor}"/>
                    </Button.Background>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EF5350"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Fill="White" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                            <Setter Property="Data" Value="M12,4V1L8,5l4,4V6c3.31,0 6,2.69 6,6c0,1.01 -0.25,1.97 -0.7,2.8l1.46,1.46C19.54,15.03 20,13.57 20,12C20,7.58 16.42,4 12,4M12,18c-3.31,0 -6,-2.69 -6,-6c0,-1.01 0.25,-1.97 0.7,-2.8L5.24,7.74C4.46,8.97 4,10.43 4,12c0,4.42 3.58,8 8,8v3l4,-4l-4,-4v3z"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Grid.Column="1" Text="RUN OPTIMIZATION" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
