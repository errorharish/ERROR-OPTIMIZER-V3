<UserControl x:Class="BiosOptimizer.GUI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:vm="clr-namespace:BiosOptimizer.GUI.ViewModels"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <!-- ======================================================== -->
        <!-- MAIN SCROLLABLE CONTENT LAYER (NO HORIZONTAL CLIPPING)   -->
        <!-- ======================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
            <StackPanel MaxWidth="1600" HorizontalAlignment="Stretch" Margin="28,24,28,48">

                                <!-- ========================================================================= -->
                <!-- 0. 10-SECOND STARTUP INTRO COUNTDOWN BANNER (AUTO HIDES AFTER INTRO)       -->
                <!-- ========================================================================= -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="18,12" Margin="0,0,0,20"
                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1.2"
                        Visibility="{Binding DataContext.IsStartupIntroActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Animated Rocket/Pulse Orb -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#161A26" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Headline & Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="WELCOME TO ERROR OPTIMIZER V3" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="STARTUP INTRO" FontSize="7.5" FontWeight="Bold" Foreground="#000000"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Explore system intelligence, verified tuning modules, and safety guardrails. Dashboard will open automatically."
                                       FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Countdown Pill -->
                        <Border Grid.Column="2" Background="#18000000" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DataContext.StartupIntroCountdownText, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Starting in 10s...'}"
                                           FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- 1. ABOUT ERROR OPTIMIZER HEADER (SPACIOUS & SHARP)       -->
                <!-- ======================================================== -->
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/app_logo.ico" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                        </Border>
                        <TextBlock Text="ABOUT ERROR OPTIMIZER" Style="{StaticResource PageTitleStyle}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Learn exactly what Error Optimizer changes, why it changes it, when it is applicable, and how every optimization is verified."
                               Style="{StaticResource PageSubtitleStyle}" FontSize="11.5" Margin="40,0,0,0" TextWrapping="Wrap" LineHeight="17"/>
                </StackPanel>

                <!-- ========================================================================= -->
                <!-- 2. SYSTEM VERIFIED & STABLE STATUS BANNER (SPACIOUS GLASS STRIP)          -->
                <!-- ========================================================================= -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="22,16" Margin="0,0,0,24"
                        Background="#121522" BorderBrush="{Binding SystemVerifiedBorderBrush, FallbackValue='#3310B981'}" BorderThickness="1.2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Indicator Container -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{Binding SystemVerifiedBgBrush, FallbackValue='#1A10B981'}"
                                BorderBrush="{Binding SystemVerifiedBorderBrush, FallbackValue='#4010B981'}" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{Binding SystemVerifiedBrush, FallbackValue='#10B981'}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{Binding SystemVerifiedGlowColor, FallbackValue='#10B981'}" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </StackPanel>
                        </Border>

                        <!-- Status Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SystemVerifiedStatusText, FallbackValue='SYSTEM VERIFIED &amp; STABLE'}"
                                           FontSize="13" FontWeight="Bold" Foreground="{Binding SystemVerifiedBrush, FallbackValue='#10B981'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Background="{DynamicResource AccentSelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="READY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SystemVerifiedSubtitle, FallbackValue='Core optimization engine &amp; background services operating at peak performance.'}"
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Integrity Badge -->
                        <Border Grid.Column="2" VerticalAlignment="Center" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="INTEGRITY: " FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="100% SECURE" FontSize="8.5" FontWeight="Bold" Foreground="{Binding SystemVerifiedBrush, FallbackValue='#10B981'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- 3. CONNECT WITH ERROR OPTIMIZER (OFFICIAL COMMUNITY CHANNELS)            -->
                <!-- ========================================================================= -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="26,24" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CONNECT WITH ERROR OPTIMIZER" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Official community, content and social channels."
                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 4 Official Social Platform Cards (Spacious Wrap) -->
                        <WrapPanel Orientation="Horizontal">

                            <!-- CARD 1: DISCORD -->
                            <Border Width="330" MinHeight="175" Margin="0,0,16,16" Style="{StaticResource GlassCardSmallStyle}" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Discord Logo + Title -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="#1A5865F2" BorderBrush="#445865F2" BorderThickness="1" Margin="0,0,12,0">
                                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Fill="#5865F2" Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.893a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="DISCORD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Community Server" FontSize="8.5" FontWeight="Bold" Foreground="#5865F2" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="Join the official Error Optimizer Discord community for real-time discussions, patch notes, and guides."
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,14"/>

                                    <!-- Action Button -->
                                    <Button Grid.Row="2" Content="JOIN DISCORD →" Command="{Binding OpenDiscordCommunityCommand}" Style="{StaticResource PillFilterButton}"
                                            HorizontalAlignment="Stretch" Padding="14,6" FontSize="9.5" FontWeight="Bold"
                                            Foreground="#5865F2" BorderBrush="#5865F2"/>
                                </Grid>
                            </Border>

                            <!-- CARD 2: YOUTUBE -->
                            <Border Width="330" MinHeight="175" Margin="0,0,16,16" Style="{StaticResource GlassCardSmallStyle}" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: YouTube Logo + Title -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="#1AFF0000" BorderBrush="#44FF0000" BorderThickness="1" Margin="0,0,12,0">
                                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Fill="#FF0000" Data="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="YOUTUBE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="@Errorfftamil" FontSize="8.5" FontWeight="Bold" Foreground="#FF0000" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="Watch official Error Optimizer videos, optimization breakdowns, benchmark tests, and guides."
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,14"/>

                                    <!-- Action Button -->
                                    <Button Grid.Row="2" Content="WATCH YOUTUBE →" Command="{Binding OpenYouTubeCommand}" Style="{StaticResource PillFilterButton}"
                                            HorizontalAlignment="Stretch" Padding="14,6" FontSize="9.5" FontWeight="Bold"
                                            Foreground="#FF0000" BorderBrush="#FF0000"/>
                                </Grid>
                            </Border>

                            <!-- CARD 3: INSTAGRAM -->
                            <Border Width="330" MinHeight="175" Margin="0,0,16,16" Style="{StaticResource GlassCardSmallStyle}" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Instagram Logo + Title -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="#1AE1306C" BorderBrush="#44E1306C" BorderThickness="1" Margin="0,0,12,0">
                                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Fill="#E1306C" Data="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="INSTAGRAM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="@errorexeff" FontSize="8.5" FontWeight="Bold" Foreground="#E1306C" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="Follow Error Optimizer on Instagram for product news, story highlights, and community updates."
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,14"/>

                                    <!-- Action Button -->
                                    <Button Grid.Row="2" Content="OPEN INSTAGRAM →" Command="{Binding OpenInstagramCommand}" Style="{StaticResource PillFilterButton}"
                                            HorizontalAlignment="Stretch" Padding="14,6" FontSize="9.5" FontWeight="Bold"
                                            Foreground="#E1306C" BorderBrush="#E1306C"/>
                                </Grid>
                            </Border>

                            <!-- CARD 4: KICK -->
                            <Border Width="330" MinHeight="175" Margin="0,0,16,16" Style="{StaticResource GlassCardSmallStyle}" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Kick Logo + Title -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="#1A53FC18" BorderBrush="#4453FC18" BorderThickness="1" Margin="0,0,12,0">
                                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Fill="#53FC18" Data="M3 2h5.5v7h3V2h5.5v7.5h-3.5v5H17V22h-5.5v-7h-3v7H3V2z"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="KICK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Live Streaming" FontSize="8.5" FontWeight="Bold" Foreground="#53FC18" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="Watch Error Optimizer live streams, developer sessions, and gaming latency tests."
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,14"/>

                                    <!-- Action Button -->
                                    <Button Grid.Row="2" Content="WATCH ON KICK →" Command="{Binding OpenKickCommand}" Style="{StaticResource PillFilterButton}"
                                            HorizontalAlignment="Stretch" Padding="14,6" FontSize="9.5" FontWeight="Bold"
                                            Foreground="#53FC18" BorderBrush="#53FC18"/>
                                </Grid>
                            </Border>

                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ========================================================================= -->
                <!-- 4. ERROR OPTIMIZER V3 — COMPATIBILITY & SYSTEM INFORMATION (SPACIOUS)     -->
                <!-- ========================================================================= -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="28,24" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Title Strip + Live Rescan Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AppTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                                    <Border Background="{DynamicResource AccentSelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersion}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Hardware Management, Latency Minimization &amp; OS Intelligence Engine" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Real-Time Hardware Rescan Trigger -->
                            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource PillFilterButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6"
                                    Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="11" Height="11" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource AccentBrush}" Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                    </Viewbox>
                                    <TextBlock Text="RESCAN HARDWARE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Real Hardware & Environment Telemetry Grid -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Local Machine, Architecture, Current OS, Windows Compatibility -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,16">
                                <TextBlock Text="LOCAL MACHINE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LocalMachine}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,16">
                                <TextBlock Text="PLATFORM ARCHITECTURE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Architecture}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,14,16">
                                <TextBlock Text="CURRENT OS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CurrentOs}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,16">
                                <TextBlock Text="WINDOWS COMPATIBILITY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding WindowsCompatibility}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Row 1: CPU, GPU, RAM, Power Source -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,16">
                                <TextBlock Text="CPU / PROCESSOR" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CpuName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CpuDetails}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,16">
                                <TextBlock Text="GRAPHICS ADAPTER (GPU)" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding GpuName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding GpuDriver}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,14,16">
                                <TextBlock Text="PHYSICAL MEMORY (RAM)" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RamInstalled}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RamUsable}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,16">
                                <TextBlock Text="POWER SOURCE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding PowerSource}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Row 2: Optimization Engine, Backend Service, Profile Engine, Transactional Backup -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="OPTIMIZATION ENGINE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding OptimizationEngineVersion}" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="BACKEND SERVICE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ServiceStatus}" FontSize="10.5" Foreground="#10B981" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,14,0">
                                <TextBlock Text="PROFILE ENGINE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ProfileEngineStatus}" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="3">
                                <TextBlock Text="TRANSACTIONAL BACKUP" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding BackupEngineStatus}" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- 5. OPTIMIZATION SUMMARY (SPACIOUS 7-COLUMN METRIC STRIP) -->
                <!-- ======================================================== -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="22,18" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TOTAL -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TOTAL CATALOG" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalOptimizations}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- APPLICABLE -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="APPLICABLE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ApplicableCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- OPTIMIZED -->
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="ALREADY OPT." FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding AlreadyOptimizedCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- PENDING -->
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="PENDING" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding PendingCount}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- SAFE -->
                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Text="SAFE" FontSize="8.5" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding SafeCount}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- MEDIUM -->
                        <StackPanel Grid.Column="5" Margin="0,0,8,0">
                            <TextBlock Text="MEDIUM RISK" FontSize="8.5" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding MediumRiskCount}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- HIGH -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="HIGH RISK" FontSize="8.5" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="{Binding HighRiskCount}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- 6. SYSTEM OPTIMIZATION PROFILES (SPACIOUS RESPONSIVE PROFILE CARDS)      -->
                <!-- ========================================================================= -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="28,26" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SYSTEM OPTIMIZATION PROFILES" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="7 Specialized Engine Profiles" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Profile Cards Responsive WrapPanel (360px per card with 18px gaps) -->
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="360" Margin="0,0,18,18" Style="{StaticResource GlassCardSmallStyle}" Padding="20,18" VerticalAlignment="Top">
                                        <StackPanel>
                                            <!-- Header: Icon + Title + Compact Semantic Risk Badge -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <controls:NavigationIcon Grid.Column="0" Icon="{Binding IconKey}" Size="18" IsActive="True" GlowEnabled="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <!-- Compact Semantic Risk Badge (Top-Right, Fixed Semantic Colors) -->
                                                <Border Grid.Column="2" CornerRadius="5" Padding="9,4" VerticalAlignment="Center"
                                                        Background="{Binding RiskSemanticSoftBg}" BorderBrush="{Binding RiskSemanticBorder}" BorderThickness="1">
                                                    <TextBlock Text="{Binding RiskClassificationText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding RiskSemanticBrush}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Description (Natural Wrap, No Empty Stretched Gap) -->
                                            <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,14"/>

                                            <!-- Dedicated Action Row: VIEW PROFILE + VIEW DETAILS -->
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Content="VIEW PROFILE →"
                                                        Command="{Binding ViewProfileCommand}"
                                                        Style="{StaticResource PillFilterButton}"
                                                        Padding="13,5" FontSize="9" FontWeight="Bold" Margin="0,0,10,4"
                                                        Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"/>

                                                <Button Content="VIEW DETAILS"
                                                        Command="{Binding DataContext.OpenProfileDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PillFilterButton}"
                                                        Padding="13,5" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"
                                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ========================================================================= -->
                <!-- 7. OPTIMIZATION CATALOG & KNOWLEDGE BASE (SPACIOUS RESPONSIVE CARDS)      -->
                <!-- ========================================================================= -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="28,26" Margin="0,0,0,24">
                    <StackPanel>

                        <!-- Section Header -->
                        <Grid Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="OPTIMIZATION CATALOG &amp; KNOWLEDGE BASE" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FilteredOptimizations.Count, StringFormat='Showing {0} of all registered optimizations'}"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- LOADING STATE PLACEHOLDER -->
                        <Border Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVis}}"
                                Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Loading Optimization Catalog &amp; Hardware Applicability..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Reading verified engine metadata asynchronously..." FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ERROR FALLBACK STATE -->
                        <Border Visibility="{Binding HasCatalogError, Converter={StaticResource BoolToVis}}"
                                Background="#1AEE5A5A" BorderBrush="#55EE5A5A" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#EE5A5A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="OPTIMIZATION CATALOG UNAVAILABLE" FontSize="13" FontWeight="Bold" Foreground="#EE5A5A" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CatalogErrorMessage}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                <Button Content="RETRY CATALOG LOAD" Command="{Binding RetryLoadCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Padding="18,6"/>
                            </StackPanel>
                        </Border>

                        <!-- LOADED CONTENT (SEARCH, FILTERS, SPACIOUS CARDS) -->
                        <StackPanel Visibility="{Binding IsCatalogLoaded, Converter={StaticResource BoolToVis}}">

                            <!-- Search & Filter Bar -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Input -->
                                <Border Grid.Column="0" Background="#121520" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                        <Button Grid.Column="2" Content="✕" Command="{Binding ClearSearchCommand}" Style="{StaticResource TitleBarCloseButton}"
                                                Width="18" Height="18" FontSize="9" Padding="0" Margin="4,0,0,0"
                                                Visibility="{Binding SearchQuery.Length, Converter={StaticResource CountToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Sort Selector -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="SORT:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Width="150"
                                              ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Category Filter Pills -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}" Margin="0,0,0,18">
                                <ItemsControl ItemsSource="{Binding AvailableCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Command="{Binding DataContext.SetCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PillFilterButton}"
                                                    Margin="0,0,8,0" Padding="14,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Catalog Cards Grid (Spacious Responsive Wrap: 360px per card with 18px gaps) -->
                            <ItemsControl ItemsSource="{Binding FilteredOptimizations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="360" Margin="0,0,18,18" Style="{StaticResource GlassCardStyle}" Padding="20,18" VerticalAlignment="Top">
                                            <StackPanel>
                                                <!-- Card Header: Category Icon + Optimization Name + Compact Semantic Risk Badge -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <controls:NavigationIcon Grid.Column="0" Icon="{Binding IconKey}" Size="18" IsActive="True" GlowEnabled="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <!-- Fixed Semantic Risk Badge (Top-Right, Compact Padding, Never Clipped) -->
                                                    <Border Grid.Column="2" CornerRadius="5" Padding="9,4" VerticalAlignment="Center"
                                                            Background="{Binding RiskSemanticSoftBg}" BorderBrush="{Binding RiskSemanticBorder}" BorderThickness="1">
                                                        <TextBlock Text="{Binding RiskClassificationText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding RiskSemanticBrush}" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Description (Natural Auto-Height, No Empty Stretched Gap) -->
                                                <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,12"/>

                                                <!-- Applicability & Status Strip (8-12px from description) -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category, StringFormat='CAT: {0}'}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Border>

                                                    <Border Grid.Column="2" Background="{Binding StatusBgBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusBrush}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Action Button: VIEW DETAILS (10-14px below status, perfectly proportioned) -->
                                                <Button Content="VIEW DETAILS →"
                                                        Command="{Binding DataContext.OpenOptimizationDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PillFilterButton}"
                                                        HorizontalAlignment="Stretch" Padding="14,6" FontSize="9.5" FontWeight="Bold"
                                                        Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================================================================================== -->
        <!-- PROFILE DETAIL MODAL LAYER (OPENS WHEN VIEW DETAILS IS CLICKED ON A PROFILE CARD)   -->
        <!-- ==================================================================================== -->
        <Grid Visibility="{Binding IsProfileModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10000">

            <!-- Modal Backdrop (Click to dismiss) -->
            <Border Background="#E003050B">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseModalCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Modal Dialog Card (Centered, Spacious, Razor Sharp, 3D Depth) -->
            <Border MaxWidth="900" MaxHeight="680" Margin="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#141724" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="14"
                    Padding="30,26" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.85"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MODAL HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                            <controls:NavigationIcon Icon="{Binding SelectedProfile.IconKey}" Size="22" IsActive="True" GlowEnabled="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title + Profile Badge -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedProfile.DisplayName, StringFormat='SYSTEM PROFILE: {0}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedProfile.OptimizationCountText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Fixed Semantic Risk Badge -->
                        <Border Grid.Column="2" CornerRadius="6" Padding="12,5" Margin="0,0,14,0" VerticalAlignment="Center"
                                Background="{Binding SelectedProfile.RiskSemanticSoftBg}"
                                BorderBrush="{Binding SelectedProfile.RiskSemanticBorder}" BorderThickness="1.2">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding SelectedProfile.RiskGlowColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedProfile.RiskIcon}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{Binding SelectedProfile.RiskSemanticBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedProfile.RiskClassificationText}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding SelectedProfile.RiskSemanticBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Close Button -->
                        <Button Grid.Column="3" Content="✕" Command="{Binding CloseModalCommand}" Style="{StaticResource TitleBarCloseButton}"
                                Width="32" Height="32" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- MODAL NAVIGATION STRIP (PREVIOUS / NEXT PROFILE) -->
                    <Border Grid.Row="1" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                        <Grid>
                            <Button Content="← PREVIOUS PROFILE" Command="{Binding PreviousProfileCommand}" IsEnabled="{Binding HasPreviousProfile}"
                                    Style="{StaticResource PillFilterButton}" HorizontalAlignment="Left" Padding="14,4" FontSize="9"/>

                            <TextBlock Text="{Binding SelectedProfile.ProfileId, StringFormat='PROFILE ID: {0}'}"
                                       FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Button Content="NEXT PROFILE →" Command="{Binding NextProfileCommand}" IsEnabled="{Binding HasNextProfile}"
                                    Style="{StaticResource PillFilterButton}" HorizontalAlignment="Right" Padding="14,4" FontSize="9"/>
                        </Grid>
                    </Border>

                    <!-- MODAL BODY (STRUCTURED PROFILE SECTIONS WITH INTERNAL SCROLLING) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}" MaxHeight="450">
                        <StackPanel Margin="0,0,12,0">

                            <!-- SECTION 1: PROFILE OVERVIEW & PURPOSE -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 1: PROFILE OVERVIEW &amp; TARGET SCOPE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedProfile.Description}" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: WHAT DOES IT DO? -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 2: WHAT DOES IT DO? (ENGINE BEHAVIOR &amp; SCHEDULING)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedProfile.WhatItDoes}" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: WHY IS IT USED? -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 3: WHY IS IT USED? (ENGINEERING RATIONALE &amp; WORKLOAD BENEFIT)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedProfile.WhyItExists}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: CATEGORIES CONTROLLED & SCOPE -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 4: SUBSYSTEMS &amp; CATEGORIES CONTROLLED" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <Border Background="#08FFFFFF" CornerRadius="5" Padding="12,8" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SelectedProfile.CategoriesControlled}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 5: APPLICABILITY & ENVIRONMENT REQUIREMENTS -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 5: APPLICABILITY &amp; HARDWARE ENVIRONMENT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                            <TextBlock Text="TARGET WORKLOAD / PROFILE SCOPE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedProfile.ApplicabilityText}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock Text="SUPPORTED HARDWARE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedProfile.SupportedHardware}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="SUPPORTED WINDOWS BUILDS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedProfile.SupportedWindows}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="VERIFICATION METHOD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedProfile.VerificationMethod}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 6: RISK CLASSIFICATION & SAFETY -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 6: RISK CLASSIFICATION &amp; SAFETY GUARANTEES" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Border Background="{Binding SelectedProfile.RiskSemanticSoftBg}" BorderBrush="{Binding SelectedProfile.RiskSemanticBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <TextBlock Text="{Binding SelectedProfile.RiskExplanation}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="15"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 7: BACKUP & ROLLBACK -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="SECTION 7: BACKUP &amp; TRANSACTIONAL ROLLBACK SUPPORT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SelectedProfile.BackupRollbackText}" FontSize="10" Foreground="#10B981" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- MODAL FOOTER -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="Press ESC or click outside to dismiss details." FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="NAVIGATE TO PROFILE →" Command="{Binding SelectedProfile.ViewProfileCommand}" Style="{StaticResource PillFilterButton}"
                                    Padding="16,7" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
                            <Button Content="CLOSE DETAILS" Command="{Binding CloseModalCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,7"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================================================================================== -->
        <!-- OPTIMIZATION DETAIL MODAL LAYER (OPENS WHEN VIEW DETAILS IS CLICKED ON A CARD)      -->
        <!-- ==================================================================================== -->
        <Grid Visibility="{Binding IsOptimizationModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10000">

            <!-- Modal Backdrop (Click to dismiss) -->
            <Border Background="#E003050B">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseModalCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Modal Dialog Card (Centered, Spacious, Razor Sharp, 3D Depth) -->
            <Border MaxWidth="900" MaxHeight="680" Margin="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#141724" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="14"
                    Padding="30,26" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.85"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MODAL HEADER -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                            <controls:NavigationIcon Icon="{Binding SelectedOptimization.IconKey}" Size="22" IsActive="True" GlowEnabled="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title + Domain -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedOptimization.Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedOptimization.Category, StringFormat='OPTIMIZATION DOMAIN: {0}'}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Fixed Semantic Risk Badge (Never changes with theme) -->
                        <Border Grid.Column="2" CornerRadius="6" Padding="12,5" Margin="0,0,14,0" VerticalAlignment="Center"
                                Background="{Binding SelectedOptimization.RiskSemanticSoftBg}"
                                BorderBrush="{Binding SelectedOptimization.RiskSemanticBorder}" BorderThickness="1.2">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding SelectedOptimization.RiskGlowColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedOptimization.RiskIcon}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{Binding SelectedOptimization.RiskSemanticBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedOptimization.RiskClassificationText}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding SelectedOptimization.RiskSemanticBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Close Button -->
                        <Button Grid.Column="3" Content="✕" Command="{Binding CloseModalCommand}" Style="{StaticResource TitleBarCloseButton}"
                                Width="32" Height="32" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- MODAL NAVIGATION STRIP (PREVIOUS / NEXT) -->
                    <Border Grid.Row="1" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                        <Grid>
                            <Button Content="← PREVIOUS" Command="{Binding PreviousOptimizationCommand}" IsEnabled="{Binding HasPreviousOptimization}"
                                    Style="{StaticResource PillFilterButton}" HorizontalAlignment="Left" Padding="14,4" FontSize="9"/>

                            <TextBlock Text="{Binding SelectedOptimization.OptimizationId, StringFormat='ID: {0}'}"
                                       FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Button Content="NEXT →" Command="{Binding NextOptimizationCommand}" IsEnabled="{Binding HasNextOptimization}"
                                    Style="{StaticResource PillFilterButton}" HorizontalAlignment="Right" Padding="14,4" FontSize="9"/>
                        </Grid>
                    </Border>

                    <!-- MODAL BODY (8 STRUCTURED SECTIONS WITH INTERNAL SCROLLING) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}" MaxHeight="450">
                        <StackPanel Margin="0,0,12,0">

                            <!-- SECTION 1: OVERVIEW & PURPOSE -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 1: OVERVIEW &amp; PURPOSE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedOptimization.Description}" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: WHAT DOES IT DO? -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 2: WHAT DOES IT DO? (EXACT BEHAVIORAL MODIFICATION)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedOptimization.DetailedExplanation}" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: WHY IS IT USED? -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 3: WHY IS IT USED? (ENGINEERING RATIONALE &amp; LATENCY JUSTIFICATION)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedOptimization.WhyItExists}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: WHAT IT CHANGES -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 4: WHAT IT CHANGES (SYSTEM SURFACE AREA &amp; KEYS)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <Border Background="#08FFFFFF" CornerRadius="5" Padding="12,8" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SelectedOptimization.AffectedSystemArea}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 5: CURRENT STATE vs TARGET OPTIMIZED STATE -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 5: CURRENT STATE vs TARGET OPTIMIZED STATE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="CURRENT VALUE / STATE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding SelectedOptimization.CurrentValue}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="TARGET OPTIMIZED VALUE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding SelectedOptimization.TargetValue}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 6: APPLICABILITY & REQUIREMENTS -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 6: APPLICABILITY &amp; HARDWARE ENVIRONMENT" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                            <TextBlock Text="SUPPORTED OS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.SupportedWindows}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                                            <TextBlock Text="ARCHITECTURE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.SupportedArchitecture}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                            <TextBlock Text="VENDOR SCOPE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.VendorScope}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="ADMIN PRIVILEGE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.RequiresAdmin, Converter={StaticResource BooleanToYesNoConverter}}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="RESTART REQUIRED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.RequiresRestart, Converter={StaticResource BooleanToYesNoConverter}}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="APPLICABILITY STATUS" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.ApplicabilityReason}" FontSize="9.5" Foreground="{Binding SelectedOptimization.StatusBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 7: RISK & SAFETY -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 7: RISK CLASSIFICATION &amp; SAFETY GUARANTEES" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Border Background="{Binding SelectedOptimization.RiskSemanticSoftBg}" BorderBrush="{Binding SelectedOptimization.RiskSemanticBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <TextBlock Text="{Binding SelectedOptimization.RiskExplanation}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="15"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 8: BACKUP & ROLLBACK -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 8: BACKUP &amp; TRANSACTIONAL ROLLBACK" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="PRE-EXECUTION SNAPSHOT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.BackupRequirement}" FontSize="9.5" Foreground="#10B981" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ROLLBACK SUPPORT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.RollbackSupport}" FontSize="9.5" Foreground="#10B981" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 9: POST-EXECUTION VERIFICATION -->
                            <Border Style="{StaticResource GlassCardSmallStyle}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="SECTION 9: POST-EXECUTION READBACK &amp; VERIFICATION" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="VERIFICATION METHOD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.VerificationMethod}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding SelectedOptimization.EvidenceSource, StringFormat='Ref: {0}'}" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="EXECUTION METHOD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedOptimization.ExecutionMethod}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- MODAL FOOTER -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="Press ESC or click outside to dismiss details." FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button Content="CLOSE DETAILS" Command="{Binding CloseModalCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="20,7"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
