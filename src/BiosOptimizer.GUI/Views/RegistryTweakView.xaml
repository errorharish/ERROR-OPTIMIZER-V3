<UserControl x:Class="BiosOptimizer.GUI.Views.RegistryTweakView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:conv="clr-namespace:BiosOptimizer.GUI.Converters"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ======================================================== -->
                <!-- ROW 0: PROFILE HEADER BANNER                             -->
                <!-- ======================================================== -->
                <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title & Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="REGISTRY INTELLIGENCE" Style="{StaticResource PageTitleStyle}" FontSize="18"/>
                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="LOW LATENCY &amp; SCHEDULING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Advanced Windows registry optimization categorized by CPU scheduling, MMCSS responsiveness, memory management, and telemetry reduction."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Risk Badge -->
                        <Border Grid.Column="2" VerticalAlignment="Center" Background="#1410B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="SAFE &amp; REVERSIBLE" FontSize="10" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- ROW 1: TOP PRIMARY MODE CONTROLLER (NORMAL / CUSTOM)     -->
                <!-- ======================================================== -->
                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="12,6" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentModeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding CurrentModeDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Mode Selectors: [REFRESH] [NORMAL] [CUSTOM] and [SWITCH BUTTON] -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="REFRESH" Command="{Binding ScanCommand}" Margin="0,0,6,0" Padding="14,6"
                                    Style="{StaticResource PillFilterButton}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{DynamicResource AccentBrush}"/>

                            <Button Content="NORMAL" Command="{Binding SwitchToNormalCommand}" Margin="0,0,6,0" Padding="14,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNormalMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="CUSTOM" Command="{Binding SwitchToCustomCommand}" Margin="0,0,8,0" Padding="14,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PillFilterButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{Binding ModeToggleText}" Style="{StaticResource PillFilterButton}"
                                    Command="{Binding ToggleViewModeCommand}" Padding="14,6"
                                    Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- ROW 2: DYNAMIC PRO TIP BANNER                            -->
                <!-- ======================================================== -->
                <Border Grid.Row="2" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO TIP" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Recommended registry settings are detected automatically and verified after application." 
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- ROW 3: MODE CONTENT SWITCHER                             -->
                <!-- ======================================================== -->
                <Grid Grid.Row="3">
                    
                    <!-- ==================================================== -->
                    <!-- NORMAL MODE VIEW: CLEAN, CONCISE, AUTOMATED          -->
                    <!-- ==================================================== -->
                    <StackPanel Visibility="{Binding IsNormalMode, Converter={StaticResource BoolToVis}}">
                        
                        <!-- Registry Health & Analysis Summary -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="270"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Registry Health Badge (No clipping, natural width) -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="REGISTRY HEALTH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding HealthStatus}" FontSize="18" FontWeight="Bold" Foreground="{Binding HealthStatusColor}" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                                    <TextBlock Text="Real-time configuration scan" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Separator -->
                                <Border Grid.Column="1" Background="#1FFFFFFF" Margin="0,4"/>

                                 <!-- Right: Metrics Overview (6 Distinct Columns) -->
                                <Grid Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Total" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding TotalCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Applicable" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding ApplicableCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Optimized" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding AlreadyOptimizedCount}" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Pending" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding PendingCount}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Not Applicable" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding NotApplicableCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="5">
                                        <TextBlock Text="Failed" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding FailedCount}" FontSize="16" FontWeight="Bold" Foreground="{Binding FailedCountBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Recommended Optimizations Section -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="RECOMMENDED OPTIMIZATIONS" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                                
                                <!-- Empty state when fully optimized -->
                                <Border Background="#1210B981" BorderBrush="#2A10B981" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,6"
                                        Visibility="{Binding IsFullyOptimized, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="System Registry is fully optimized. All supported performance parameters are active." FontSize="11" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Recommended items list: NO checkboxes! -->
                                <ItemsControl ItemsSource="{Binding RecommendedTweaks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Background="#14F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="12,0">
                                                        <TextBlock Text="{Binding RiskLevel, Mode=OneWay, StringFormat='Recommended • {0} Risk'}" FontSize="9" FontWeight="Bold" Foreground="#F59E0B"/>
                                                    </Border>

                                                    <!-- Details Button -->
                                                    <Button Grid.Column="2" Content="Details" Style="{StaticResource PillFilterButton}"
                                                            Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="12,4" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- What Normal Mode Optimizes -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="WHAT NORMAL MODE OPTIMIZES" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#06FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="⚡ CPU &amp; Scheduling" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Unparks CPU cores and tunes thread quantum prioritization for foreground tasks." FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#06FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="🎮 Gaming &amp; MMCSS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Disables network throttling and reduces background multimedia reservations." FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#06FFFFFF" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="💾 Memory &amp; System" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Enforces paging executive in RAM and optimizes SvcHost process thresholds." FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Normal Action Bar -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                        Content="↻ Scan Registry" Command="{Binding ScanCommand}" HorizontalAlignment="Left" Padding="16,8"/>

                                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding RunButtonText}" Command="{Binding ApplyCommand}" 
                                        IsEnabled="{Binding CanApply}" Padding="28,10" FontWeight="Bold" FontSize="13"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- CUSTOM MODE VIEW: ADVANCED INVENTORY & FULL CONTROL  -->
                    <!-- ==================================================== -->
                    <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
                        
                        <!-- Metric Cards Grid (6 Distinct Columns) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TOTAL" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Catalog tweaks" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="APPLICABLE" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding ApplicableCount}" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Supported on PC" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="SELECTED" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding SelectedCount}" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Manual selection" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="OPTIMIZED" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding AlreadyOptimizedCount}" Foreground="#10B981" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Verified optimal" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="8" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="NOT APPLICABLE" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding NotApplicableCount}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Unsupported/Absent" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="10" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="FAILED" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding FailedCount}" Foreground="{Binding FailedCountBrush}" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Attempt errors" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Custom Search and Category Filters -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Search Input Box -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0DFFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="#26FFFFFF" BorderThickness="1" Padding="12,8" FontSize="11"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    
                                    <TextBlock Text="🔍 Search registry optimizations..." IsHitTestVisible="False"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Category Filter Pills -->
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="ALL" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="ALL" Margin="0,0,6,6"/>
                                    <Button Content="RECOMMENDED" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="RECOMMENDED" Margin="0,0,6,6"/>
                                    <Button Content="OPTIMIZED" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="OPTIMIZED" Margin="0,0,6,6"/>
                                    <Button Content="NOT APPLICABLE" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="NOT APPLICABLE" Margin="0,0,6,6"/>
                                    <Button Content="CPU" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="CPU" Margin="0,0,6,6"/>
                                    <Button Content="MEMORY" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="Memory" Margin="0,0,6,6"/>
                                    <Button Content="NETWORK" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="Network" Margin="0,0,6,6"/>
                                    <Button Content="GAMING" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="Gaming" Margin="0,0,6,6"/>
                                    <Button Content="GPU" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="GPU" Margin="0,0,6,6"/>
                                    <Button Content="PRIVACY" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="Privacy" Margin="0,0,6,6"/>
                                    <Button Content="TELEMETRY" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="Telemetry" Margin="0,0,6,6"/>
                                    <Button Content="INPUT" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="Input" Margin="0,0,6,6"/>
                                    <Button Content="POWER" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="Power" Margin="0,0,6,6"/>
                                    <Button Content="NTFS" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="NTFS" Margin="0,0,6,6"/>
                                    <Button Content="SYSTEM" Style="{StaticResource PillFilterButton}" Command="{Binding SetFilterCommand}" CommandParameter="System" Margin="0,0,6,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Custom Action Toolbar & Bulk Controls -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Button Style="{StaticResource PillFilterButton}"
                                            Content="{Binding BulkSelectLabel}" Command="{Binding SelectAllCommand}" Margin="0,0,6,4" Padding="12,6"/>

                                    <Button Style="{StaticResource PillFilterButton}"
                                            Content="DESELECT ALL" Command="{Binding DeselectAllCommand}" Margin="0,0,10,4" Padding="12,6"/>

                                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCountText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="↻ Scan" Command="{Binding ScanCommand}" Margin="0,0,6,4" Padding="10,5"/>
                                    
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="💾 Save Profile" Command="{Binding SaveCustomProfileCommand}" Margin="0,0,6,4" Padding="10,5"/>
                                </WrapPanel>

                                <!-- Main Custom Optimization Button -->
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding RunButtonText}" Command="{Binding ApplyCommand}" 
                                        IsEnabled="{Binding CanApply}" Padding="20,8" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Full Registry Optimization Targets Inventory List -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="REGISTRY OPTIMIZATION TARGETS" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FilteredTweaks.Count, StringFormat='{}{0} Shown'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <ListView Grid.Row="1" ItemsSource="{Binding FilteredTweaks}" Background="Transparent" BorderThickness="0"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="0,0,0,0">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#08FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#14FFFFFF"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Selection Checkbox: Active in Custom Mode -->
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    
                                                    <!-- Details & Name -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <Border Background="#1AFFFFFF" CornerRadius="3" Padding="5,1" Margin="6,0,4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="8" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border Background="#14FFFFFF" CornerRadius="3" Padding="5,1" Margin="2,0,4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RiskLevel, Mode=OneWay}" Foreground="{Binding RiskBrush}" FontSize="8" FontWeight="Bold"/>
                                                            </Border>
                                                            <!-- SELECTED Indicator Badge -->
                                                            <Border Background="{DynamicResource AccentSelectionBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="SELECTED" Foreground="{DynamicResource AccentBrush}" FontSize="8" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="30" TextTrimming="WordEllipsis"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Current Value -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0" MinWidth="95">
                                                        <TextBlock Text="CURRENT" Foreground="{StaticResource TextMutedBrush}" FontSize="8" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding CurrentValue}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" MaxWidth="95" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Target Value -->
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0" MinWidth="95">
                                                        <TextBlock Text="TARGET" Foreground="{StaticResource TextMutedBrush}" FontSize="8" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding TargetValue}" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" MaxWidth="95" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Status Badge -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="90" Margin="6,0">
                                                        <TextBlock Text="STATUS" Foreground="{StaticResource TextMutedBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,0,0" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Details Button -->
                                                    <Button Grid.Column="5" Content="Details" Style="{StaticResource PillFilterButton}"
                                                            Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,3" VerticalAlignment="Center" FontSize="10"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Activity Log -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="ACTIVITY LOG" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                                <ScrollViewer Height="60" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding LiveLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="10" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- DETAILS DIALOG OVERLAY (FOR NORMAL & CUSTOM MODE DETAILS)    -->
        <!-- ============================================================ -->
        <Grid Background="#B3000000" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource GlassCardStyle}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="#F0111113" BorderBrush="#40FFFFFF">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Optimization Transparency Details" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource PillFilterButton}" Command="{Binding CloseDetailsCommand}" Padding="8,2"/>
                    </Grid>

                    <Border Background="#0DFFFFFF" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDetailsItem.Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                <Border Background="#1AFFFFFF" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedDetailsItem.Category}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Background="#14FFFFFF" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedDetailsItem.RiskLevel, Mode=OneWay, StringFormat='Risk: {0}'}" FontSize="9" FontWeight="Bold" Foreground="{Binding SelectedDetailsItem.RiskBrush}"/>
                                </Border>
                                <Border Background="#10FFFFFF" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="{Binding SelectedDetailsItem.WindowsCompatibility}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                            </StackPanel>
                            
                            <TextBlock Text="Purpose &amp; Description:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding SelectedDetailsItem.Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Technical Registry Metadata -->
                            <TextBlock Text="Technical Registry Location:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,2"/>
                            <Border Background="#14000000" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedDetailsItem.FullKeyPath, StringFormat='Path: {0}'}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedDetailsItem.ValueName, StringFormat='Value Name: {0}'}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedDetailsItem.ValueType, StringFormat='Type: {0}'}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Current Detected State" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedDetailsItem.CurrentValue}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Optimization Target" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedDetailsItem.TargetValue}" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding SelectedDetailsItem.RequiresRebootDisplay, StringFormat='System Restart Required: {0}'}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedDetailsItem.ApplicabilityReason, StringFormat='Applicability Rationale: {0}'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedDetailsItem.RollbackAvailable, StringFormat='Rollback: {0}'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedDetailsItem.VerificationMethod, StringFormat='Verification: {0}'}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CloseDetailsCommand}" HorizontalAlignment="Right" Padding="20,6"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- REAL-TIME OPTIMIZATION PROGRESS MODAL                        -->
        <!-- ============================================================ -->
        <Grid Background="#CC000000" Visibility="{Binding IsProgressModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource GlassCardStyle}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="#F0111113" BorderBrush="{DynamicResource AccentBorderBrush}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ProgressTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ProgressStatusText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Real Percentage Progress Bar -->
                    <Border Background="#1AFFFFFF" CornerRadius="4" Height="8" Margin="0,0,0,16">
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="8" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"/>
                    </Border>

                    <!-- Multi-Stage Indicators -->
                    <Border Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="1. ANALYZING" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StageAnalyzing}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="2. BACKING UP" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StageBackup}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="3. APPLYING" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StageApply}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="4. VERIFYING" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StageVerify}" FontSize="9" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="5. FINALIZING" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StageFinalize}" FontSize="9" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Live Current Action Card -->
                    <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CURRENT ACTION" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CurrentActionName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding CurrentActionTarget}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentActionStatus}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Completed Summary Result (Shown when optimization finishes) -->
                    <Border Background="#1210B981" BorderBrush="#2A10B981" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding IsOptimizationFinished, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Applied" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ProgressAppliedCount}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Verified" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ProgressVerifiedCount}" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Failed" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ProgressFailedCount}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Rollback" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="Available" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Done Button -->
                    <Button Content="DONE" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CloseProgressModalCommand}"
                            IsEnabled="{Binding IsOptimizationFinished}" HorizontalAlignment="Right" Padding="28,8" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

