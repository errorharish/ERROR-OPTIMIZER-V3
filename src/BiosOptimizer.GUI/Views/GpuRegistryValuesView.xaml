<UserControl x:Class="BiosOptimizer.GUI.Views.GpuRegistryValuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             xmlns:vm="clr-namespace:BiosOptimizer.GUI.ViewModels"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <!-- Main Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource SlimScrollViewer}">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><!-- 0: Header -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 2: Hardware Architecture Card -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/><!-- 4: Profile & Statistics Bar -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/><!-- 6: Main Sections: Universal, NVIDIA, AMD, Diagnostic -->
                </Grid.RowDefinitions>

                <!-- ============================================================
                     1. HEADER
                     ============================================================ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <controls:NavigationIcon Icon="GpuRegistryValues" IsActive="True" Size="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="GPU REGISTRY VALUES" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Hardware-aware GPU registry configuration, optimization and verification."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Top-Right Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RescanGpuCommand}" Height="32" Padding="14,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RESCAN GPU" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyAllRecommendedCommand}" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="APPLY ALL RECOMMENDED" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================================================
                     2. DETECTED GPU HARDWARE CARD
                     ============================================================ -->
                <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Title & Badge -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="{DynamicResource AccentOverlayBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock Text="DETECTED GRAPHICS HARDWARE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding GpuName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource AccentOverlayBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding VendorStatusBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Hardware Details Grid -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.8*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,8">
                                <TextBlock Text="GPU Vendor" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding GpuVendor}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,8">
                                <TextBlock Text="Driver Version &amp; Date" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DriverVersion}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DriverDate}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,8">
                                <TextBlock Text="WDDM Architecture" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding WddmVersion}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding GpuType}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,0,8">
                                <TextBlock Text="OS Environment" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding OsName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OsVersionDetails}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Hardware Preemption Ready" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============================================================
                     3. PROFILE SELECTOR & METRICS SUMMARY BAR
                     ============================================================ -->
                <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Profile Dropdown & Explanation -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PROFILE POLICY:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          Width="160" Height="30"
                                          Style="{StaticResource FlatComboBox}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ProfilePolicyExplanation}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>

                        <!-- Statistics Badges -->
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="#1500E5FF" BorderBrush="#3000E5FF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ApplicableCount, StringFormat='APPLICABLE: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <Border Background="#1500E676" BorderBrush="#3000E676" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding OptimizedCount, StringFormat='OPTIMIZED: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>

                            <Border Background="#15FFD600" BorderBrush="#30FFD600" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding PendingCount, StringFormat='PENDING: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>

                            <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding NotApplicableCount, StringFormat='NOT APPLICABLE: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>

                            <Border Background="#15FF5252" BorderBrush="#30FF5252" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="{Binding DiagnosticCount, StringFormat='DIAGNOSTIC ONLY: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- ============================================================
                     4. OPTIMIZATION SECTIONS: NORMAL VS CUSTOM
                     ============================================================ -->
                <StackPanel Grid.Row="6">

                    <!-- ============================================================
                         4A. NORMAL MODE: EXACTLY 3 VENDOR GROUPS
                         ============================================================ -->
                    <StackPanel Visibility="{Binding IsNormalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="HARDWARE-AWARE OPTIMIZATION GROUPS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>

                        <!-- ── GROUP 1: UNIVERSAL GPU ── -->
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,14" Padding="20,16" Opacity="{Binding UniversalGroup.CardOpacity}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Group Name, Subtitle, Status Badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="UNIVERSAL GPU" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#1500E5FF" BorderBrush="#3000E5FF" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="SYSTEM-WIDE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{DynamicResource AccentOverlayBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding UniversalGroup.StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- Middle Row: Subtitle & Description -->
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding UniversalGroup.Subtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding UniversalGroup.Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Bottom Row: Metrics & Optimization Button -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1500E5FF" BorderBrush="#3000E5FF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding UniversalGroup.ApplicableCount, StringFormat='APPLICABLE: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#1500E676" BorderBrush="#3000E676" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding UniversalGroup.OptimizedCount, StringFormat='OPTIMIZED: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                        <Border Background="#15FFD600" BorderBrush="#30FFD600" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding UniversalGroup.PendingCount, StringFormat='PENDING: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        </Border>
                                    </WrapPanel>

                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding OptimizeUniversalGroupCommand}"
                                            IsEnabled="{Binding UniversalGroup.CanOptimize}"
                                            Height="32" Padding="16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UniversalGroup.ButtonText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ── GROUP 2: NVIDIA GPU ── -->
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,14" Padding="20,16" Opacity="{Binding NvidiaGroup.CardOpacity}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Group Name, Subtitle, Status Badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#76B900" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="NVIDIA GPU" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#1576B900" BorderBrush="#3076B900" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="GEFORCE / RTX" FontSize="9" FontWeight="Bold" Foreground="#76B900"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#1576B900" BorderBrush="#3076B900" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding NvidiaGroup.StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="#76B900"/>
                                    </Border>
                                </Grid>

                                <!-- Middle Row: Subtitle & Description -->
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding NvidiaGroup.Subtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding NvidiaGroup.Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Bottom Row: Metrics & Optimization Button -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1500E5FF" BorderBrush="#3000E5FF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding NvidiaGroup.ApplicableCount, StringFormat='APPLICABLE: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#1500E676" BorderBrush="#3000E676" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding NvidiaGroup.OptimizedCount, StringFormat='OPTIMIZED: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                        <Border Background="#15FFD600" BorderBrush="#30FFD600" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding NvidiaGroup.PendingCount, StringFormat='PENDING: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        </Border>
                                    </WrapPanel>

                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding OptimizeNvidiaGroupCommand}"
                                            IsEnabled="{Binding NvidiaGroup.CanOptimize}"
                                            Height="32" Padding="16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding NvidiaGroup.ButtonText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ── GROUP 3: AMD GPU ── -->
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,14" Padding="20,16" Opacity="{Binding AmdGroup.CardOpacity}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Group Name, Subtitle, Status Badge -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#ED1C24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="AMD GPU" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#15ED1C24" BorderBrush="#30ED1C24" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="RADEON / ADRENALIN" FontSize="9" FontWeight="Bold" Foreground="#ED1C24"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#15ED1C24" BorderBrush="#30ED1C24" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding AmdGroup.StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="#ED1C24"/>
                                    </Border>
                                </Grid>

                                <!-- Middle Row: Subtitle & Description -->
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding AmdGroup.Subtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding AmdGroup.Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Bottom Row: Metrics & Optimization Button -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1500E5FF" BorderBrush="#3000E5FF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding AmdGroup.ApplicableCount, StringFormat='APPLICABLE: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#1500E676" BorderBrush="#3000E676" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding AmdGroup.OptimizedCount, StringFormat='OPTIMIZED: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                        <Border Background="#15FFD600" BorderBrush="#30FFD600" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding AmdGroup.PendingCount, StringFormat='PENDING: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        </Border>
                                    </WrapPanel>

                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding OptimizeAmdGroupCommand}"
                                            IsEnabled="{Binding AmdGroup.CanOptimize}"
                                            Height="32" Padding="16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AmdGroup.ButtonText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ============================================================
                         4B. CUSTOM MODE: INDIVIDUAL SELECTABLE OPTIMIZATIONS
                         ============================================================ -->
                    <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        
                        <!-- Custom Selection Toolbar -->
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedSummaryText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllApplicableCommand}" Height="28" Padding="10,0" Margin="0,0,8,0">
                                        <TextBlock Text="SELECT ALL APPLICABLE" FontSize="10" FontWeight="Bold"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeselectAllCommand}" Height="28" Padding="10,0">
                                        <TextBlock Text="CLEAR SELECTION" FontSize="10" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ApplySelectedCommand}"
                                        IsEnabled="{Binding HasSelectedCandidates}"
                                        Height="32" Padding="16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="APPLY SELECTED" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ── SECTION 1: UNIVERSAL GPU REGISTRY ── -->
                        <TextBlock Text="UNIVERSAL GPU REGISTRY OPTIMIZATIONS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding UniversalItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10" Padding="16,14" Opacity="{Binding CardOpacity}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top Row: CheckBox, Name, SubCategory, Risk, Status -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SubCategory}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="{DynamicResource AccentOverlayBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding RiskLevel, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                    <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2">
