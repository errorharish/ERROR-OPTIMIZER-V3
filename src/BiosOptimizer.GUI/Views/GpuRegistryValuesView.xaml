                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Current Value" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedDetailsItem.CurrentValueDisplay}" FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Target Calculated Value" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedDetailsItem.TargetValueDisplay}" FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Rationale -->
                            <TextBlock Text="APPLICABILITY &amp; RECOMMENDATION RATIONALE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,8"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Why Applicable:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedDetailsItem.WhyApplicable}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                <TextBlock Text="Why Recommended:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedDetailsItem.WhyRecommended}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Safety & Verification -->
                            <TextBlock Text="SAFETY &amp; VERIFICATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,8"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Risk Classification:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDetailsItem.RiskLevel, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Restart Required:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2">
                                    <Run Text="{Binding SelectedDetailsItem.RequiresRestart, Converter={StaticResource BooleanToYesNoConverter}}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Verification Method:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDetailsItem.VerificationMethod}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Actions -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding ApplyItemCommand}"
                                CommandParameter="{Binding SelectedDetailsItem}"
                                IsEnabled="{Binding SelectedDetailsItem.CanApply}"
                                Height="30" Padding="14,0" Margin="0,0,8,0">
                            <TextBlock Text="APPLY" FontSize="11" FontWeight="Bold"/>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding RestoreItemCommand}"
                                CommandParameter="{Binding SelectedDetailsItem}"
                                IsEnabled="{Binding SelectedDetailsItem.CanRestore}"
                                Height="30" Padding="14,0" Margin="0,0,8,0">
                            <TextBlock Text="RESTORE" FontSize="11" FontWeight="Bold"/>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                Command="{Binding CloseDetailsCommand}"
                                Height="30" Padding="14,0">
                            <TextBlock Text="CLOSE" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
