                                                        <TextBlock Text="Current: " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding CurrentValueDisplay}" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,20,0"/>

