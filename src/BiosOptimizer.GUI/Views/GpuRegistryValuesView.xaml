                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Optimization ID:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDetailsItem.Id}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Registry Path:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDetailsItem.RegistryPath}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Value Name / Type:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2">
                                    <Run Text="{Binding SelectedDetailsItem.ValueName, Mode=OneWay}"/>
                                    <Run Text=" ("/><Run Text="{Binding SelectedDetailsItem.ValueTypeString, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/><Run Text=")"/>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hardware &amp; Driver:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2">
                                    <Run Text="{Binding SelectedDetailsItem.HardwareRequirement, Mode=OneWay}"/>
                                    <Run Text=" | "/><Run Text="{Binding SelectedDetailsItem.DriverRequirement, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                                </TextBlock>
                            </Grid>

                            <!-- Current vs Target -->
                            <TextBlock Text="VALUE STATES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,8"/>
                            <Border Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
