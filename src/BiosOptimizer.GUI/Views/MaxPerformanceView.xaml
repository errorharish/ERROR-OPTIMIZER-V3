<UserControl x:Class="BiosOptimizer.GUI.Views.MaxPerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
        <Grid Margin="28,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Max Performance" Style="{StaticResource PageTitleStyle}"/>
                        <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,3"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="HIGH RISK" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Extreme performance preset. Maximizes workload scheduling at the cost of power efficiency." 
                               Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>
                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding PreviewCommand}" Margin="0,0,8,0" Padding="16,10">
                        <TextBlock Text="Preview" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ApplyCommand}" Margin="0,0,8,0" Padding="16,10">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="White"
                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                            <TextBlock Grid.Column="1" Text="Apply" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Preview Panel -->
            <Border Grid.Row="4" Style="{StaticResource GlassCardStyle}"
                    Visibility="{Binding HasPreview}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Optimization Preview" Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Preview}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- Result output -->
            <Border Grid.Row="6" Style="{StaticResource GlassCardStyle}"
                    Visibility="{Binding HasResult}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Result" Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,12"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource SlimScrollViewer}">
                        <TextBlock Text="{Binding Result}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontFamily="Cascadia Mono, Consolas"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

