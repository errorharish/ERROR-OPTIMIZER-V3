<Window x:Class="BiosOptimizer.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BiosOptimizer.GUI"
        xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls"
        Title="Error Optimizer Pro" Icon="Assets/app_logo.ico" Height="780" Width="1280"
        MinHeight="680" MinWidth="1100"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Root Border: Real Window Glass/Opaque Panel with Rounded Corners -->
    <Border x:Name="RootBorder" Background="{DynamicResource BgRootBrush}"
            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1.2" CornerRadius="14" ClipToBounds="True">
        
        <Grid>
            <!-- ========================================== -->
            <!-- ADVANCED DYNAMIC HARDWARE-ACCELERATED BG   -->
            <!-- ========================================== -->
            <controls:ErrorOptimizerBackground x:Name="DynamicBackground" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                         IsHitTestVisible="False"/>



            <!-- ========================================== -->
            <!-- 2. LAYOUT                                  -->
            <!-- ========================================== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TitleBar -->
                <Border Grid.Row="0" Background="#1A000000" BorderBrush="#11FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                            <Border Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/app_logo.ico"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ERROR OPTIMIZER V3" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,0,0">
                                    <Run Text="BUILD ID: "/><Run Text="{Binding GuiBuildId, Mode=OneWay, FallbackValue='20260826'}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Status Indicator (Center) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0" x:Name="StatusDot" Fill="{Binding StatusBrush, FallbackValue=#10B981}">
                            </Ellipse>
                            <TextBlock x:Name="StatusLabel" Text="{Binding StatusText, FallbackValue='Service Connected'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- Window Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="46" Style="{StaticResource TitleBarWindowButton}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                            <Button x:Name="MaxRestoreButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="46" Style="{StaticResource TitleBarWindowButton}" Click="MaximizeButton_Click" ToolTip="Maximize"/>
                            <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="46" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                                        <!-- Sidebar -->
                    <Border Grid.Column="0" Background="#11000000" BorderBrush="#0AFFFFFF" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}" Margin="0,10,0,10"
                                      IsEnabled="{Binding IsNavigationUnlocked}">
                            <StackPanel Margin="0,0,0,16">

                                <!-- 1. MONITOR -->
                                <TextBlock Text="MONITOR" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="20,10,20,4" />
                                <RadioButton Tag="Dashboard" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                                <RadioButton Tag="ProcessReduction" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Process Intelligence" Command="{Binding NavigateCommand}" CommandParameter="ProcessReduction"/>
                                <RadioButton Tag="InputOptimizer" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Input Optimizer" Command="{Binding NavigateCommand}" CommandParameter="InputOptimizer"/>
                                <RadioButton Tag="SystemInfo" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="System Telemetry" Command="{Binding NavigateCommand}" CommandParameter="SystemInfo"/>

                                <Border Height="1" Background="#0AFFFFFF" Margin="20,10"/>

                                <!-- 2. WINDOWS TWEAKS -->
                                <TextBlock Text="WINDOWS TWEAKS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="20,4,20,4" />
                                <RadioButton Tag="RegistryTweak" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Registry Tweaks" Command="{Binding NavigateCommand}" CommandParameter="RegistryTweak"/>
                                <RadioButton Tag="RegistryValues" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Registry Values" Command="{Binding NavigateCommand}" CommandParameter="RegistryValues"/>

                                <Border Height="1" Background="#0AFFFFFF" Margin="20,10"/>

                                <!-- 3. TOOLS -->
                                <TextBlock Text="TOOLS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="20,4,20,4" />
                                <RadioButton Tag="StartupManager" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Startup Manager" Command="{Binding NavigateCommand}" CommandParameter="StartupManager"/>
                                <RadioButton Tag="ServiceManager" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Service Manager" Command="{Binding NavigateCommand}" CommandParameter="ServiceManager"/>
                                <RadioButton Tag="Network" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Network" Command="{Binding NavigateCommand}" CommandParameter="Network"/>
                                <RadioButton Tag="Storage" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Storage" Command="{Binding NavigateCommand}" CommandParameter="Storage"/>
                                <RadioButton Tag="Tools" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Tools" Command="{Binding NavigateCommand}" CommandParameter="Tools"/>

                                <Border Height="1" Background="#0AFFFFFF" Margin="20,10"/>

                                <!-- 4. OPTIMIZE PROFILES -->
                                <TextBlock Text="OPTIMIZE PROFILES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="20,4,20,4" />
                                <RadioButton Tag="Normal" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Normal" Command="{Binding NavigateCommand}" CommandParameter="Normal"/>
                                <RadioButton Tag="Pro" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Pro" Command="{Binding NavigateCommand}" CommandParameter="Pro"/>
                                <RadioButton Tag="Ultimate" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Ultimate" Command="{Binding NavigateCommand}" CommandParameter="Ultimate"/>
                                <RadioButton Tag="Debloat" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Debloat" Command="{Binding NavigateCommand}" CommandParameter="Debloat"/>
                                <RadioButton Tag="BiosSafe" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="BIOS Safe" Command="{Binding NavigateCommand}" CommandParameter="BiosSafe"/>
                                <RadioButton Tag="MaxPerformance" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Max Performance" Command="{Binding NavigateCommand}" CommandParameter="MaxPerformance"/>
                                <RadioButton Tag="AiOptimization" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="AI Optimization" Command="{Binding NavigateCommand}" CommandParameter="AiOptimization"/>

                                <Border Height="1" Background="#0AFFFFFF" Margin="20,10"/>

                                <!-- 5. SYSTEM PROFILES -->
                                <TextBlock Text="SYSTEM PROFILES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="20,4,20,4" />
                                <RadioButton Tag="BackupRestore" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Backups" Command="{Binding NavigateCommand}" CommandParameter="BackupRestore"/>
                                <RadioButton Tag="Settings" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                                <RadioButton Tag="About" GroupName="SidebarNav" Style="{StaticResource PremiumSidebarItem}" Content="About" Command="{Binding NavigateCommand}" CommandParameter="About"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Content Presenter -->
                    <Border Grid.Column="1" Background="Transparent" ClipToBounds="False">
                        <!-- We use a ContentControl bound to the CurrentView in ViewModel, or handled via code-behind. 
                             The current code-behind sets PageContent.Content. Let's keep x:Name="PageContent" -->
                        <controls:PageTransitionHost x:Name="PageContent" Margin="10">
                            <!-- We can set a fallback style if no view template is found, but normally DataTemplates handle this -->
                        </controls:PageTransitionHost>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- UNIVERSAL OPTIMIZATION MODAL (GLOBAL)      -->
            <!-- ========================================== -->
            <controls:UniversalOptimizationModal HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="10000"/>

            <!-- ========================================== -->
            <!-- TOPMOST APPLICATION CURSOR HOST LAYER      -->
            <!-- ========================================== -->
            <controls:ErrorOptimizerCursor x:Name="CursorOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           IsHitTestVisible="False" Panel.ZIndex="999999"/>
        </Grid>
    </Border>
</Window>

