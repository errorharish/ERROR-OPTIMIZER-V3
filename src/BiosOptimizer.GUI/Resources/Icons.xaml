    <!-- Reusable icon Path style -->
    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

    <Style x:Key="IconPathAccentStyle" BasedOn="{StaticResource IconPathStyle}" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style x:Key="IconPathActiveStyle" BasedOn="{StaticResource IconPathStyle}" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>

