    <!-- SuccessButtonStyle (Universal 3D Green Success Action Button) -->
    <Style x:Key="SuccessButtonStyle" TargetType="Button" x:Shared="False">
        <Setter Property="controls:Premium3DButtonBehavior.IsEnabled" Value="True"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#059669"/>
        <Setter Property="BorderBrush" Value="#10B981"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="BtnTranslate" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Border x:Name="Shadow" CornerRadius="8" Background="#000000" Opacity="0.25" Margin="0,1,0,0">
                            <Border.Effect>
                                <DropShadowEffect x:Name="SuccessGlow" Color="#10B981" BlurRadius="10" ShadowDepth="1.5" Opacity="0.25"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1.2"
                                Background="#059669"
                                BorderBrush="#10B981"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Height="12" VerticalAlignment="Top" CornerRadius="7,7,0,0" Opacity="0.22">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#10B981"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6EE7B7"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnTranslate" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SuccessGlow" Storyboard.TargetProperty="Opacity" To="0.70" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="SuccessGlow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SuccessGlow" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="SuccessGlow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#047857"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnTranslate" Storyboard.TargetProperty="Y" To="1.5" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A40"/>
                            <Setter Property="Foreground" Value="#666670"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

