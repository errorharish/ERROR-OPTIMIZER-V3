<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:BiosOptimizer.GUI.Converters"
                    xmlns:controls="clr-namespace:BiosOptimizer.GUI.Controls">

    <!-- ============================================================
         GLOBAL CONVERTERS
         ============================================================ -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    <conv:BoolToCheckmarkConverter x:Key="BoolToCheckmarkConverter"/>
    <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
    <conv:StatusToFooterConverter x:Key="StatusToFooterConverter"/>
    <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
    <conv:BoolToDetailsTextConverter x:Key="BoolToDetailsTextConverter"/>
    <conv:InverseNullOrEmptyToVisibilityConverter x:Key="InverseNullOrEmptyToVis"/>
    <conv:BooleanToYesNoConverter x:Key="BooleanToYesNoConverter"/>

    <!-- ============================================================
         GLOBAL THEME ACCENT COLOR SYSTEM (DYNAMIC RUNTIME RESOLUTION)
         ============================================================ -->

    <!-- Ambient / Background -->
    <Color x:Key="AppBackgroundColor">#09090A</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="BgRootBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="BgWindowBrush" Color="{StaticResource AppBackgroundColor}"/>

    <!-- Base Colors -->
    <Color x:Key="BrandPrimaryColor">#E53935</Color>
    <Color x:Key="BrandAccentColor">#FF5252</Color>

    <!-- Derived Accent Brushes (ThemeBrushService updates these in App.Resources at runtime) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5252"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B71C1C"/>
    <SolidColorBrush x:Key="AccentFocusBrush" Color="#FF5252"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#22E53935"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#55E53935"/>
    <SolidColorBrush x:Key="AccentBorderSubtleBrush" Color="#33E53935"/>
    <SolidColorBrush x:Key="AccentProgressBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="#35E53935"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#60E53935"/>
    <SolidColorBrush x:Key="AccentGlowStrongBrush" Color="#99E53935"/>
    <SolidColorBrush x:Key="AccentContrastTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentOverlayBrush" Color="#14E53935"/>
    <SolidColorBrush x:Key="AccentSliderBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentToggleBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentTrackBrush" Color="#22E53935"/>

    <!-- Compatibility aliases -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="AccentBrushDark" Color="#B71C1C"/>
    <SolidColorBrush x:Key="AccentBrushLight" Color="#FF5252"/>
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="GlowBrush" Color="#60E53935"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5252" Offset="0"/>
        <GradientStop Color="#B71C1C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Sidebar / Surface -->
    <Color x:Key="SidebarBackgroundColor">#101012</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2A2A32"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#1AFFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B0B3BA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#999999"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A0"/>

    <!-- Strictly Isolated Semantic Status Colors (Never replaced by user accent) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusGreenBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="StatusAmberBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusRedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusBlueBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="#00BCD4"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1AF59E0B"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1AEF4444"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1A10B981"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1A3B82F6"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#33F59E0B"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#33EF4444"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#3310B981"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#333B82F6"/>

    <!-- Surfaces & Cards -->
    <SolidColorBrush x:Key="BgCardBrush" Color="#B3141414"/>
    <SolidColorBrush x:Key="BgBaseBrush" Color="#0C0D11"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="BorderNormalBrush" Color="#1A1C23"/>

    <!-- ============================================================
         GLOBAL TYPOGRAPHY & HEADER STYLES
         ============================================================ -->
    <Style x:Key="DataText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="controls:NeonTypographyBehavior.Level" Value="CardTitle"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="controls:NeonTypographyBehavior.Level" Value="Heading"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="controls:NeonTypographyBehavior.Level" Value="Subheading"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,15,0,10"/>
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="controls:NeonTypographyBehavior.Level" Value="Value"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Explicit Modular Neon Styles (NEON-IFRAME-TEMPLATE Architecture) -->
    <Style x:Key="NeonHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleStyle}"/>
    
    <Style x:Key="NeonSubheadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}"/>
    
    <Style x:Key="NeonValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}"/>
    
    <Style x:Key="NeonCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}"/>

    <Style x:Key="NeonBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentOverlayBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============================================================
         GLASS CARD & PANEL STYLES (TRUE 3D GLASSMORPHIC MATERIAL)
         ============================================================ -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderSubtleBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ProCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}"/>
    <Style x:Key="GlassCardSmallStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Background" Value="#14171E"/>
    </Style>
    <Style x:Key="MiniGlassCard" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- ============================================================
         SPATIAL 3D CARD DEFAULT STYLE (NATIVE 3D SURFACE)
         ============================================================ -->
    <Style TargetType="{x:Type controls:Card3D}">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Card3D}">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <!-- LAYER 1: Background Glass Shell -->
                        <Border x:Name="PART_BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                IsHitTestVisible="False"/>

                        <!-- LAYER 2: Glow Underlay / Spotlight (Behind Content) -->
                        <Border x:Name="PART_GlowUnderlay"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                IsHitTestVisible="False"
                                Opacity="0.0">
                            <Rectangle x:Name="PART_SpotlightOverlay"
                                       RadiusX="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                                       RadiusY="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                                       IsHitTestVisible="False"/>
                        </Border>

                        <!-- LAYER 3: Dedicated Foreground Content Layer (100% Razor Sharp Native ClearType) -->
                        <Border x:Name="PART_ContentContainer"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextRenderingMode="ClearType"
                                RenderOptions.ClearTypeHint="Enabled">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glow Text Style for Headlines / Brand / Important Metrics -->
    <Style x:Key="GlowTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ============================================================
         MASTER 3D PHYSICAL BUTTON SYSTEM (WebDev & 3d-hover-button Port)
         Unified 3D Physical Elevation, Specular Edge, Depth Shadow & Micro-Tilt
         ============================================================ -->
    
    <!-- HeroButton (3D Raised Master Action Button) -->
    <Style x:Key="HeroButton" TargetType="Button" x:Shared="False">
        <Setter Property="controls:Premium3DButtonBehavior.IsEnabled" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentContrastTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="22,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 3D Root Physical Surface Container -->
                    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="BtnTranslate" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Layer 1: Physical Depth Shadow -->
                        <Border x:Name="BtnShadow" CornerRadius="8" Background="#000000" Opacity="0.35" Margin="0,3,0,-3">
                            <Border.Effect>
                                <DropShadowEffect x:Name="HeroGlow" Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                        </Border>

                        <!-- Layer 2: Main Beveled 3D Surface -->
                        <Border x:Name="BtnBorder" CornerRadius="8" BorderThickness="1.2"
                                Background="{DynamicResource PrimaryGradientBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Layer 3: Top Specular Edge Highlight -->
                                <Border Height="14" VerticalAlignment="Top" CornerRadius="7,7,0,0" Opacity="0.25">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Button Content -->
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnTranslate" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HeroGlow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="HeroGlow" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HeroGlow" Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="HeroGlow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnTranslate" Storyboard.TargetProperty="Y" To="1.5" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#22242C"/>
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#333640"/>
                            <Setter Property="Foreground" Value="#666874"/>
                            <Setter TargetName="BtnShadow" Property="Opacity" Value="0.1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

        <!-- PrimaryButtonStyle (Universal 3D Accent Action Button) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" x:Shared="False">
        <Setter Property="controls:Premium3DButtonBehavior.IsEnabled" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentContrastTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
                        <!-- 3D Base Elevation Shadow -->
                        <Border x:Name="Shadow" CornerRadius="7" Background="#000000" Opacity="0.25" Margin="0,1,0,0">
                            <Border.Effect>
                                <DropShadowEffect x:Name="BtnGlow" Color="#000000" BlurRadius="8" ShadowDepth="1.5" Opacity="0.30"/>
                            </Border.Effect>
                        </Border>

                        <!-- 3D Raised Surface -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Top Bevel Highlight -->
                                <Border Height="10" VerticalAlignment="Top" CornerRadius="6,6,0,0" Opacity="0.18">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.65"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="Shadow" Property="Margin" Value="0,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A40"/>
                            <Setter Property="Foreground" Value="#666670"/>
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DangerButtonStyle (Universal 3D Red Danger Action Button — RESTORE ENTIRE SYSTEM & Critical Rollbacks) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" x:Shared="False">
        <Setter Property="controls:Premium3DButtonBehavior.IsEnabled" Value="True"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#DC2626"/>
        <Setter Property="BorderBrush" Value="#EF4444"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="BtnTranslate" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- 3D Base Elevation Danger Shadow -->
                        <Border x:Name="Shadow" CornerRadius="8" Background="#000000" Opacity="0.35" Margin="0,2,0,-2">
                            <Border.Effect>
                                <DropShadowEffect x:Name="DangerGlow" Color="#EF4444" BlurRadius="10" ShadowDepth="1.5" Opacity="0.30"/>
                            </Border.Effect>
                        </Border>

                        <!-- 3D Raised Danger Surface -->
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1.2"
                                Background="#DC2626"
                                BorderBrush="#EF4444"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Top Bevel Highlight -->
                                <Border Height="12" VerticalAlignment="Top" CornerRadius="7,7,0,0" Opacity="0.25">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FCA5A5"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
